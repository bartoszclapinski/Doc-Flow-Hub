@page
@model DocFlowHub.Web.Pages.Documents.IndexModel
@using DocFlowHub.Core.Models.Documents.Browser
@{
    ViewData["Title"] = "Documents";
    ViewData["FullBleed"] = true;
    var s = Model.State;
    var tree = Model.Tree;
    var docs = Model.Documents;
    var returnUrl = s.Href;
    var demoTip = "Read-only demo — changes are disabled";

    var typeLabel = s.Type == null ? null : Dfh.FileType(s.Type).Label.ToLowerInvariant();
    var ownerLabel = s.Owner switch { "me" => "me", "others" => "others", _ => null };
    var categoryName = s.Category is int cat ? Model.Categories.FirstOrDefault(c => c.Id == cat)?.Name ?? "unknown" : null;
    var scopeFolder = s.Folder is int fid ? tree.FindFolder(fid) : null;
    // An empty project or folder of the user's own gets the "upload here" box (7a).
    var ownScope = s.Folder != null ? scopeFolder != null : s.Project is int pid && tree.FindProject(pid) != null;
    var scopeName = Model.Breadcrumb.Count > 0 ? Model.Breadcrumb[^1].Label : "All documents";

    // Columns that sort, with their direction icon.
    string SortIcon(string? column) => (s.Sort == column) ? (s.Descending ? "bi-arrow-down" : "bi-arrow-up") : "";
    string? AriaSort(string? column) => s.Sort == column ? (s.Descending ? "descending" : "ascending") : null;
}

@section ToolWindow {
    <aside class="dfh-toolwindow" aria-label="Projects and teams">
        <div class="dfh-panel-header">
            <span class="dfh-panel-title">Projects</span>
            @if (Model.IsDemo)
            {
                <span class="dfh-icon-btn is-disabled" tabindex="0" title="@demoTip"><i class="bi bi-plus-lg" aria-hidden="true"></i></span>
            }
            else
            {
                <a class="dfh-icon-btn" asp-page="/Projects/Create" title="New project" aria-label="New project"><i class="bi bi-plus-lg" aria-hidden="true"></i></a>
            }
            <a class="dfh-icon-btn" asp-page="/Projects/Index" title="Manage projects" aria-label="Manage projects"><i class="bi bi-three-dots" aria-hidden="true"></i></a>
        </div>

        <ul class="dfh-tree" role="tree" aria-label="Projects">
            <li role="treeitem" aria-selected="@(!s.HasScope ? "true" : "false")">
                <div class="dfh-tree-row@(!s.HasScope ? " is-selected" : "")" style="--level: 0">
                    <span class="dfh-tree-toggle" aria-hidden="true"></span>
                    <a class="dfh-tree-link" href="@s.Scoped().Href" aria-current="@(!s.HasScope ? "page" : null)">
                        <i class="bi bi-files dfh-tree-icon" aria-hidden="true"></i>
                        <span class="dfh-tree-name">All documents</span>
                        <span class="dfh-tree-count">@tree.TotalDocuments</span>
                    </a>
                </div>
            </li>
            @foreach (var project in tree.Projects)
            {
                var selected = s.Project == project.Id && s.Folder == null;
                var hasFolders = project.Folders.Count > 0;
                <li role="treeitem" aria-selected="@(selected ? "true" : "false")" aria-expanded="@(hasFolders ? "true" : null)">
                    <div class="dfh-tree-row@(selected ? " is-selected" : "")" style="--level: 0">
                        @if (hasFolders)
                        {
                            <button type="button" class="dfh-tree-toggle" data-dfh-tree-toggle aria-label="Expand or collapse @project.Name"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                        }
                        else
                        {
                            <span class="dfh-tree-toggle" aria-hidden="true"></span>
                        }
                        <a class="dfh-tree-link" href="@s.Scoped(project: project.Id).Href" aria-current="@(selected ? "page" : null)">
                            <span class="dfh-swatch" style="background: @Dfh.ProjectColor(project.Color, project.Id)" aria-hidden="true"></span>
                            <span class="dfh-tree-name">@project.Name</span>
                            <span class="dfh-tree-count">@project.DocumentCount</span>
                        </a>
                    </div>
                    @if (hasFolders)
                    {
                        <ul role="group">
                            @foreach (var folder in project.Folders)
                            {
                                <partial name="_DocumentTreeFolder" model="new DocumentTreeFolderNode(folder, project.Id, 1, s, Model.OpenFolders)" />
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
        @if (tree.Projects.Count == 0)
        {
            <p class="dfh-tree-note">No projects yet. Projects group documents into folders.</p>
        }

        <div class="dfh-panel-header dfh-panel-header--divided">
            <span class="dfh-panel-title">Teams</span>
        </div>
        <ul class="dfh-tree" aria-label="Teams">
            @foreach (var team in tree.Teams)
            {
                var selected = s.Team == team.Id;
                <li>
                    <a class="dfh-tree-row dfh-tree-row--flat@(selected ? " is-selected" : "")" href="@s.Scoped(team: team.Id).Href"
                       aria-current="@(selected ? "page" : null)" title="Documents shared with @team.Name">
                        <i class="bi bi-people dfh-tree-icon" aria-hidden="true"></i>
                        <span class="dfh-tree-name">@team.Name</span>
                        <span class="dfh-tree-count" title="@team.MemberCount @Dfh.Noun(team.MemberCount, "member")">@team.MemberCount</span>
                    </a>
                </li>
            }
        </ul>
        @if (tree.Teams.Count == 0)
        {
            <p class="dfh-tree-note">You are not in a team yet.</p>
        }

        <div class="dfh-toolwindow-spacer"></div>
        <div class="dfh-toolwindow-footer">
            <span>Storage</span>
            <span class="dfh-mono" title="@Dfh.Number(tree.TotalDocuments) @Dfh.Noun(tree.TotalDocuments, "document")">@Dfh.FileSize(tree.StorageBytes)</span>
        </div>
    </aside>
}

@section Inspector {
    <aside class="dfh-inspector" aria-label="Document details">
        <div class="dfh-panel-header is-inspector">
            <span class="dfh-panel-title">Details</span>
        </div>
        <div class="dfh-inspector-body" id="dfh-inspector-body" aria-live="polite"
             data-id="@Model.Selected?.Id" data-return-url="@returnUrl">
            @if (Model.Selected != null)
            {
                <partial name="_DocumentInspector" model="new DocumentInspectorView(Model.Selected, Model.IsDemo, returnUrl)" />
            }
            else
            {
                <div class="dfh-empty dfh-empty--inline">
                    <span class="dfh-empty-title">Nothing selected</span>
                    <p>Select a document to see its details, AI summary and history.</p>
                </div>
            }
        </div>
    </aside>
}

<div class="dfh-column">
    <div class="dfh-viewtabs" role="tablist" aria-label="Views">
        <a class="dfh-viewtab is-active" role="tab" aria-selected="true" href="@s.Href"><i class="bi bi-files" aria-hidden="true"></i>Documents</a>
    </div>

    <div class="dfh-toolbar">
        <nav class="dfh-breadcrumb" aria-label="Location">
            @for (var i = 0; i < Model.Breadcrumb.Count; i++)
            {
                var (label, href) = Model.Breadcrumb[i];
                if (i > 0)
                {
                    <span class="dfh-breadcrumb-sep" aria-hidden="true">/</span>
                }
                if (i == Model.Breadcrumb.Count - 1)
                {
                    <span class="dfh-breadcrumb-current" aria-current="location">@label</span>
                }
                else
                {
                    <a href="@href">@label</a>
                }
            }
        </nav>
        @if (docs != null)
        {
            <span class="dfh-toolbar-count">@Dfh.Number(docs.Total) @Dfh.Noun(docs.Total, "document")</span>
        }

        @if (s.HasFilters)
        {
            <div class="dfh-tokens" aria-label="Active filters">
                @if (s.Q != null)
                {
                    <span class="dfh-token dfh-token--query">"@s.Q"<a href="@((s with { Q = null, Page = 1 }).Href)" aria-label="Clear the search"><i class="bi bi-x" aria-hidden="true"></i></a></span>
                }
                @if (typeLabel != null)
                {
                    <span class="dfh-token"><span class="dfh-token-key">type:</span>@typeLabel<a href="@((s with { Type = null, Page = 1 }).Href)" aria-label="Remove the type filter"><i class="bi bi-x" aria-hidden="true"></i></a></span>
                }
                @if (ownerLabel != null)
                {
                    <span class="dfh-token"><span class="dfh-token-key">owner:</span>@ownerLabel<a href="@((s with { Owner = null, Page = 1 }).Href)" aria-label="Remove the owner filter"><i class="bi bi-x" aria-hidden="true"></i></a></span>
                }
                @if (categoryName != null)
                {
                    <span class="dfh-token"><span class="dfh-token-key">category:</span>@categoryName<a href="@((s with { Category = null, Page = 1 }).Href)" aria-label="Remove the category filter"><i class="bi bi-x" aria-hidden="true"></i></a></span>
                }
            </div>
        }
        <span class="dfh-spacer"></span>

        <div class="dropdown">
            <button type="button" class="dfh-filter-btn@(s.Type != null ? " is-active" : "")" data-bs-toggle="dropdown" aria-expanded="false">
                Type<i class="bi bi-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end dfh-filter-menu">
                <li><a class="dropdown-item" href="@((s with { Type = null, Page = 1 }).Href)"><i class="bi @(s.Type == null ? "bi-check-lg" : "")" aria-hidden="true"></i>Any type</a></li>
                @foreach (var t in tree.FileTypes)
                {
                    var active = s.Type == t.FileType;
                    var (label, kind) = Dfh.FileType(t.FileType);
                    <li>
                        <a class="dropdown-item" href="@((s with { Type = t.FileType, Page = 1 }).Href)" aria-current="@(active ? "true" : null)">
                            <i class="bi @(active ? "bi-check-lg" : "")" aria-hidden="true"></i>
                            <span class="dfh-filetype dfh-filetype--@kind">@label</span>
                            <span class="dfh-menu-meta">@t.Count</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="dropdown">
            <button type="button" class="dfh-filter-btn@(s.Owner != null ? " is-active" : "")" data-bs-toggle="dropdown" aria-expanded="false">
                Owner<i class="bi bi-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end dfh-filter-menu">
                @foreach (var (value, label) in new (string?, string)[] { (null, "Anyone"), ("me", "Owned by me"), ("others", "Shared with me") })
                {
                    var active = s.Owner == value;
                    <li>
                        <a class="dropdown-item" href="@((s with { Owner = value, Page = 1 }).Href)" aria-current="@(active ? "true" : null)">
                            <i class="bi @(active ? "bi-check-lg" : "")" aria-hidden="true"></i>@label
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="dropdown">
            <button type="button" class="dfh-filter-btn@(s.Category != null ? " is-active" : "")" data-bs-toggle="dropdown" aria-expanded="false">
                Category<i class="bi bi-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end dfh-filter-menu">
                <li><a class="dropdown-item" href="@((s with { Category = null, Page = 1 }).Href)"><i class="bi @(s.Category == null ? "bi-check-lg" : "")" aria-hidden="true"></i>Any category</a></li>
                @foreach (var c in Model.Categories)
                {
                    var active = s.Category == c.Id;
                    <li>
                        <a class="dropdown-item" href="@((s with { Category = c.Id, Page = 1 }).Href)" aria-current="@(active ? "true" : null)">
                            <i class="bi @(active ? "bi-check-lg" : "")" aria-hidden="true"></i>@c.Name
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="dfh-bulkbar" id="dfh-bulkbar" hidden>
        <span class="dfh-bulkbar-count"><b data-dfh-bulk-count>0</b> selected</span>
        @if (Model.IsDemo)
        {
            <span class="d-inline-block" tabindex="0" title="@demoTip"><button type="button" class="dfh-bulk-action" disabled><i class="bi bi-arrows-move" aria-hidden="true"></i>Move</button></span>
            <span class="d-inline-block" tabindex="0" title="@demoTip"><button type="button" class="dfh-bulk-action is-danger" disabled><i class="bi bi-trash" aria-hidden="true"></i>Delete</button></span>
        }
        else
        {
            <button type="button" class="dfh-bulk-action" data-dfh-bulk="move"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move</button>
            <button type="button" class="dfh-bulk-action is-danger" data-dfh-bulk="delete"><i class="bi bi-trash" aria-hidden="true"></i>Delete</button>
        }
        <span class="dfh-spacer"></span>
        <button type="button" class="dfh-bulk-action is-plain" data-dfh-bulk="clear">Clear</button>
    </div>

    @if (docs == null)
    {
        <div class="dfh-empty dfh-fill">
            <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
            <span class="dfh-empty-title">The documents could not be loaded</span>
            <p>@Model.ErrorMessage Try again in a moment.</p>
            <a class="btn btn-secondary" href="@s.Href">Retry</a>
        </div>
    }
    else if (docs.Total == 0 && !s.HasFilters && tree.TotalDocuments == 0)
    {
        @* 7a, variant for a user without any document *@
        <div class="dfh-fill dfh-fill--pad">
            <div class="dfh-empty dfh-empty--box">
                <i class="bi bi-files" aria-hidden="true"></i>
                <span class="dfh-empty-title">No documents yet</span>
                <p>Upload a document, or ask a teammate to share one with your team. It will show up here.</p>
                @if (!Model.IsDemo)
                {
                    <a class="btn btn-primary" asp-page="/Documents/Upload"><i class="bi bi-upload" aria-hidden="true"></i>Upload</a>
                }
            </div>
        </div>
    }
    else if (docs.Total == 0 && !s.HasFilters && ownScope)
    {
        @* 7a: an empty project or folder *@
        <div class="dfh-fill dfh-fill--pad">
            <div class="dfh-empty dfh-empty--box">
                <i class="bi bi-folder2" aria-hidden="true"></i>
                <span class="dfh-empty-title">This @(s.Folder != null ? "folder" : "project") is empty</span>
                <p>Upload a document straight into <span class="dfh-mono">@scopeName</span>, or move documents here from the list.</p>
                @if (!Model.IsDemo)
                {
                    <div class="dfh-empty-actions">
                        <a class="btn btn-primary" asp-page="/Documents/Upload" asp-route-projectId="@s.Project" asp-route-folderId="@s.Folder"><i class="bi bi-upload" aria-hidden="true"></i>Upload</a>
                        <a class="btn btn-secondary" asp-page="/Folders/Create" asp-route-ProjectId="@s.Project" asp-route-ParentFolderId="@s.Folder"><i class="bi bi-folder-plus" aria-hidden="true"></i>New folder</a>
                    </div>
                }
            </div>
        </div>
    }
    else if (docs.Total == 0)
    {
        @* 7b: no results *@
        <div class="dfh-fill">
            <div class="dfh-empty dfh-empty--left">
                <i class="bi bi-search" aria-hidden="true"></i>
                <span class="dfh-empty-title">No documents match @(s.HasFilters ? "these filters" : "here")</span>
                <p>
                    Nothing in <span class="dfh-mono dfh-text-2">@string.Join(" / ", Model.Breadcrumb.Select(b => b.Label))</span>@(s.Q != null ? $" for “{s.Q}”" : "")@(typeLabel != null ? $", type {typeLabel}" : "")@(ownerLabel == "me" ? ", owned by you" : ownerLabel == "others" ? ", shared with you" : "")@(categoryName != null ? $", in {categoryName}" : "").
                </p>
                <ul class="dfh-link-list">
                    @if (s.HasScope)
                    {
                        <li><a href="@s.Scoped().Href">Search all documents instead</a></li>
                    }
                    @if (typeLabel != null)
                    {
                        <li><a href="@((s with { Type = null, Page = 1 }).Href)">Remove type:@typeLabel</a></li>
                    }
                    @if (ownerLabel != null)
                    {
                        <li><a href="@((s with { Owner = null, Page = 1 }).Href)">Remove owner:@ownerLabel</a></li>
                    }
                    @if (s.HasFilters)
                    {
                        <li><a href="@s.WithoutFilters().Href">Clear all filters</a></li>
                    }
                </ul>
            </div>
        </div>
    }
    else
    {
        <div class="dfh-fill" data-dfh-doc-scroll>
            <table class="dfh-table dfh-table--select" data-dfh-doc-table aria-label="Documents" aria-multiselectable="true">
                <colgroup>
                    <col class="dfh-col-check" />
                    <col />
                    <col style="width: 116px" />
                    <col style="width: 44px" />
                    <col style="width: 72px" />
                    <col style="width: 92px" />
                    <col style="width: 132px" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col" class="dfh-check-cell">
                            <input type="checkbox" class="form-check-input dfh-check" id="dfh-check-all" aria-label="Select all documents on this page" />
                        </th>
                        <th scope="col" aria-sort="@AriaSort("name")"><a class="dfh-sort" href="@s.SortedBy("name").Href">Name<i class="bi @SortIcon("name")" aria-hidden="true"></i></a></th>
                        <th scope="col">Workspace</th>
                        <th scope="col">Ver</th>
                        <th scope="col" class="is-num" aria-sort="@AriaSort("size")"><a class="dfh-sort" href="@s.SortedBy("size").Href"><i class="bi @SortIcon("size")" aria-hidden="true"></i>Size</a></th>
                        <th scope="col" aria-sort="@AriaSort(null)"><a class="dfh-sort" href="@s.SortedBy(null).Href">Modified<i class="bi @SortIcon(null)" aria-hidden="true"></i></a></th>
                        <th scope="col">Author</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < docs.Items.Count; i++)
                    {
                        var doc = docs.Items[i];
                        var (label, kind) = Dfh.FileType(doc.FileType);
                        var first = i == 0;
                        <tr class="@(first ? "is-selected" : null)" data-id="@doc.Id" data-title="@doc.Title" data-ext="@label" data-kind="@kind"
                            data-location="@(doc.Location ?? "No project")" data-owner="@(doc.IsOwner ? "1" : "0")"
                            tabindex="@(first ? "0" : "-1")" aria-selected="@(first ? "true" : "false")">
                            <td class="dfh-check-cell">
                                <input type="checkbox" class="form-check-input dfh-check dfh-row-check" value="@doc.Id" aria-label="Select @doc.Title" />
                            </td>
                            <td>
                                <div class="dfh-name-cell">
                                    <span class="dfh-filetype dfh-filetype--@kind">@label</span>
                                    <a class="dfh-cell-link dfh-ellipsis" href="/Documents/Details/@doc.Id" title="@doc.Title">@doc.Title</a>
                                    @if (doc.HasSummary)
                                    {
                                        <i class="bi bi-stars dfh-ai-star" title="AI summary available" aria-label="AI summary available"></i>
                                    }
                                </div>
                            </td>
                            <td class="is-muted">
                                <span class="dfh-workspace" title="@(doc.TeamName != null ? $"Shared with {doc.TeamName}" : "Only you can see this document")">
                                    <i class="bi @(doc.TeamName != null ? "bi-people" : "bi-lock")" aria-hidden="true"></i><span class="dfh-ellipsis">@(doc.TeamName ?? "Private")</span>
                                </span>
                            </td>
                            <td class="is-mono is-2">@(doc.Version != null ? $"v{doc.Version}" : "—")</td>
                            <td class="is-mono is-muted is-num">@Dfh.FileSize(doc.FileSize)</td>
                            <td class="is-muted" title="@Dfh.Timestamp(doc.ModifiedAt)">@Dfh.Relative(doc.ModifiedAt)</td>
                            <td>
                                <span class="dfh-person">
                                    <span class="dfh-avatar dfh-avatar--18" aria-hidden="true">@Dfh.Initials(doc.OwnerName)</span>
                                    <span class="dfh-ellipsis">@doc.OwnerName</span>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="dfh-pager" aria-label="Pages">
            <span class="dfh-mono">@docs.From–@docs.To of @Dfh.Number(docs.Total)</span>
            <span class="dfh-pager-nav">
                @if (docs.Page > 1)
                {
                    <a class="dfh-pager-btn" href="@((s with { Page = docs.Page - 1 }).Href)" rel="prev">Prev</a>
                }
                else
                {
                    <span class="dfh-pager-btn is-disabled" aria-disabled="true">Prev</span>
                }
                @if (docs.PageCount > 1)
                {
                    <span class="dfh-mono">@docs.Page / @docs.PageCount</span>
                }
                @if (docs.Page < docs.PageCount)
                {
                    <a class="dfh-pager-btn" href="@((s with { Page = docs.Page + 1 }).Href)" rel="next">Next</a>
                }
                else
                {
                    <span class="dfh-pager-btn is-disabled" aria-disabled="true">Next</span>
                }
            </span>
        </nav>
    }
</div>

@* 7g: delete one document *@
<div class="modal" id="dfh-delete-modal" tabindex="-1" aria-labelledby="dfh-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" asp-page-handler="Delete" data-dfh-busy="Deleting…">
            <div class="modal-header">
                <h2 class="modal-title" id="dfh-delete-title">Delete document?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body dfh-modal-stack">
                <p class="m-0">The document and <span data-dfh-delete-versions>its versions</span> will be removed from DocFlowHub. It can't be restored from the app.</p>
                <dl class="dfh-kv dfh-kv--box">
                    <dt>Location</dt><dd class="dfh-mono" data-dfh-delete-location></dd>
                    <dt>Size</dt><dd class="dfh-mono" data-dfh-delete-size></dd>
                </dl>
                <input type="hidden" name="documentId" value="" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i>Delete document</button>
            </div>
        </form>
    </div>
</div>

@* 7h: delete several documents, one result per document *@
<div class="modal" id="dfh-bulk-delete-modal" tabindex="-1" aria-labelledby="dfh-bulk-delete-title" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="dfh-bulk-delete-title">Delete documents?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body dfh-modal-stack">
                <p class="m-0" data-dfh-bulk-intro>Documents you don't own are skipped. Deleted documents can't be restored from the app.</p>
                <ul class="dfh-resultlist" data-dfh-bulk-list></ul>
                <div class="dfh-progress-block" data-dfh-bulk-progress hidden>
                    <div class="dfh-progress"><div class="dfh-progress-fill"></div></div>
                    <span class="dfh-mono dfh-muted" data-dfh-bulk-caption aria-live="polite"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dfh-bulk-cancel>Cancel</button>
                <button type="button" class="btn btn-danger" data-dfh-bulk-confirm><i class="bi bi-trash" aria-hidden="true"></i><span>Delete</span></button>
                <button type="button" class="btn btn-primary" data-dfh-bulk-close hidden>Close</button>
            </div>
        </div>
    </div>
</div>

@* 7i: move to a project or folder *@
<div class="modal" id="dfh-move-modal" tabindex="-1" aria-labelledby="dfh-move-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="dfh-move-title">Move</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body dfh-modal-stack">
                @if (tree.Projects.Count == 0)
                {
                    <p class="m-0">You have no projects yet. Create a project first, then move documents into it.</p>
                }
                else
                {
                    <label class="dfh-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search" class="dfh-search-input" placeholder="Filter projects and folders" aria-label="Filter projects and folders" autocomplete="off" data-dfh-move-filter />
                    </label>
                    <div class="dfh-tree-picker" role="listbox" aria-label="Destination" data-dfh-move-tree></div>
                    <p class="dfh-move-route">
                        <span class="dfh-mono" data-dfh-move-from></span>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        <span class="dfh-mono" data-dfh-move-to>choose a destination</span>
                    </p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-dfh-move-confirm disabled>Move here</button>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="dfh-move-data">@Html.Raw(Model.MoveTreeJson())</script>

@section Scripts {
    <script src="~/js/dfh/documents.js" asp-append-version="true"></script>
}
