@page
@model DocFlowHub.Web.Pages.Documents.UploadModel
@using DocFlowHub.Core.Models.Documents.Browser
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "Upload";
    ViewData["FullBleed"] = true;
    var tree = Model.Tree;
    var types = string.Join(" ", Model.AllowedTypes.Select(t => t.TrimStart('.')));
    var maxMb = Model.MaxFileBytes / 1024 / 1024;
}

@section Inspector {
    <aside class="dfh-inspector dfh-inspector--320" aria-label="Destination">
        <div class="dfh-panel-header is-inspector"><span class="dfh-panel-title">Destination</span></div>
        <ul class="dfh-tree dfh-destination" data-dfh-destination aria-label="Projects and folders">
            <li>
                <button type="button" class="dfh-picker-row" data-project="" data-folder="" style="--level: 0">
                    <i class="bi bi-files dfh-tree-icon" aria-hidden="true"></i>
                    <span class="dfh-tree-name">No project</span>
                </button>
            </li>
            @foreach (var project in tree.Projects)
            {
                <li>
                    <button type="button" class="dfh-picker-row" data-project="@project.Id" data-folder="" data-count="@project.DocumentCount" style="--level: 0">
                        <span class="dfh-swatch" style="background: @Dfh.ProjectColor(project.Color, project.Id)" aria-hidden="true"></span>
                        <span class="dfh-tree-name">@project.Name</span>
                        <span class="dfh-tree-count">@project.DocumentCount</span>
                    </button>
                </li>
                @foreach (var folder in project.AllFolders())
                {
                    var depth = 1;
                    for (var p = folder.ParentId; p != null; p = project.AllFolders().FirstOrDefault(f => f.Id == p)?.ParentId) depth++;
                    <li>
                        <button type="button" class="dfh-picker-row" data-project="@project.Id" data-folder="@folder.Id" data-count="@folder.DocumentCount" style="--level: @depth">
                            <i class="bi bi-folder2 dfh-tree-icon" aria-hidden="true"></i>
                            <span class="dfh-tree-name">@folder.Name</span>
                            <span class="dfh-tree-count">@folder.DocumentCount</span>
                        </button>
                    </li>
                }
            }
        </ul>
        <div class="dfh-insp-block">
            <span class="dfh-insp-block-head"><span>Usage</span></span>
            <dl class="dfh-kv">
                <dt>Storage used</dt>
                <dd>@Dfh.FileSize(tree.StorageBytes) <span data-dfh-upload-after></span></dd>
                @if (Model.AiDailyLimit is int limit)
                {
                    <dt>AI requests today</dt>
                    <dd>@Model.AiRequestsToday / @Dfh.Number(limit)</dd>
                }
            </dl>
        </div>
    </aside>
}

<form class="dfh-column" method="post" enctype="multipart/form-data" data-dfh-upload-form data-dfh-busy="Uploading…"
      data-max-bytes="@Model.MaxFileBytes" data-types="@string.Join(",", Model.AllowedTypes)">
    <partial name="_EditorTabs" model='new EditorTabsView("Upload document", Icon: "bi-upload")' />

    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (Model.ErrorMessage != null)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }

            <fieldset class="dfh-form-section">
                <legend class="dfh-form-heading">File</legend>
                <label class="dfh-dropzone" data-dfh-dropzone>
                    <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                    <span class="dfh-dropzone-text">
                        <span>Drop a file here or <span class="dfh-dropzone-link">browse</span></span>
                        <span class="dfh-mono">@types · max @maxMb MB</span>
                    </span>
                    <input type="file" name="File" class="dfh-file-input" accept="@string.Join(",", Model.AllowedTypes)" required data-dfh-file />
                </label>
                <ul class="dfh-upload-list" data-dfh-file-list hidden>
                    <li class="dfh-upload-row">
                        <span class="dfh-filetype" data-dfh-file-ext></span>
                        <span class="dfh-ellipsis" data-dfh-file-name></span>
                        <span class="dfh-mono" data-dfh-file-size></span>
                        <span class="dfh-upload-status" data-dfh-file-status></span>
                        <button type="button" class="dfh-icon-action" data-dfh-file-remove aria-label="Remove the file"><i class="bi bi-x" aria-hidden="true"></i></button>
                    </li>
                </ul>
            </fieldset>

            <fieldset class="dfh-form-section">
                <legend class="dfh-form-heading">Details</legend>
                <div class="dfh-form-grid">
                    <label class="dfh-field is-wide">
                        <span class="dfh-field-label">Title</span>
                        <input asp-for="Title" class="form-control" placeholder="Taken from the file name" maxlength="200" data-dfh-title />
                    </label>
                    <label class="dfh-field">
                        <span class="dfh-field-label">Project</span>
                        <select asp-for="ProjectId" class="form-select" data-dfh-project>
                            <option value="">No project</option>
                            @foreach (var project in tree.Projects)
                            {
                                <option value="@project.Id">@project.Name</option>
                            }
                        </select>
                    </label>
                    <label class="dfh-field">
                        <span class="dfh-field-label">Folder</span>
                        <select asp-for="FolderId" class="form-select" data-dfh-folder>
                            <option value="">Project root</option>
                            @foreach (var project in tree.Projects)
                            {
                                foreach (var folder in project.AllFolders())
                                {
                                    <option value="@folder.Id" data-project="@project.Id">@folder.Name</option>
                                }
                            }
                        </select>
                    </label>
                    <label class="dfh-field">
                        <span class="dfh-field-label">Workspace</span>
                        <select asp-for="TeamId" class="form-select">
                            <option value="">Private — only you</option>
                            @foreach (var team in Model.Teams)
                            {
                                <option value="@team.Id">Shared with @team.Name</option>
                            }
                        </select>
                    </label>
                    <div class="dfh-field is-wide">
                        <span class="dfh-field-label" id="categories-label">Categories</span>
                        <div class="dfh-toggle-chips" role="group" aria-labelledby="categories-label">
                            @foreach (var category in Model.Categories)
                            {
                                <label class="dfh-toggle-chip">
                                    <input type="checkbox" name="SelectedCategoryIds" value="@category.Id" checked="@Model.SelectedCategoryIds.Contains(category.Id)" />
                                    <span>@category.Name</span>
                                </label>
                            }
                        </div>
                    </div>
                    <label class="dfh-field is-wide">
                        <span class="dfh-field-label">Description</span>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional. What is this document about?"></textarea>
                    </label>
                </div>
            </fieldset>

            <fieldset class="dfh-form-section">
                <legend class="dfh-form-heading"><i class="bi bi-stars" aria-hidden="true"></i>AI</legend>
                <label class="dfh-check-row">
                    <input type="checkbox" class="form-check-input" name="GenerateSummary" value="true" checked="@Model.GenerateSummary" disabled="@(!Model.AIFeaturesEnabled)" />
                    <span>
                        Generate a summary after upload <span class="dfh-mono">1 request</span>
                        <small>@(Model.AIFeaturesEnabled ? "Uses your preferred model from Settings · AI. The summary appears on the document a few seconds later." : "AI features are turned off for your account in Settings · AI.")</small>
                    </span>
                </label>
                <input type="hidden" name="GenerateSummary" value="false" />
            </fieldset>
        </div>
    </div>

    <div class="dfh-form-footer">
        <span class="dfh-mono" data-dfh-upload-summary>No file chosen</span>
        <a class="btn btn-secondary" asp-page="/Documents/Index">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — uploads are disabled">
                <button type="button" class="btn btn-primary" disabled><i class="bi bi-upload" aria-hidden="true"></i>Upload</button>
            </span>
        }
        else
        {
            <button type="submit" class="btn btn-primary" data-dfh-upload-submit disabled><i class="bi bi-upload" aria-hidden="true"></i>Upload</button>
        }
    </div>
</form>

@section Scripts {
    <script src="~/js/dfh/upload.js" asp-append-version="true"></script>
}
