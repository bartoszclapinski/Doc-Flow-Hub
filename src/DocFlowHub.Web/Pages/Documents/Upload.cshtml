@page
@model DocFlowHub.Web.Pages.Documents.UploadModel
@using DocFlowHub.Core.Models.Documents.Browser
@using DocFlowHub.Core.Models.AI
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "Upload";
    ViewData["FullBleed"] = true;
    var tree = Model.Tree;
    var types = string.Join(" ", Model.AllowedTypes.Select(t => t.TrimStart('.')));
    var maxMb = Model.MaxFileBytes / 1024 / 1024;
    var ai = Model.SummariesEnabled;

    // The no-JS estimate: a typical one-page document (about 2,500 characters). upload.js redoes it for the file.
    (string Cost, string Time, string Tokens) Estimate(AIModel m, SummaryDetail d)
    {
        const int inputTokens = 2500 / 4 + 200;
        var outputTokens = SummaryDetailHelper.TypicalOutputTokens(d);
        var (pin, pout) = AIModelFacts.PricePerMillionTokens(m);
        var cost = (inputTokens * pin + outputTokens * pout) / 1_000_000m;
        var factor = d switch { SummaryDetail.Short => 0.7, SummaryDetail.Detailed => 1.6, _ => 1.0 };
        var seconds = Math.Max(2, (int)Math.Round(AIModelFacts.TypicalSeconds(m) * factor));
        return (cost < 0.01m ? "< $0.01" : "≈ $" + cost.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture),
                "≈ " + seconds + " s",
                "≈ " + (inputTokens + outputTokens).ToString("N0", System.Globalization.CultureInfo.InvariantCulture));
    }
    var estimate = Estimate(Model.SummaryModel, Model.SummaryDetail);
}

@section Inspector {
    <aside class="dfh-inspector dfh-inspector--320" aria-label="Destination">
        <div class="dfh-panel-header is-inspector"><span class="dfh-panel-title">Destination</span></div>
        <ul class="dfh-tree dfh-destination" data-dfh-destination aria-label="Projects and folders">
            <li>
                <button type="button" class="dfh-picker-row" data-project="" data-folder="" style="--level: 0">
                    <i class="bi bi-files dfh-tree-icon" aria-hidden="true"></i>
                    <span class="dfh-tree-name">No project</span>
                </button>
            </li>
            @foreach (var project in tree.Projects)
            {
                <li>
                    <button type="button" class="dfh-picker-row" data-project="@project.Id" data-folder="" data-count="@project.DocumentCount" style="--level: 0">
                        <span class="dfh-swatch" style="background: @Dfh.ProjectColor(project.Color, project.Id)" aria-hidden="true"></span>
                        <span class="dfh-tree-name">@project.Name</span>
                        <span class="dfh-tree-count">@project.DocumentCount</span>
                    </button>
                </li>
                @foreach (var folder in project.AllFolders())
                {
                    var depth = 1;
                    for (var p = folder.ParentId; p != null; p = project.AllFolders().FirstOrDefault(f => f.Id == p)?.ParentId) depth++;
                    <li>
                        <button type="button" class="dfh-picker-row" data-project="@project.Id" data-folder="@folder.Id" data-count="@folder.DocumentCount" style="--level: @depth">
                            <i class="bi bi-folder2 dfh-tree-icon" aria-hidden="true"></i>
                            <span class="dfh-tree-name">@folder.Name</span>
                            <span class="dfh-tree-count">@folder.DocumentCount</span>
                        </button>
                    </li>
                }
            }
        </ul>
        <div class="dfh-insp-block">
            <span class="dfh-insp-block-head"><span>Usage</span></span>
            <dl class="dfh-kv">
                <dt>Storage used</dt>
                <dd>@Dfh.FileSize(tree.StorageBytes) <span data-dfh-upload-after></span></dd>
                @if (Model.AiDailyLimit is int limit)
                {
                    <dt>AI requests today</dt>
                    <dd>@Model.AiRequestsToday / @Dfh.Number(limit)</dd>
                }
            </dl>
        </div>
    </aside>
}

<form class="dfh-column" method="post" enctype="multipart/form-data" data-dfh-upload-form data-dfh-busy="Uploading…"
      data-max-bytes="@Model.MaxFileBytes" data-types="@string.Join(",", Model.AllowedTypes)"
      data-summarisable="@string.Join(",", UploadModel.SummarisableTypes)" data-dfh-upload-progress="@(DemoMode.IsEnabled ? null : "on")"
      data-models="@Model.ModelsJson" data-details="@UploadModel.DetailsJson">
    <partial name="_EditorTabs" model='new EditorTabsView("Upload document", Icon: "bi-upload")' />

    <div class="dfh-form-scroll dfh-upload-scroll">
        <div class="dfh-form-body dfh-upload-body@(Model.ErrorMessage != null ? " has-error" : "")">
            @if (Model.ErrorMessage != null)
            {
                <div class="dfh-form-error dfh-upload-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }

            <fieldset class="dfh-form-section dfh-upload-file">
                <legend class="dfh-form-heading">File</legend>
                <label class="dfh-dropzone" data-dfh-dropzone>
                    <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                    <span class="dfh-dropzone-text">
                        <span>Drop a file here or <span class="dfh-dropzone-link">browse</span></span>
                        <span class="dfh-mono">@types · max @maxMb MB</span>
                        <span class="dfh-dropzone-tip"><i class="bi bi-lightbulb" aria-hidden="true"></i>Old <span class="dfh-mono">.doc</span> files can't be read for AI summaries: re-save them as <span class="dfh-mono">.docx</span>.</span>
                    </span>
                    <input type="file" name="File" class="dfh-file-input" accept="@string.Join(",", Model.AllowedTypes)" required data-dfh-file />
                </label>
                <ul class="dfh-upload-list" data-dfh-file-list hidden>
                    <li class="dfh-upload-row">
                        <span class="dfh-filetype" data-dfh-file-ext></span>
                        <span class="dfh-ellipsis" data-dfh-file-name></span>
                        <span class="dfh-mono" data-dfh-file-size></span>
                        <span class="dfh-upload-status" data-dfh-file-status></span>
                        <button type="button" class="dfh-icon-action" data-dfh-file-remove aria-label="Remove the file"><i class="bi bi-x" aria-hidden="true"></i></button>
                    </li>
                </ul>

                @* "What will happen" (S23-4): filled by upload.js when a file is picked. *@
                <div class="dfh-upload-checks" data-dfh-upload-checks hidden>
                    <span class="dfh-upload-checks-title">What will happen</span>
                    <ul>
                        <li data-check="file"><i class="bi" aria-hidden="true"></i><span></span></li>
                        <li data-check="text"><i class="bi" aria-hidden="true"></i><span></span></li>
                        <li data-check="ai"><i class="bi" aria-hidden="true"></i><span></span></li>
                    </ul>
                </div>

                @* Progress (S23-5): shown by upload.js while the file is sent. *@
                <div class="dfh-upload-progress" data-dfh-progress hidden aria-live="polite">
                    <div class="dfh-upload-bar"><span data-dfh-progress-bar></span></div>
                    <ol class="dfh-upload-steps">
                        <li data-step="upload"><span class="dfh-upload-step-dot" aria-hidden="true"></span><span>Upload</span><span class="dfh-mono" data-dfh-progress-pct>0%</span></li>
                        <li data-step="save"><span class="dfh-upload-step-dot" aria-hidden="true"></span><span>Check and store the file</span></li>
                        <li data-step="ai"><span class="dfh-upload-step-dot" aria-hidden="true"></span><span>AI summary</span><span class="dfh-muted" data-dfh-progress-ai>continues in the background</span></li>
                    </ol>
                </div>
            </fieldset>

            @* The AI options of the old upload screen, made real (S23-1 … S23-3). *@
            <section class="dfh-upload-ai@(ai ? "" : " is-off")" aria-labelledby="dfh-upload-ai-title" data-dfh-ai-panel>
                <header class="dfh-upload-ai-head">
                    <i class="bi bi-stars" aria-hidden="true"></i>
                    <h2 id="dfh-upload-ai-title">AI on upload</h2>
                    <span class="dfh-mono">1 request</span>
                </header>
                @if (!ai)
                {
                    <p class="dfh-upload-ai-off">AI summaries are turned off for your account. <a asp-page="/Settings/AI">Turn them on in Settings · AI</a>.</p>
                    <input type="hidden" name="GenerateSummary" value="false" />
                }
                else
                {
                    <label class="dfh-upload-ai-switch form-switch">
                        <input type="checkbox" class="form-check-input" role="switch" name="GenerateSummary" value="true" checked="@Model.GenerateSummary" data-dfh-ai-on />
                        <span>
                            <strong>Generate an AI summary</strong>
                            <small data-dfh-ai-reason>The AI reads the file and writes a summary with key points. It appears on the document a few seconds after the upload.</small>
                        </span>
                    </label>
                    <input type="hidden" name="GenerateSummary" value="false" />

                    <div class="dfh-upload-ai-options" data-dfh-ai-options>
                        <label class="dfh-field">
                            <span class="dfh-field-label">Model</span>
                            <select name="SummaryModel" class="form-select" data-dfh-ai-model>
                                @foreach (var group in AIModelHelper.GetAllModels().GroupBy(m => m.GetProvider()).OrderBy(g => g.Key == AIProvider.Anthropic ? 0 : 1))
                                {
                                    <optgroup label="@(group.Key == AIProvider.Anthropic ? "Anthropic" : "OpenAI")">
                                        @foreach (var m in group)
                                        {
                                            <option value="@m" selected="@(m == Model.SummaryModel)">@m.ToDisplayName()@(m == AIModelHelper.GetDefaultModel() ? " ★" : "")</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <small class="dfh-upload-ai-note" data-dfh-ai-strengths>@AIModelFacts.Strengths(Model.SummaryModel)</small>
                        </label>

                        <div class="dfh-field">
                            <span class="dfh-field-label" id="dfh-detail-label">Summary detail</span>
                            <div class="dfh-choice-group" role="radiogroup" aria-labelledby="dfh-detail-label">
                                @foreach (var d in Enum.GetValues<SummaryDetail>())
                                {
                                    <label class="dfh-choice" title="@SummaryDetailHelper.Describe(d)">
                                        <input type="radio" name="SummaryDetail" value="@d" checked="@(d == Model.SummaryDetail)" data-describe="@SummaryDetailHelper.Describe(d)" />
                                        <span>@d</span>
                                    </label>
                                }
                            </div>
                            <small class="dfh-upload-ai-note" data-dfh-ai-detail>@SummaryDetailHelper.Describe(Model.SummaryDetail)</small>
                        </div>

                        <div class="dfh-upload-estimate" data-dfh-ai-estimate aria-live="polite">
                            <span class="dfh-upload-estimate-title">Estimate</span>
                            <dl>
                                <div><dt>Cost</dt><dd data-dfh-est-cost>@estimate.Cost</dd></div>
                                <div><dt>Time</dt><dd data-dfh-est-time>@estimate.Time</dd></div>
                                <div><dt>Tokens</dt><dd data-dfh-est-tokens>@estimate.Tokens</dd></div>
                            </dl>
                            <small data-dfh-est-note>For a typical one-page document. Pick a file for a closer estimate.</small>
                        </div>

                        <label class="dfh-check-row">
                            <input type="checkbox" class="form-check-input" name="RememberDefaults" value="true" data-dfh-ai-remember />
                            <span>Remember as my defaults<small>Saves the switch, the model and the detail to Settings · AI.</small></span>
                        </label>
                    </div>
                }
                <dl class="dfh-upload-ai-facts">
                    @if (Model.AiDailyLimit is int dailyLimit)
                    {
                        <div><dt>AI requests today</dt><dd class="dfh-mono">@Model.AiRequestsToday / @Dfh.Number(dailyLimit)</dd></div>
                    }
                    <div><dt>API key</dt><dd>@(Model.UsesOwnKey ? "Your own key" : "System API")</dd></div>
                </dl>
                <a class="dfh-upload-ai-settings" asp-page="/Settings/AI"><i class="bi bi-gear" aria-hidden="true"></i>Defaults in Settings · AI</a>
            </section>

            <fieldset class="dfh-form-section dfh-upload-details">
                <legend class="dfh-form-heading">Details</legend>
                <div class="dfh-form-grid">
                    <label class="dfh-field is-wide">
                        <span class="dfh-field-label">Title</span>
                        <input asp-for="Title" class="form-control" placeholder="Taken from the file name" maxlength="200" data-dfh-title />
                    </label>
                    <label class="dfh-field">
                        <span class="dfh-field-label">Project</span>
                        <select asp-for="ProjectId" class="form-select" data-dfh-project>
                            <option value="">No project</option>
                            @foreach (var project in tree.Projects)
                            {
                                <option value="@project.Id">@project.Name</option>
                            }
                        </select>
                    </label>
                    <label class="dfh-field">
                        <span class="dfh-field-label">Folder</span>
                        <select asp-for="FolderId" class="form-select" data-dfh-folder>
                            <option value="">Project root</option>
                            @foreach (var project in tree.Projects)
                            {
                                foreach (var folder in project.AllFolders())
                                {
                                    <option value="@folder.Id" data-project="@project.Id">@folder.Name</option>
                                }
                            }
                        </select>
                    </label>
                    <label class="dfh-field">
                        <span class="dfh-field-label">Workspace</span>
                        <select asp-for="TeamId" class="form-select">
                            <option value="">Private — only you</option>
                            @foreach (var team in Model.Teams)
                            {
                                <option value="@team.Id">Shared with @team.Name</option>
                            }
                        </select>
                    </label>
                    <div class="dfh-field is-wide">
                        <span class="dfh-field-label" id="categories-label">Categories</span>
                        <div class="dfh-toggle-chips" role="group" aria-labelledby="categories-label">
                            @foreach (var category in Model.Categories)
                            {
                                <label class="dfh-toggle-chip">
                                    <input type="checkbox" name="SelectedCategoryIds" value="@category.Id" checked="@Model.SelectedCategoryIds.Contains(category.Id)" />
                                    <span>@category.Name</span>
                                </label>
                            }
                        </div>
                    </div>
                    <label class="dfh-field is-wide">
                        <span class="dfh-field-label">Description</span>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional. What is this document about?"></textarea>
                    </label>
                </div>
            </fieldset>

        </div>
    </div>

    <div class="dfh-form-footer">
        <span class="dfh-mono" data-dfh-upload-summary>No file chosen</span>
        <a class="btn btn-secondary" asp-page="/Documents/Index">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-upload-demo-note" data-dfh-upload-demo-note><i class="bi bi-lock" aria-hidden="true"></i>Read-only demo: try every option, but the file is not sent.</span>
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — uploads are disabled">
                <button type="button" class="btn btn-primary" disabled><i class="bi bi-upload" aria-hidden="true"></i>Upload</button>
            </span>
        }
        else
        {
            <button type="submit" class="btn btn-primary" data-dfh-upload-submit disabled><i class="bi bi-upload" aria-hidden="true"></i>Upload</button>
        }
    </div>
</form>

@section Scripts {
    <script src="~/js/dfh/upload.js" asp-append-version="true"></script>
}
