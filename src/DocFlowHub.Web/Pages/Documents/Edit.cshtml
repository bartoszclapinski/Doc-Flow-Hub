@page "/Documents/Edit/{id:int}"
@model DocFlowHub.Web.Pages.Documents.EditModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    var d = Model.Doc;
    ViewData["Title"] = $"Edit · {d.Title}";
    ViewData["FullBleed"] = true;
    var (label, kind) = Dfh.FileType(d.FileType);
    var current = d.Current;
    var next = (current?.Number ?? 0) + 1;
    var types = string.Join(" ", Model.AllowedTypes.Select(t => t.TrimStart('.')));
    var demo = DemoMode.IsEnabled;
    var demoTip = "Read-only demo — changes are disabled";
}

@section Inspector {
    <aside class="dfh-inspector dfh-inspector--320" aria-label="Document">
        <div class="dfh-panel-header is-inspector"><span class="dfh-panel-title">Document</span></div>
        <div class="dfh-insp-section">
            <div class="dfh-insp-identity">
                <span class="dfh-filetype dfh-filetype--lg dfh-filetype--@kind">@label</span>
                <h2 class="dfh-insp-title">@d.Title</h2>
                <span class="dfh-insp-path">@(d.Location ?? "No project")</span>
            </div>
            <dl class="dfh-kv dfh-kv--side">
                <dt>Owner</dt>
                <dd>@d.OwnerName@(d.IsOwner ? " (you)" : "")</dd>
                <dt>Workspace</dt>
                <dd>@(d.TeamName ?? "Private")</dd>
                <dt>Version</dt>
                <dd class="dfh-mono">@(current != null ? $"v{current.Number}" : "—")@(current?.Hash != null ? $" · {current.Hash}" : "")</dd>
                <dt>Size</dt>
                <dd class="dfh-mono">@Dfh.FileSize(d.FileSize)</dd>
                <dt>Modified</dt>
                <dd title="@Dfh.Timestamp(d.ModifiedAt)">@Dfh.Relative(d.ModifiedAt)</dd>
            </dl>
        </div>
        <section class="dfh-version-list" aria-label="History">
            <div class="dfh-version-head"><span class="dfh-version-title">History</span></div>
            <ol class="dfh-versions">
                @for (var i = 0; i < Math.Min(4, d.Versions.Count); i++)
                {
                    var v = d.Versions[i];
                    var message = v.Message ?? (v.Number == 1 ? "Initial upload" : "No description");
                    <li class="@(i == 0 ? "is-current" : null)">
                        <span class="dfh-dot @(i == 0 ? "dfh-dot--accent" : "dfh-dot--past")" aria-hidden="true"></span>
                        <span class="dfh-mono">v@(v.Number)</span>
                        <span class="dfh-ellipsis@(v.Message == null ? " dfh-muted" : "")" title="@message · @v.Author">@message</span>
                        <span class="dfh-muted" title="@Dfh.Timestamp(v.CreatedAt)">@Dfh.Relative(v.CreatedAt)</span>
                    </li>
                }
            </ol>
        </section>
    </aside>
}

<div class="dfh-column">
    <partial name="_EditorTabs" model='new EditorTabsView(d.Title, d.FileType, d.Id, Icon: "bi-pencil", Suffix: "edit")' />

    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (Model.ErrorMessage != null)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }

            <form class="dfh-form-section" method="post" asp-page-handler="UpdateMetadata" asp-route-id="@d.Id" data-dfh-busy="Saving…">
                <h2 class="dfh-form-heading">Details</h2>
                <div class="dfh-form-grid">
                    <label class="dfh-field is-wide">
                        <span class="dfh-field-label">Title</span>
                        <input asp-for="Title" class="form-control" maxlength="200" />
                        @if (Model.FailedForm == "details")
                        {
                            <span asp-validation-for="Title" class="field-validation-error"></span>
                        }
                    </label>
                    <label class="dfh-field is-wide">
                        <span class="dfh-field-label">Description</span>
                        <textarea asp-for="Description" class="form-control" rows="3" maxlength="1000" placeholder="Optional. What is this document about?"></textarea>
                        @if (Model.FailedForm == "details")
                        {
                            <span asp-validation-for="Description" class="field-validation-error"></span>
                        }
                    </label>
                    <div class="dfh-field is-wide">
                        <span class="dfh-field-label" id="categories-label">Categories</span>
                        <div class="dfh-toggle-chips" role="group" aria-labelledby="categories-label">
                            @foreach (var category in Model.Categories)
                            {
                                <label class="dfh-toggle-chip">
                                    <input type="checkbox" name="SelectedCategoryIds" value="@category.Id" checked="@Model.SelectedCategoryIds.Contains(category.Id)" />
                                    <span>@category.Name</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
                <div class="dfh-empty-actions">
                    @if (demo)
                    {
                        <span class="dfh-btn-disabled-wrap" tabindex="0" title="@demoTip"><button type="button" class="btn btn-primary" disabled>Save details</button></span>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary">Save details</button>
                    }
                    <a class="btn btn-secondary" asp-page="/Documents/Details" asp-route-id="@d.Id">Cancel</a>
                </div>
            </form>

            <form id="new-version" class="dfh-form-section" method="post" enctype="multipart/form-data" asp-page-handler="UploadNewVersion" asp-route-id="@d.Id"
                  data-dfh-upload-form data-dfh-busy="Uploading…" data-max-bytes="@Model.MaxFileBytes" data-types="@string.Join(",", Model.AllowedTypes)">
                <h2 class="dfh-form-heading">New version <span class="dfh-muted">· becomes v@(next)</span></h2>
                <label class="dfh-dropzone" data-dfh-dropzone>
                    <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                    <span class="dfh-dropzone-text">
                        <span>Drop the new file here or <span class="dfh-dropzone-link">browse</span></span>
                        <span class="dfh-mono">@types · max @(Model.MaxFileBytes / 1024 / 1024) MB</span>
                    </span>
                    <input type="file" name="NewVersionFile" class="dfh-file-input" accept="@string.Join(",", Model.AllowedTypes)" data-dfh-file />
                </label>
                @if (Model.FailedForm == "version")
                {
                    <span asp-validation-for="NewVersionFile" class="field-validation-error"></span>
                }
                <ul class="dfh-upload-list" data-dfh-file-list hidden>
                    <li class="dfh-upload-row">
                        <span class="dfh-filetype" data-dfh-file-ext></span>
                        <span class="dfh-ellipsis" data-dfh-file-name></span>
                        <span class="dfh-mono" data-dfh-file-size></span>
                        <span class="dfh-upload-status" data-dfh-file-status></span>
                        <button type="button" class="dfh-icon-action" data-dfh-file-remove aria-label="Remove the file"><i class="bi bi-x" aria-hidden="true"></i></button>
                    </li>
                </ul>
                <label class="dfh-field">
                    <span class="dfh-field-label">What changed</span>
                    <input asp-for="ChangeSummary" class="form-control" maxlength="500" placeholder="For example: Updated the totals for September" />
                    @if (Model.FailedForm == "version")
                    {
                        <span asp-validation-for="ChangeSummary" class="field-validation-error"></span>
                    }
                </label>
                <div class="dfh-empty-actions">
                    @if (demo)
                    {
                        <span class="dfh-btn-disabled-wrap" tabindex="0" title="@demoTip"><button type="button" class="btn btn-primary" disabled><i class="bi bi-upload" aria-hidden="true"></i>Upload version</button></span>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary" data-dfh-upload-submit disabled><i class="bi bi-upload" aria-hidden="true"></i>Upload v@(next)</button>
                    }
                    <span class="dfh-mono dfh-muted" data-dfh-upload-summary>No file chosen</span>
                </div>
                <p class="dfh-insp-note">The previous versions stay available in the document's history. The AI summary is refreshed for the new version.</p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dfh/editor-tabs.js" asp-append-version="true"></script>
    <script src="~/js/dfh/upload.js" asp-append-version="true"></script>
}
