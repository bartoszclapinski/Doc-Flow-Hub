@page "/Documents/Details/{id:int}"
@model DocFlowHub.Web.Pages.Documents.DetailsModel
@using DocFlowHub.Core.Models.Documents.Browser
@{
    var d = Model.Doc;
    ViewData["Title"] = d.Title;
    ViewData["FullBleed"] = true;
    var (label, kind) = Dfh.FileType(d.FileType);
    var current = d.Current;
    var tab = Model.ActiveTab;
    var location = d.Location ?? "No project";
    var sizeInfo = $"{Dfh.FileSize(d.FileSize)} · {d.Versions.Count} {Dfh.Noun(d.Versions.Count, "version")}"
                   + (d.Versions.Count > 1 ? $" · {Dfh.FileSize(d.Versions.Sum(v => v.FileSize))} total" : "");
    var previous = d.Versions.Count > 1 ? d.Versions[1] : null;
    string Iso(DateTime utc) => utc.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);
    string Tab(string name) => tab == name ? "true" : "false";
}

@section Inspector {
    <aside class="dfh-inspector dfh-inspector--340" aria-label="Document details">
        <div class="dfh-panel-tabs" role="tablist" aria-label="Details" data-dfh-tabs>
            <button type="button" class="dfh-panel-tab" role="tab" id="tab-info" aria-controls="panel-info" aria-selected="@Tab("info")" data-tab="info">Info</button>
            <button type="button" class="dfh-panel-tab" role="tab" id="tab-ai" aria-controls="panel-ai" aria-selected="@Tab("ai")" data-tab="ai"><i class="bi bi-stars" aria-hidden="true"></i>AI</button>
            <button type="button" class="dfh-panel-tab" role="tab" id="tab-versions" aria-controls="panel-versions" aria-selected="@Tab("versions")" data-tab="versions">Versions <span class="dfh-panel-tab-count">@d.Versions.Count</span></button>
            <button type="button" class="dfh-panel-tab" role="tab" id="tab-sharing" aria-controls="panel-sharing" aria-selected="@Tab("sharing")" data-tab="sharing">Sharing</button>
        </div>

        @* ---------- Info (as designed) ---------- *@
        <div class="dfh-tabpanel" role="tabpanel" id="panel-info" aria-labelledby="tab-info" hidden="@(tab != "info")">
            <div class="dfh-insp-block">
                <h2 class="dfh-insp-title">@d.Title</h2>
                @if (!string.IsNullOrWhiteSpace(d.Description))
                {
                    <p class="dfh-insp-desc">@d.Description</p>
                }
                else
                {
                    <p class="dfh-insp-note">No description.</p>
                }
            </div>
            <div class="dfh-insp-block">
                <dl class="dfh-kv dfh-kv--side dfh-kv--92">
                    <dt>Owner</dt>
                    <dd>@d.OwnerName@(d.IsOwner ? " (you)" : "")</dd>
                    <dt>Workspace</dt>
                    <dd><span class="dfh-workspace"><i class="bi @(d.TeamName != null ? "bi-people" : "bi-lock") dfh-muted" aria-hidden="true"></i>@(d.TeamName ?? "Private")</span></dd>
                    <dt>Type</dt>
                    <dd class="dfh-mono">@DetailsModel.MimeType(d.FileType)</dd>
                    <dt>Size</dt>
                    <dd class="dfh-mono">@Dfh.FileSize(d.FileSize)</dd>
                    <dt>Version</dt>
                    <dd class="dfh-mono">@(current != null ? $"v{current.Number}" : "—")@(current?.Hash != null ? $" · {current.Hash}" : "")</dd>
                    <dt>Created</dt>
                    <dd class="dfh-mono" title="UTC">@Iso(d.CreatedAt)</dd>
                    <dt>Modified</dt>
                    <dd class="dfh-mono" title="UTC">@Iso(d.ModifiedAt)</dd>
                    @if (d.Categories.Count > 0)
                    {
                        <dt>Categories</dt>
                        <dd><span class="dfh-chips">@foreach (var c in d.Categories) {<span class="dfh-chip--outline">@c</span>}</span></dd>
                    }
                </dl>
            </div>
            <div class="dfh-insp-block">
                <div class="dfh-ai-head">
                    <span class="dfh-ai-label"><i class="bi bi-stars" aria-hidden="true"></i>AI summary</span>
                    @if (d.Summary?.Confidence is double conf)
                    {
                        <span class="dfh-mono dfh-muted">conf. @conf.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                    }
                </div>
                @if (d.Summary != null)
                {
                    <p class="dfh-ai-text-block">@d.Summary.Text</p>
                    @if (d.Summary.KeyPoints.Count > 0)
                    {
                        <ul class="dfh-keypoints">
                            @foreach (var point in d.Summary.KeyPoints.Take(3))
                            {
                                <li>@point</li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <p class="dfh-ai-text-block is-muted">No summary yet. <a href="?tab=ai" data-dfh-tab-open="ai">Open the AI tab</a> to generate one.</p>
                }
            </div>
            <div class="dfh-insp-block">
                <div class="dfh-insp-block-head">
                    <span>Recent versions</span>
                    @if (previous != null && current != null)
                    {
                        <a asp-page="/Documents/Compare" asp-route-id="@d.Id" asp-route-from="@previous.Number" asp-route-to="@current.Number">
                            <i class="bi bi-arrow-left-right" aria-hidden="true"></i>Compare v@(previous.Number) ↔ v@(current.Number)
                        </a>
                    }
                </div>
                <ol class="dfh-versions">
                    @for (var i = 0; i < Math.Min(3, d.Versions.Count); i++)
                    {
                        var v = d.Versions[i];
                        var message = v.Message ?? (v.Number == 1 ? "Initial upload" : "No description");
                        <li class="@(i == 0 ? "is-current" : null)">
                            <span class="dfh-dot @(i == 0 ? "dfh-dot--accent" : "dfh-dot--past")" aria-hidden="true"></span>
                            <span class="dfh-mono">v@(v.Number)</span>
                            <span class="dfh-ellipsis@(v.Message == null ? " dfh-muted" : "")" title="@message · @v.Author">@message</span>
                            <span class="dfh-muted" title="@Dfh.Timestamp(v.CreatedAt)">@Dfh.Relative(v.CreatedAt)</span>
                        </li>
                    }
                </ol>
            </div>
        </div>

        @* ---------- AI: full summary, key points, saved comparisons ---------- *@
        <div class="dfh-tabpanel" role="tabpanel" id="panel-ai" aria-labelledby="tab-ai" hidden="@(tab != "ai")">
            <div class="dfh-insp-block">
                <div class="dfh-ai-head">
                    <span class="dfh-ai-label"><i class="bi bi-stars" aria-hidden="true"></i>AI summary</span>
                    @if (d.Summary?.Confidence is double conf2)
                    {
                        <span class="dfh-mono dfh-muted">conf. @conf2.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                    }
                </div>
                @if (d.Summary != null)
                {
                    <p class="dfh-ai-text-block is-full">@d.Summary.Text</p>
                    @if (d.Summary.KeyPoints.Count > 0)
                    {
                        <span class="dfh-insp-block-head"><span>Key points</span></span>
                        <ul class="dfh-keypoints">
                            @foreach (var point in d.Summary.KeyPoints)
                            {
                                <li>@point</li>
                            }
                        </ul>
                    }
                    <span class="dfh-ai-meta">@d.Summary.Model · <span title="@Dfh.Timestamp(d.Summary.GeneratedAt)">@Dfh.Relative(d.Summary.GeneratedAt)</span></span>
                }
                else
                {
                    <p class="dfh-insp-note">This document has no AI summary yet. Generating one uses one AI request and your preferred model from Settings · AI.</p>
                    @if (Model.CanEdit)
                    {
                        <form method="post" asp-page-handler="GenerateSummary" asp-route-id="@d.Id" data-dfh-busy="Generating…">
                            <button type="submit" class="btn btn-secondary btn-sm"><i class="bi bi-stars" aria-hidden="true"></i>Generate summary</button>
                        </form>
                    }
                    else
                    {
                        <span class="dfh-btn-disabled-wrap" tabindex="0" title="@Model.DemoTip">
                            <button type="button" class="btn btn-secondary btn-sm" disabled><i class="bi bi-stars" aria-hidden="true"></i>Generate summary</button>
                        </span>
                    }
                }
            </div>
            <div class="dfh-insp-block">
                <div class="dfh-insp-block-head">
                    <span>Version comparisons</span>
                    @if (d.Versions.Count > 1)
                    {
                        <a asp-page="/Documents/Compare" asp-route-id="@d.Id"><i class="bi bi-arrow-left-right" aria-hidden="true"></i>Compare</a>
                    }
                </div>
                @if (d.Comparisons.Count == 0)
                {
                    <p class="dfh-insp-note">@(d.Versions.Count > 1 ? "No saved comparisons yet." : "Upload a second version to compare versions.")</p>
                }
                else
                {
                    <ul class="dfh-link-list dfh-mono">
                        @foreach (var (from, to) in d.Comparisons)
                        {
                            <li><a asp-page="/Documents/Compare" asp-route-id="@d.Id" asp-route-from="@from" asp-route-to="@to">v@(from) ↔ v@(to)</a></li>
                        }
                    </ul>
                }
            </div>
        </div>

        @* ---------- Versions: all of them ---------- *@
        <div class="dfh-tabpanel" role="tabpanel" id="panel-versions" aria-labelledby="tab-versions" hidden="@(tab != "versions")">
            <ol class="dfh-version-rows">
                @foreach (var v in d.Versions)
                {
                    var isCurrent = v == current;
                    var message = v.Message ?? (v.Number == 1 ? "Initial upload" : "No description");
                    <li class="dfh-version-row@(isCurrent ? " is-current" : "")">
                        <span class="dfh-dot @(isCurrent ? "dfh-dot--accent" : "dfh-dot--past")" aria-hidden="true"></span>
                        <span class="dfh-mono">v@(v.Number)</span>
                        <span class="dfh-version-main">
                            <span>@message</span>
                            <span class="dfh-version-meta">@v.Author · <span title="@Dfh.Timestamp(v.CreatedAt)">@Dfh.Relative(v.CreatedAt)</span> · @Dfh.FileSize(v.FileSize)@(v.Hash != null ? $" · {v.Hash}" : "")@(isCurrent ? " · current" : "")</span>
                        </span>
                        <span class="dfh-version-actions">
                            <form method="post" asp-page-handler="Download" asp-route-id="@d.Id">
                                <input type="hidden" name="versionId" value="@v.Id" />
                                <button type="submit" class="dfh-icon-action" title="Download v@(v.Number)" aria-label="Download v@(v.Number)"><i class="bi bi-download" aria-hidden="true"></i></button>
                            </form>
                            @if (!isCurrent && current != null)
                            {
                                <a class="dfh-icon-action" asp-page="/Documents/Compare" asp-route-id="@d.Id" asp-route-from="@v.Number" asp-route-to="@current.Number"
                                   title="Compare with v@(current.Number)" aria-label="Compare v@(v.Number) with v@(current.Number)"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></a>
                                <span class="dfh-btn-disabled-wrap" title="@(Model.CanManage ? $"Delete v{v.Number}" : Model.OwnerTip)">
                                    <button type="button" class="dfh-icon-action is-danger" aria-label="Delete v@(v.Number)" disabled="@(!Model.CanManage)"
                                            data-dfh-version-delete="@v.Id" data-number="@v.Number"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </span>
                            }
                        </span>
                    </li>
                }
            </ol>
        </div>

        @* ---------- Sharing: team assignment ---------- *@
        <div class="dfh-tabpanel" role="tabpanel" id="panel-sharing" aria-labelledby="tab-sharing" hidden="@(tab != "sharing")">
            <div class="dfh-insp-block">
                <span class="dfh-insp-block-head"><span>Who can see this document</span></span>
                @if (d.TeamName != null)
                {
                    <p class="dfh-insp-desc"><i class="bi bi-people dfh-muted" aria-hidden="true"></i> Shared with <b>@d.TeamName</b>. Every member can open it, edit its details and upload new versions.</p>
                }
                else
                {
                    <p class="dfh-insp-desc"><i class="bi bi-lock dfh-muted" aria-hidden="true"></i> Private. Only @(d.IsOwner ? "you" : d.OwnerName) can see it.</p>
                }
            </div>
            <div class="dfh-insp-block">
                @if (Model.CanManage)
                {
                    <form method="post" asp-page-handler="Share" asp-route-id="@d.Id" class="dfh-modal-stack" data-dfh-busy="Saving…">
                        <label class="dfh-field">
                            <span class="dfh-field-label">Workspace</span>
                            <select name="teamId" class="form-select form-select-sm">
                                <option value="" selected="@(d.TeamId == null)">Private</option>
                                @foreach (var t in Model.Teams)
                                {
                                    <option value="@t.Id" selected="@(d.TeamId == t.Id)">@t.Name</option>
                                }
                            </select>
                        </label>
                        <div><button type="submit" class="btn btn-primary btn-sm">Save</button></div>
                    </form>
                    @if (Model.Teams.Count == 0)
                    {
                        <p class="dfh-insp-note">You are not in a team yet, so the document can only be private.</p>
                    }
                }
                else
                {
                    <p class="dfh-insp-note">@(Model.IsDemo ? Model.DemoTip + "." : $"Only the owner, {d.OwnerName}, can change this.")</p>
                }
            </div>
        </div>
    </aside>
}

<div class="dfh-column">
    <partial name="_EditorTabs" model="new EditorTabsView(d.Title, d.FileType, d.Id)" />

    <div class="dfh-toolbar dfh-toolbar--bordered">
        <nav class="dfh-breadcrumb" aria-label="Location">
            @if (d.Location != null)
            {
                foreach (var part in d.Location.Split(" / "))
                {
                    <span>@part</span><span class="dfh-breadcrumb-sep" aria-hidden="true">/</span>
                }
            }
            <span class="dfh-breadcrumb-current" aria-current="page">@(d.Title + d.FileType.ToLowerInvariant())</span>
        </nav>
        <span class="dfh-spacer"></span>

        @if (Model.CanEdit)
        {
            <a class="btn btn-secondary btn-sm" asp-page="/Documents/Edit" asp-route-id="@d.Id" asp-fragment="new-version"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i>New version</a>
        }
        else
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="@Model.DemoTip"><button type="button" class="btn btn-secondary btn-sm" disabled><i class="bi bi-file-earmark-plus" aria-hidden="true"></i>New version</button></span>
        }
        @if (Model.CanManage)
        {
            <button type="button" class="btn btn-secondary btn-sm" data-dfh-action="move" data-id="@d.Id" data-title="@d.Title" data-location="@location"><i class="bi bi-arrows-move" aria-hidden="true"></i>Move</button>
        }
        else
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="@Model.OwnerTip"><button type="button" class="btn btn-secondary btn-sm" disabled><i class="bi bi-arrows-move" aria-hidden="true"></i>Move</button></span>
        }
        <button type="button" class="btn btn-secondary btn-sm" data-dfh-tab-open="sharing"><i class="bi bi-share" aria-hidden="true"></i>Share</button>
        <form method="post" asp-page-handler="Download" asp-route-id="@d.Id">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-download" aria-hidden="true"></i>Download</button>
        </form>
        <div class="dropdown">
            <button type="button" class="btn btn-secondary btn-sm btn-icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions"><i class="bi bi-three-dots" aria-hidden="true"></i></button>
            <ul class="dropdown-menu dropdown-menu-end">
                @if (Model.CanEdit)
                {
                    <li><a class="dropdown-item" asp-page="/Documents/Edit" asp-route-id="@d.Id"><i class="bi bi-pencil" aria-hidden="true"></i>Edit details…</a></li>
                }
                else
                {
                    <li><span class="dropdown-item disabled" title="@Model.DemoTip"><i class="bi bi-pencil" aria-hidden="true"></i>Edit details…</span></li>
                }
                @if (d.Versions.Count > 1)
                {
                    <li><a class="dropdown-item" asp-page="/Documents/Compare" asp-route-id="@d.Id"><i class="bi bi-arrow-left-right" aria-hidden="true"></i>Compare versions…</a></li>
                }
                <li><button type="button" class="dropdown-item" data-dfh-copy-link><i class="bi bi-link-45deg" aria-hidden="true"></i>Copy link</button></li>
                <li><hr class="dropdown-divider" /></li>
                @if (Model.CanManage)
                {
                    <li>
                        <button type="button" class="dropdown-item text-danger" data-dfh-action="delete" data-id="@d.Id" data-title="@d.Title"
                                data-location="@location" data-size="@sizeInfo" data-versions="@d.Versions.Count">
                            <i class="bi bi-trash" aria-hidden="true"></i>Delete…
                        </button>
                    </li>
                }
                else
                {
                    <li><span class="dropdown-item disabled" title="@Model.OwnerTip"><i class="bi bi-trash" aria-hidden="true"></i>Delete…</span></li>
                }
            </ul>
        </div>
    </div>

    @* D5: placeholder until a real preview (PDF.js) exists *@
    <div class="dfh-preview">
        <div class="dfh-preview-page">
            <span class="dfh-filetype dfh-filetype--@kind">@label</span>
            <h2 class="dfh-preview-title">@d.Title</h2>
            <span class="dfh-preview-meta">@Dfh.FileSize(d.FileSize)@(current != null ? $" · v{current.Number}" : "") · modified @Dfh.Relative(d.ModifiedAt)</span>
            <p class="dfh-preview-note">A preview isn't available yet. Download the file to open it on your computer.</p>
            <form method="post" asp-page-handler="Download" asp-route-id="@d.Id">
                <button type="submit" class="btn btn-secondary btn-sm"><i class="bi bi-download" aria-hidden="true"></i>Download @label</button>
            </form>
        </div>
    </div>
</div>

<partial name="_DocumentDialogs" model='new DocumentDialogsView("/Documents", Model.Tree)' />

@* Delete one old version *@
<div class="modal" id="dfh-version-delete-modal" tabindex="-1" aria-labelledby="dfh-version-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" asp-page-handler="DeleteVersion" asp-route-id="@d.Id" data-dfh-busy="Deleting…">
            <div class="modal-header">
                <h2 class="modal-title" id="dfh-version-delete-title">Delete version?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body dfh-modal-stack">
                <p class="m-0">The file of this version will be removed. The document and its other versions stay. It can't be undone.</p>
                <input type="hidden" name="versionId" value="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i>Delete version</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/dfh/document-dialogs.js" asp-append-version="true"></script>
    <script src="~/js/dfh/editor-tabs.js" asp-append-version="true"></script>
    <script src="~/js/dfh/details.js" asp-append-version="true"></script>
}
