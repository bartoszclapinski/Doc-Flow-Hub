@page "/Documents/Compare/{id:int}"
@model DocFlowHub.Web.Pages.Documents.CompareModel
@using DocFlowHub.Core.Models.Documents.Browser
@{
    var v = Model.View;
    ViewData["Title"] = $"Compare · {v.Title}";
    ViewData["FullBleed"] = true;
    var c = v.Comparison;
    var pair = $"v{v.From.Number} ↔ v{v.To.Number}";
    var newest = v.Versions[0].Number;
    var diff = Model.Diff;

    // Links of the diff toolbar: they keep the version pair and the other switches. "" clears a switch.
    string DiffUrl(string? view = null, string? ws = null, string? context = null, int? from = null, int? to = null)
    {
        static string? Pick(string? next, string? current) => next == null ? current : next.Length == 0 ? null : next;
        return Url.Page("/Documents/Compare", new
        {
            id = v.DocumentId,
            from = from ?? v.From.Number,
            to = to ?? v.To.Number,
            view = Pick(view, Model.Unified ? "unified" : null),
            ws = Pick(ws, Model.IgnoreWhitespace ? "ignore" : null),
            context = Pick(context, Model.ShowAll ? "all" : null),
        })!;
    }

    string Plural(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count:N0} {noun}s";
}

@section Inspector {
    <aside class="dfh-inspector dfh-inspector--320" aria-label="AI comparison">
        <div class="dfh-ai-compare-head">
            <i class="bi bi-stars" aria-hidden="true"></i><span>AI comparison</span>
            <span class="dfh-mono dfh-muted">@pair</span>
        </div>
        @if (c != null)
        {
            <div class="dfh-compare-summary">
                <p>@c.Summary</p>
                <div class="dfh-chips">
                    @foreach (var (label, high) in CompareModel.Chips(c))
                    {
                        <span class="dfh-compare-chip@(high ? " is-high" : "")">@label</span>
                    }
                </div>
            </div>
            <div class="dfh-change-label">Changes</div>
            @if (c.Changes.Count > 0)
            {
                <ol class="dfh-change-list">
                    @foreach (var change in c.Changes)
                    {
                        <li><span>@change</span></li>
                    }
                </ol>
            }
            else
            {
                <p class="dfh-insp-note" style="padding: 0 14px">The AI did not list individual changes.</p>
            }
            <div class="dfh-toolwindow-spacer"></div>
            <div class="dfh-insp-footer">
                <span>@c.Model@(c.TokensUsed is int t ? $" · {(t >= 1000 ? (t / 1000.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "k" : t.ToString())} tokens" : "")@(c.Confidence is double conf ? $" · conf. {conf.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}" : "")</span>
                <span title="@Dfh.Timestamp(c.GeneratedAt)">generated @Dfh.Relative(c.GeneratedAt)</span>
            </div>
        }
        else
        {
            <div class="dfh-insp-block">
                <p class="dfh-insp-note">There is no AI comparison of @pair yet. The AI reads both versions and lists what changed; it uses one AI request and your preferred model from Settings · AI.</p>
                @if (Model.IsDemo)
                {
                    <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — only saved comparisons are shown">
                        <button type="button" class="btn btn-secondary btn-sm" disabled><i class="bi bi-stars" aria-hidden="true"></i>Compare with AI</button>
                    </span>
                }
                else
                {
                    <form method="post" asp-page-handler="Generate" asp-route-id="@v.DocumentId" data-dfh-busy="Comparing…">
                        <input type="hidden" name="from" value="@v.From.Number" />
                        <input type="hidden" name="to" value="@v.To.Number" />
                        <button type="submit" class="btn btn-secondary btn-sm"><i class="bi bi-stars" aria-hidden="true"></i>Compare with AI</button>
                    </form>
                }
            </div>
        }
    </aside>
}

<div class="dfh-column">
    <partial name="_EditorTabs" model='new EditorTabsView(v.Title, v.FileType, v.DocumentId, Icon: "bi-arrow-left-right", Suffix: pair)' />

    <div class="dfh-toolbar dfh-toolbar--bordered">
        <nav class="dfh-breadcrumb" aria-label="Location">
            @if (v.Location != null)
            {
                foreach (var part in v.Location.Split(" / "))
                {
                    <span>@part</span><span class="dfh-breadcrumb-sep" aria-hidden="true">/</span>
                }
            }
            <a asp-page="/Documents/Details" asp-route-id="@v.DocumentId">@(v.Title + v.FileType.ToLowerInvariant())</a>
        </nav>
        <span class="dfh-spacer"></span>
        <a class="btn btn-secondary btn-sm" asp-page="/Documents/Details" asp-route-id="@v.DocumentId"><i class="bi bi-file-earmark" aria-hidden="true"></i>Open document</a>
    </div>

    @* Version header (Sprint 22): "Compare [v1] with [v3]" with real dropdowns; a GET form the script submits on change. *@
    <form class="dfh-diff-header" method="get" asp-page="/Documents/Compare" asp-route-id="@v.DocumentId" data-dfh-compare-pickers>
        @foreach (var (side, version, name, css) in new[] { ("Older", v.From, "from", "is-old"), ("Newer", v.To, "to", "is-new") })
        {
            <div class="dfh-diff-side @css">
                <label class="dfh-diff-pick-label" for="pick-@name">@side</label>
                <select id="pick-@name" name="@name" class="form-select">
                    @foreach (var option in v.Versions)
                    {
                        <option value="@option.Number" selected="@(option.Number == version.Number)">v@(option.Number)@(option.Number == newest ? " (current)" : "")</option>
                    }
                </select>
                @if (version.Hash != null)
                {
                    <span class="dfh-mono">@version.Hash</span>
                }
                <span class="dfh-diff-who" title="@Dfh.Timestamp(version.CreatedAt)">@version.Author · @Dfh.Relative(version.CreatedAt)@(version.Number == newest ? " · current" : "")</span>
            </div>
        }
        @if (Model.Unified) { <input type="hidden" name="view" value="unified" /> }
        @if (Model.IgnoreWhitespace) { <input type="hidden" name="ws" value="ignore" /> }
        @if (Model.ShowAll) { <input type="hidden" name="context" value="all" /> }
        <noscript><button type="submit" class="btn btn-secondary btn-sm">Compare</button></noscript>
    </form>

    @* Every pair at a glance (S22-6), for documents with up to 6 versions; ✦ = a saved AI comparison. *@
    @if (v.Versions.Count > 2 && v.Versions.Count <= 6)
    {
        var numbers = v.Versions.Select(x => x.Number).OrderBy(n => n).ToList();
        <nav class="dfh-pair-chips" aria-label="Version pairs">
            <span class="dfh-muted">Pairs</span>
            @for (var i = 0; i < numbers.Count; i++)
            {
                for (var j = i + 1; j < numbers.Count; j++)
                {
                    var (a, b) = (numbers[i], numbers[j]);
                    var active = a == v.From.Number && b == v.To.Number;
                    var ai = v.SavedPairs.Contains((a, b));
                    <a class="dfh-pair-chip@(active ? " is-active" : "")" href="@DiffUrl(from: a, to: b)" aria-current="@(active ? "true" : null)"
                       title="@(ai ? "Has a saved AI comparison" : null)">v@(a) ↔ v@(b)@if (ai) {<i class="bi bi-stars" aria-label="AI comparison"></i>}</a>
                }
            }
        </nav>
    }

    @* Diff toolbar (S21-6, S22-4): every control is a plain link; compare.js adds the change counter and jumps. *@
    <div class="dfh-diff-bar">
        @if (diff.Status == VersionDiffStatus.Changed)
        {
            <nav class="dfh-segmented dfh-diff-layout" aria-label="Diff layout">
                <a class="dfh-segmented-item@(!Model.Unified ? " is-active" : "")" href="@DiffUrl(view: "")" aria-current="@(!Model.Unified ? "true" : null)">Side by side</a>
                <a class="dfh-segmented-item@(Model.Unified ? " is-active" : "")" href="@DiffUrl(view: "unified")" aria-current="@(Model.Unified ? "true" : null)">Unified</a>
            </nav>
        }
        @if (diff.Status == VersionDiffStatus.Changed || Model.IgnoreWhitespace)
        {
        <a class="btn btn-secondary btn-sm" href="@DiffUrl(ws: Model.IgnoreWhitespace ? "" : "ignore")" aria-pressed="@(Model.IgnoreWhitespace ? "true" : "false")" data-dfh-diff-ws>
            <i class="bi bi-distribute-horizontal" aria-hidden="true"></i>Ignore whitespace
        </a>
        }
        @if (diff.Status == VersionDiffStatus.Changed && (diff.FoldedLines > 0 || Model.ShowAll))
        {
            <a class="btn btn-secondary btn-sm" href="@DiffUrl(context: Model.ShowAll ? "" : "all")" aria-pressed="@(Model.ShowAll ? "true" : "false")" data-dfh-diff-all>
                <i class="bi bi-arrows-expand" aria-hidden="true"></i>Show all lines
            </a>
        }
        <span class="dfh-spacer"></span>
        @if (Model.CanRestore)
        {
            <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#dfh-compare-restore-modal" data-dfh-compare-restore>
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Restore v@(v.From.Number)
            </button>
        }
        else
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="@Model.RestoreTip">
                <button type="button" class="btn btn-secondary btn-sm" disabled data-dfh-compare-restore><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Restore v@(v.From.Number)</button>
            </span>
        }
        @if (diff.Status == VersionDiffStatus.Changed)
        {
            <span class="dfh-diff-nav">
            <span class="dfh-mono dfh-diff-count" data-dfh-diff-count data-changes="@diff.Changes">
                <span class="is-add" title="@Plural(diff.AddedLines, "line") added">+@diff.AddedLines</span>
                <span class="is-del" title="@Plural(diff.RemovedLines, "line") removed">−@diff.RemovedLines</span>
                <span aria-hidden="true">·</span>
                <span data-dfh-diff-pos>@Plural(diff.Changes, "change")</span>
            </span>
            <button type="button" class="btn btn-ghost btn-sm btn-icon" data-dfh-diff-prev aria-label="Previous change" title="Previous change (P)" hidden><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
            <button type="button" class="btn btn-ghost btn-sm btn-icon" data-dfh-diff-next aria-label="Next change" title="Next change (N)" hidden><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
            </span>
        }
    </div>

    @if (diff.Status == VersionDiffStatus.Changed)
    {
        <div class="dfh-diff @(Model.Unified ? "is-unified" : "is-split")" tabindex="0" aria-label="Differences between v@(v.From.Number) and v@(v.To.Number)" data-dfh-diff>
            @foreach (var section in diff.Sections)
            {
                if (section.Kind == DiffSectionKind.Fold)
                {
                    <a class="dfh-diff-fold" href="@DiffUrl(context: "all")" title="Show all lines">⋯ @Plural(section.FoldedLines, "unchanged line")</a>
                    continue;
                }
                var change = section.Kind == DiffSectionKind.Change;
                @* Razor keeps an empty data-* attribute, so the change attributes are written only for a change (numbers only). *@
                <div class="dfh-diff-section@(change ? " is-change" : "")"@Html.Raw(change ? $" id=\"change-{section.ChangeNumber}\" data-dfh-change=\"{section.ChangeNumber}\"" : "")>
                    @foreach (var line in section.Lines)
                    {
                        if (line.Kind == DiffLineKind.Context)
                        {
                            <div class="dfh-diff-line is-ctx" style="grid-row: @line.Row"><span class="dfh-diff-n is-old">@line.OldNumber</span><span class="dfh-diff-s is-old"></span><span class="dfh-diff-t is-old">@line.OldText</span><span class="dfh-diff-n is-new">@line.NewNumber</span><span class="dfh-diff-s"></span><span class="dfh-diff-t">@line.NewText</span></div>
                        }
                        else
                        {
                            var removed = line.Kind == DiffLineKind.Removed;
                            <div class="dfh-diff-line @(removed ? "is-del" : "is-add")" style="grid-row: @line.Row"><span class="dfh-diff-n is-old">@line.OldNumber</span><span class="dfh-diff-n is-new">@line.NewNumber</span><span class="dfh-diff-s">@(removed ? "−" : "+")</span><span class="dfh-diff-t">@if (line.Pieces == null) {@(removed ? line.OldText : line.NewText)} else { foreach (var piece in line.Pieces) { if (piece.Changed) {<mark class="dfh-diff-w">@piece.Text</mark>} else {@piece.Text} } }</span></div>
                        }
                    }
                </div>
            }
        </div>
    }
    else
    {
        var same = diff.Status == VersionDiffStatus.Identical;
        <div class="dfh-diff-empty dfh-fill" data-dfh-diff-status="@diff.Status">
            <div class="dfh-empty dfh-empty--left">
                <i class="bi @(same ? "bi-check2-circle" : "bi-file-diff")" aria-hidden="true"></i>
                <span class="dfh-empty-title">@(same ? "No text differences" : diff.Status == VersionDiffStatus.TooLarge ? "Too large to compare here" : "No line-by-line diff for these versions")</span>
                <p>@diff.Note</p>
                <div class="dfh-empty-actions">
                    @foreach (var version in new[] { v.From, v.To })
                    {
                        <form method="post" asp-page="/Documents/Details" asp-page-handler="Download" asp-route-id="@v.DocumentId">
                            <input type="hidden" name="versionId" value="@version.Id" />
                            <button type="submit" class="btn btn-secondary btn-sm"><i class="bi bi-download" aria-hidden="true"></i>Download v@(version.Number)</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (Model.CanRestore)
{
    var next = v.Versions[0].Number + 1;
    <div class="modal" id="dfh-compare-restore-modal" tabindex="-1" aria-labelledby="dfh-compare-restore-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" asp-page="/Documents/Details" asp-page-handler="RestoreVersion" asp-route-id="@v.DocumentId" data-dfh-busy="Restoring…">
                <div class="modal-header">
                    <h2 class="modal-title" id="dfh-compare-restore-title">Restore v@(v.From.Number) as v@(next)?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body dfh-modal-stack">
                    <p class="m-0">The file of v@(v.From.Number) becomes v@(next), the new current version. Nothing is overwritten: every version stays.</p>
                    <label class="dfh-field">
                        <span class="dfh-field-label">Description <span class="dfh-muted">(optional)</span></span>
                        <input type="text" name="message" class="form-control" maxlength="500" placeholder="Restored from v@(v.From.Number)" />
                    </label>
                    <input type="hidden" name="versionNumber" value="@v.From.Number" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Restore as v@(next)</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/dfh/editor-tabs.js" asp-append-version="true"></script>
    <script src="~/js/dfh/compare.js" asp-append-version="true"></script>
}
