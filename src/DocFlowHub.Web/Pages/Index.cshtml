@page
@model IndexModel
@using DocFlowHub.Core.Models.Dashboard
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "Dashboard";
    ViewData["FullBleed"] = true;
    var d = Model.Dashboard;
    var period = Model.SelectedPeriod;
}

@section Inspector {
    @if (d != null)
    {
        <aside class="dfh-inspector dfh-inspector--wide" aria-label="Activity">
            <div class="dfh-panel-header is-inspector">
                <span class="dfh-panel-title">Activity</span>
                <span class="dfh-mono dfh-muted">@DashboardPeriods.Label(period).ToLowerInvariant()</span>
            </div>
            <partial name="_ActivityFeed" model="new ActivityFeed(d.Activity, Links: true)" />
        </aside>
    }
}

<div class="dfh-column">
    <header class="dfh-page-header">
        <h1>Overview</h1>
        @if (d != null)
        {
            <div class="dfh-statline" aria-label="Summary">
                <span><b>@Dfh.Number(d.Documents)</b> @Dfh.Noun(d.Documents, "document")</span>
                <span><b>@Dfh.Number(d.Versions)</b> @Dfh.Noun(d.Versions, "version")</span>
                <span><b>@Dfh.Number(d.Teams)</b> @Dfh.Noun(d.Teams, "team")</span>
                <span><b>@Dfh.Number(d.SharedWithMe)</b> shared with me</span>
                @if (d.VersionsInPeriod != null)
                {
                    <span title="Versions uploaded, including new documents"><b class="@(d.VersionsInPeriod > 0 ? "is-positive" : "")">+@d.VersionsInPeriod</b> @DashboardPeriods.DeltaLabel(period)</span>
                }
            </div>
        }
        <span class="dfh-spacer"></span>
        <partial name="_PeriodPicker" model="period" />
    </header>

    @if (d == null)
    {
        <div class="dfh-empty dfh-fill">
            <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
            <span class="dfh-empty-title">The dashboard could not be loaded</span>
            <p>Try again in a moment. Your documents are still available in the Documents list.</p>
            <a class="btn btn-secondary" asp-page="/Documents/Index">Open Documents</a>
        </div>
    }
    else
    {
        <div class="dfh-section-header">
            <span class="dfh-section-title">Recent documents</span>
            <a asp-page="/Documents/Index">Open Documents</a>
        </div>

        <div class="dfh-fill">
            @if (d.RecentDocuments.Count == 0)
            {
                <div class="dfh-empty">
                    <i class="bi bi-files" aria-hidden="true"></i>
                    <span class="dfh-empty-title">No documents yet</span>
                    <p>Upload a document, or ask a teammate to share one with your team. It will show up here.</p>
                    @if (!DemoMode.IsEnabled)
                    {
                        <a class="btn btn-primary" asp-page="/Documents/Upload"><i class="bi bi-upload" aria-hidden="true"></i>Upload</a>
                    }
                </div>
            }
            else
            {
                <table class="dfh-table">
                    <colgroup>
                        <col />
                        <col style="width: 162px" />
                        <col style="width: 52px" />
                        <col style="width: 76px" />
                        <col style="width: 96px" />
                        <col style="width: 148px" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Location</th>
                            <th scope="col">Ver</th>
                            <th scope="col" class="is-num">Size</th>
                            <th scope="col">Modified</th>
                            <th scope="col">Author</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in d.RecentDocuments)
                        {
                            var (typeLabel, typeKind) = Dfh.FileType(doc.FileType);
                            <tr data-dfh-href="/Documents/Details/@doc.Id">
                                <td>
                                    <div class="dfh-name-cell">
                                        <span class="dfh-filetype dfh-filetype--@typeKind">@typeLabel</span>
                                        <a class="dfh-cell-link dfh-ellipsis" href="/Documents/Details/@doc.Id">@doc.Title</a>
                                        @if (doc.HasSummary)
                                        {
                                            <i class="bi bi-stars dfh-ai-star" title="AI summary available" aria-label="AI summary available"></i>
                                        }
                                    </div>
                                </td>
                                <td class="is-mono is-muted" title="@doc.Location">@(doc.Location ?? "—")</td>
                                <td class="is-mono is-2">@(doc.Version != null ? $"v{doc.Version}" : "—")</td>
                                <td class="is-mono is-muted is-num">@Dfh.FileSize(doc.FileSize)</td>
                                <td class="is-muted" title="@Dfh.Timestamp(doc.ModifiedAt)">@Dfh.Relative(doc.ModifiedAt)</td>
                                <td>
                                    <span class="dfh-person">
                                        <span class="dfh-avatar dfh-avatar--18" aria-hidden="true">@Dfh.Initials(doc.OwnerName)</span>
                                        <span class="dfh-ellipsis">@doc.OwnerName</span>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="dfh-strip">
            @* AI: there is no job queue, so this lists documents that have no summary yet (decision S10-2). *@
            <section aria-labelledby="ai-title">
                <div class="dfh-strip-head">
                    <i class="bi bi-stars is-ai" aria-hidden="true"></i>
                    <span class="dfh-strip-title" id="ai-title">AI summaries</span>
                    <span class="dfh-mono">@d.DocumentsWithoutSummary without summary</span>
                </div>
                @if (d.NewestWithoutSummary.Count == 0)
                {
                    <p class="dfh-strip-note">@(d.Documents == 0 ? "Summaries appear here once you add documents." : "Every document has an AI summary.")</p>
                }
                else
                {
                    <ul class="dfh-dot-list">
                        @foreach (var doc in d.NewestWithoutSummary)
                        {
                            <li>
                                <span class="dfh-dot dfh-dot--ai-hollow" aria-hidden="true"></span>
                                <a class="dfh-ellipsis" href="/Documents/Details/@doc.Id">@doc.Title</a>
                                <span class="dfh-mono">no summary</span>
                            </li>
                        }
                    </ul>
                }
                <span class="dfh-spacer"></span>
                @if (Model.AiRequestsToday != null && Model.AiDailyLimit is > 0)
                {
                    var used = Model.AiRequestsToday.Value;
                    var limit = Model.AiDailyLimit.Value;
                    var pct = Math.Min(100, used * 100.0 / limit);
                    <div class="dfh-meter">
                        <div class="dfh-meter-label"><span>Requests today</span><span class="dfh-mono">@Dfh.Number(used) / @Dfh.Number(limit)</span></div>
                        <div class="dfh-meter-track" role="progressbar" aria-label="AI requests today" aria-valuemin="0" aria-valuemax="@limit" aria-valuenow="@used">
                            <div class="dfh-meter-fill @(pct > 90 ? "dfh-meter-fill--warning" : "dfh-meter-fill--ai")" style="width: @Dfh.Percent(used, limit)"></div>
                        </div>
                    </div>
                }
            </section>

            <partial name="_StoragePanel" model="new StoragePanel(d.Storage, d.StorageBytes)" />

            <section class="is-flush" aria-labelledby="teams-title">
                <div class="dfh-strip-head">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span class="dfh-strip-title" id="teams-title">Teams</span>
                    <a asp-page="/Teams/Index">Manage</a>
                </div>
                @if (d.TeamList.Count == 0)
                {
                    <p class="dfh-strip-note">You're not in a team yet.</p>
                }
                else
                {
                    <ul class="dfh-team-list">
                        @foreach (var team in d.TeamList)
                        {
                            <li>
                                <span class="dfh-swatch" style="background: @Dfh.TeamColor(team.Id)" aria-hidden="true"></span>
                                <a class="dfh-team-name dfh-ellipsis" href="/Teams/Details/@team.Id">@team.Name</a>
                                <span class="dfh-chip">@team.Role</span>
                                <span class="dfh-team-count" title="Members">@team.MemberCount</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    }
</div>
