@page "/StatusCode/{code:int}"
@model DocFlowHub.Web.Pages.StatusCodeModel
@{
    ViewData["Title"] = Model.Title;
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}
<div class="dfh-error">
    <span class="dfh-error-code">@Model.Code · @Model.CodeName</span>
    <h1 class="dfh-heading">@Model.Title</h1>
    <p>@Model.Message</p>
    <div class="dfh-error-actions">
        <a class="btn btn-secondary" asp-page="/Index"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to the home page</a>
    </div>
</div>
