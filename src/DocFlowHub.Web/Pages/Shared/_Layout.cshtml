@using System.Text.Json
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@using DocFlowHub.Core.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject IAntiforgery Antiforgery
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var csrf = Antiforgery.GetAndStoreTokens(Context);

    // Messages queued by the server for this request, shown as toasts by shell.js.
    var serverToasts = new List<object>();
    if (TempData["DemoReadOnlyMessage"] is string demoMessage)
    {
        serverToasts.Add(new { type = "info", message = demoMessage });
    }
    // Redesigned pages report the result of a form post with these two keys.
    if (TempData["ToastSuccess"] is string toastSuccess)
    {
        serverToasts.Add(new { type = "success", message = toastSuccess });
    }
    if (TempData["ToastError"] is string toastError)
    {
        serverToasts.Add(new { type = "error", message = toastError });
    }
    // Older page models still report results in StatusMessage ("Error: …" for failures).
    if (TempData["StatusMessage"] is string status && !string.IsNullOrWhiteSpace(status))
    {
        var failed = status.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
        var text = status.StartsWith("Error:", StringComparison.OrdinalIgnoreCase) ? status[6..].Trim() : status;
        serverToasts.Add(new { type = failed ? "error" : "success", message = text });
    }

    // Pages redesigned for the IDE shell set ViewData["FullBleed"] = true and lay out their own
    // panels; older pages get a padded, scrolling container.
    var fullBleed = ViewData["FullBleed"] as bool? == true;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="DocFlowHub - document management" />
    <meta name="csrf-token" content="@csrf.RequestToken" />
    <title>@ViewData["Title"] - DocFlowHub</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="preload" href="~/lib/fonts/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    @* IDE redesign *@
    <link rel="stylesheet" href="~/css/dfh/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dfh/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dfh/bootstrap.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dfh/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dfh/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dfh/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dfh/responsive.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dfh-shell">
    <partial name="_TitleBar" />

    @* Page-wide banners (design 7e). The demo one can be dismissed for the browser session. *@
    <div class="dfh-shell-banners">
        @if (signedIn && DemoMode.IsEnabled)
        {
            <div class="dfh-banner dfh-banner--ai" data-dfh-dismiss-key="demo-banner" hidden>
                <i class="bi bi-lock" aria-hidden="true"></i>
                <span class="dfh-grow">Demo is read-only. Uploads, edits and deletes are disabled.</span>
                <button type="button" class="dfh-banner-close" data-dfh-dismiss aria-label="Hide this message"><i class="bi bi-x" aria-hidden="true"></i></button>
            </div>
        }
    </div>

    <div class="dfh-workbench">
        @if (signedIn)
        {
            <partial name="_Rail" />
        }
        @await RenderSectionAsync("ToolWindow", required: false)
        <main class="dfh-main" id="main">
            @if (fullBleed)
            {
                @RenderBody()
            }
            else
            {
                <div class="dfh-page">@RenderBody()</div>
            }
        </main>
        @await RenderSectionAsync("Inspector", required: false)
    </div>

    @await Component.InvokeAsync("StatusBar")
    @if (signedIn)
    {
        <partial name="_BottomNav" />
    }

    @if (signedIn)
    {
        <partial name="_Palette" />
    }

    <div id="dfh-toast-stack" class="dfh-toast-stack" aria-live="polite"></div>
    @if (serverToasts.Count > 0)
    {
        <script type="application/json" id="dfh-server-toasts">@Html.Raw(JsonSerializer.Serialize(serverToasts))</script>
    }

    @* One antiforgery token for page scripts that read input[name="__RequestVerificationToken"]. *@
    <input type="hidden" name="__RequestVerificationToken" value="@csrf.RequestToken" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dfh/shell.js" asp-append-version="true"></script>
    @if (signedIn)
    {
        <script src="~/js/dfh/palette.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
