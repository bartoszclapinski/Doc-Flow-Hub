@* Period dropdown for the dashboard pages ("Last 7 days"); a plain GET link per option. *@
@model DocFlowHub.Core.Models.Dashboard.DashboardPeriod
<div class="dropdown">
    <button type="button" class="dfh-filter-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        @DashboardPeriods.Label(Model)<i class="bi bi-chevron-down" aria-hidden="true"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        @foreach (var period in DashboardPeriods.All)
        {
            var active = period == Model;
            <li>
                <a class="dropdown-item @(active ? "active" : "")" href="?period=@DashboardPeriods.Query(period)"
                   aria-current="@(active ? "true" : null)">@DashboardPeriods.Label(period)</a>
            </li>
        }
    </ul>
</div>
