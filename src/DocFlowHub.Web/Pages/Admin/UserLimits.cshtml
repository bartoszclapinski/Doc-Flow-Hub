@page
@model DocFlowHub.Web.Pages.Admin.UserLimitsModel
@{
    ViewData["Title"] = "User limits";
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    string Link(string? status) => "/Admin/UserLimits" + (status != null || Model.Search != null
        ? "?" + string.Join("&", new[] { Model.Search != null ? $"q={Uri.EscapeDataString(Model.Search)}" : null, status != null ? $"status={status}" : null }.Where(s => s != null))
        : "");
}

<div class="dfh-column">
    <header class="dfh-page-header">
        <h1>User limits</h1>
        <div class="dfh-statline" aria-label="Today">
            <span><b>@Model.Total</b> users</span>
            <span><b class="@(Model.Warning > 0 ? "is-warning" : null)">@Model.Warning</b> near the limit</span>
            <span><b class="@(Model.Exceeded > 0 ? "is-danger" : null)">@Model.Exceeded</b> over</span>
        </div>
        <nav class="dfh-segmented" aria-label="State">
            @foreach (var (value, label) in new (string?, string)[] { (null, "All"), ("warning", "Near"), ("exceeded", "Over") })
            {
                <a href="@Link(value)" class="@(Model.Status == value ? "is-active" : null)">@label</a>
            }
        </nav>
        <span class="dfh-spacer"></span>
        <form method="get" class="dfh-search dfh-search--240" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            @if (Model.Status != null)
            {
                <input type="hidden" name="status" value="@Model.Status" />
            }
            <input type="search" name="q" value="@Model.Search" class="dfh-search-input" placeholder="name or email…" aria-label="Search users" />
        </form>
    </header>

    <div class="dfh-banner dfh-banner--info" role="note">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        <span>Every user has the same fixed limits: <b class="dfh-mono">@Dfh.Number(Model.DailyLimit)</b> AI requests a day, <b class="dfh-mono">@Model.HourlyLimit</b> an hour and <b class="dfh-mono">$@Model.DailyCostLimit.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</b> a day. They reset at midnight UTC and can't be changed here yet.</span>
    </div>

    <div class="dfh-fill">
        <table class="dfh-table" aria-label="AI usage today">
            <colgroup><col /><col style="width: 220px" /><col style="width: 120px" /><col style="width: 96px" /><col style="width: 96px" /><col style="width: 104px" /></colgroup>
            <thead>
                <tr>
                    <th scope="col">User</th>
                    <th scope="col">Requests today</th>
                    <th scope="col" class="is-num">Used</th>
                    <th scope="col" class="is-num">This hour</th>
                    <th scope="col" class="is-num">Cost today</th>
                    <th scope="col">State</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Rows)
                {
                    var state = Model.StateOf(u);
                    var pct = Model.DailyLimit > 0 ? Math.Min(100, u.Requests * 100.0 / Model.DailyLimit) : 0;
                    <tr data-dfh-href="/Admin/Users/Details/@u.UserId">
                        <td>
                            <span class="dfh-user-cell">
                                <span class="dfh-avatar dfh-avatar--22" aria-hidden="true">@Dfh.Initials(u.Name)</span>
                                <a class="dfh-cell-link" href="/Admin/Users/Details/@u.UserId">@u.Name</a>
                                <span class="dfh-mono dfh-muted dfh-ellipsis">@u.Email</span>
                            </span>
                        </td>
                        <td>
                            <span class="dfh-meter-track dfh-meter-track--inline" title="@u.Requests of @Model.DailyLimit">
                                <span class="dfh-meter-fill @(state == "exceeded" ? "is-danger" : state == "warning" ? "dfh-meter-fill--warning" : "dfh-meter-fill--ai")" style="width: @pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                            </span>
                        </td>
                        <td class="is-mono is-num">@u.Requests / @Dfh.Number(Model.DailyLimit)</td>
                        <td class="is-mono is-muted is-num">@u.RequestsThisHour</td>
                        <td class="is-mono is-muted is-num">$@u.Cost.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td><span class="dfh-presence"><span class="dfh-dot @(state == "exceeded" ? "dfh-dot--danger" : state == "warning" ? "dfh-dot--warning" : "dfh-dot--success")" aria-hidden="true"></span>@(state == "exceeded" ? "Over" : state == "warning" ? "Near limit" : "OK")</span></td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="6" class="dfh-muted">No user matches.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
