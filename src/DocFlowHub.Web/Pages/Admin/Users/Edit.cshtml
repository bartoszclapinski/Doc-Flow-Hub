@page "{id?}"
@model DocFlowHub.Web.Pages.Admin.Users.EditModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@using DocFlowHub.Web.Extensions
@{
    var input = Model.Input!;
    var name = $"{input.FirstName} {input.LastName}".Trim();
    name = name.Length > 0 ? name : input.Email;
    ViewData["Title"] = $"Edit · {name}";
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var summary = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new List<string>();
    var stats = Model.UserStats;
}

@section Inspector {
    @if (stats != null)
    {
        <aside class="dfh-inspector dfh-inspector--300" aria-label="User">
            <div class="dfh-panel-header is-inspector"><span class="dfh-panel-title">User</span></div>
            <div class="dfh-insp-block">
                <dl class="dfh-kv dfh-kv--side dfh-kv--92">
                    <dt>Registered</dt><dd class="dfh-mono">@stats.CreatedAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</dd>
                    <dt>Last login</dt><dd>@(stats.LastLoginAt is DateTime last ? Dfh.Relative(last) : "never")</dd>
                    <dt>Documents</dt><dd class="dfh-mono">@stats.DocumentCount</dd>
                    <dt>Storage</dt><dd class="dfh-mono">@Dfh.FileSize(stats.TotalStorageUsed)</dd>
                    <dt>Teams</dt><dd class="dfh-mono">@stats.TeamCount</dd>
                </dl>
            </div>
            <div class="dfh-insp-block">
                <a class="btn btn-secondary btn-sm" href="/Admin/Users/Details/@input.Id"><i class="bi bi-person" aria-hidden="true"></i>Open user page</a>
            </div>
        </aside>
    }
}

<form class="dfh-column" method="post" asp-route-id="@input.Id" data-dfh-busy="Saving…">
    <partial name="_EditorTabs" model='new EditorTabsView(name, Icon: "bi-pencil", Suffix: "edit")' />
    <input type="hidden" name="Input.Id" value="@input.Id" />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (summary.Count > 0)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@string.Join(" ", summary)</span></div>
            }
            <partial name="_UserFields" model="new DocFlowHub.Web.Pages.Admin.Users.UserFieldsView(input.Email, input.FirstName, input.LastName, input.EmailConfirmed, false, Model.AvailableRoles.Select(r => r.Name).ToList(), input.SelectedRoles, input.Id == User.GetUserId())" />
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" href="/Admin/Users/Details/@input.Id">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Save</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Save</button>
        }
    </div>
</form>
