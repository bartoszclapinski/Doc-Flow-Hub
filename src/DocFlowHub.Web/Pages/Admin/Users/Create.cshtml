@page
@model DocFlowHub.Web.Pages.Admin.Users.CreateModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "Create user";
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var input = Model.Input;
    var summary = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new List<string>();
}

<form class="dfh-column" method="post" data-dfh-busy="Creating…">
    <partial name="_EditorTabs" model='new EditorTabsView("Create user", Icon: "bi-person-plus")' />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (summary.Count > 0)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@string.Join(" ", summary)</span></div>
            }
            <partial name="_UserFields" model="new DocFlowHub.Web.Pages.Admin.Users.UserFieldsView(input.Email, input.FirstName, input.LastName, input.EmailConfirmed, true, Model.AvailableRoles.Select(r => r.Name).ToList(), input.SelectedRoles, false)" />
            <p class="dfh-insp-note">The new user signs in with this e-mail and password. DocFlowHub does not send e-mails, so share the password with them yourself.</p>
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" asp-page="/Admin/Users/Index">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Create user</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Create user</button>
        }
    </div>
</form>
