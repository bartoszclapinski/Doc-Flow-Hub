@page
@model DocFlowHub.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var users = Model.Users;
    var returnUrl = Model.Link(page: Model.PageNumber);
    var demoTip = "Read-only demo — changes are disabled";
    var statusLabel = IndexModel.Statuses.FirstOrDefault(s => s.Value == Model.Status).Label;
    var from = users.TotalItems == 0 ? 0 : (users.PageNumber - 1) * users.PageSize + 1;
    var to = Math.Min(users.PageNumber * users.PageSize, users.TotalItems);
    var pages = users.TotalPages;
    // Numbered pager: first, last, and two around the current page.
    var shown = Enumerable.Range(1, pages).Where(p => p == 1 || p == pages || Math.Abs(p - users.PageNumber) <= 2).ToList();
}

<div class="dfh-column">
    <header class="dfh-page-header">
        <h1>Users</h1>
        <form class="dfh-token-search" method="get" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            @if (statusLabel != null)
            {
                <span class="dfh-token"><span class="dfh-token-key">status:</span>@statusLabel.ToLowerInvariant()<a href="@Model.Link(status: null)" aria-label="Remove the status filter"><i class="bi bi-x" aria-hidden="true"></i></a></span>
                <input type="hidden" name="status" value="@Model.Status" />
            }
            @if (Model.Role != null)
            {
                <span class="dfh-token"><span class="dfh-token-key">role:</span>@Model.Role<a href="@Model.Link(role: null)" aria-label="Remove the role filter"><i class="bi bi-x" aria-hidden="true"></i></a></span>
                <input type="hidden" name="role" value="@Model.Role" />
            }
            <input type="search" name="q" value="@Model.Search" class="dfh-search-input" placeholder="name or email…" aria-label="Search users by name or e-mail" />
        </form>
        <div class="dropdown">
            <button type="button" class="dfh-filter-btn@(Model.Status != null ? " is-active" : "")" data-bs-toggle="dropdown" aria-expanded="false">Status<i class="bi bi-chevron-down" aria-hidden="true"></i></button>
            <ul class="dropdown-menu dropdown-menu-end dfh-filter-menu">
                <li><a class="dropdown-item" href="@Model.Link(status: null)"><i class="bi @(Model.Status == null ? "bi-check-lg" : "")" aria-hidden="true"></i>Any status</a></li>
                @foreach (var s in IndexModel.Statuses)
                {
                    <li><a class="dropdown-item" href="@Model.Link(status: s.Value)"><i class="bi @(Model.Status == s.Value ? "bi-check-lg" : "")" aria-hidden="true"></i>@s.Label</a></li>
                }
            </ul>
        </div>
        <div class="dropdown">
            <button type="button" class="dfh-filter-btn@(Model.Role != null ? " is-active" : "")" data-bs-toggle="dropdown" aria-expanded="false">Role<i class="bi bi-chevron-down" aria-hidden="true"></i></button>
            <ul class="dropdown-menu dropdown-menu-end dfh-filter-menu">
                <li><a class="dropdown-item" href="@Model.Link(role: null)"><i class="bi @(Model.Role == null ? "bi-check-lg" : "")" aria-hidden="true"></i>Any role</a></li>
                @foreach (var r in Model.AvailableRoles)
                {
                    <li><a class="dropdown-item" href="@Model.Link(role: r)"><i class="bi @(Model.Role == r ? "bi-check-lg" : "")" aria-hidden="true"></i>@r</a></li>
                }
            </ul>
        </div>
        @if (Model.IsDemo)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="@demoTip"><button type="button" class="btn btn-primary" disabled><i class="bi bi-person-plus" aria-hidden="true"></i>Create user</button></span>
        }
        else
        {
            <a class="btn btn-primary" asp-page="/Admin/Users/Create"><i class="bi bi-person-plus" aria-hidden="true"></i>Create user</a>
        }
    </header>

    @* Bulk bar: the buttons fill in the hidden form below (users-admin.js). *@
    <div class="dfh-bulkbar" id="dfh-bulkbar" hidden>
        <span class="dfh-bulkbar-count"><b data-dfh-bulk-count>0</b> selected</span>
        @* "Activate / deactivate" in UserManagementService are the same lockout as "unlock / lock", so only Lock and Unlock are offered. *@
        @foreach (var (op, icon, label, danger) in new[] { ("assign-role", "bi-person-badge", "Assign role", false), ("lock", "bi-lock", "Lock", false), ("UnlockAccount", "bi-unlock", "Unlock", false), ("message", "bi-envelope", "Message", false), ("Delete", "bi-trash", "Delete", true) })
        {
            if (Model.IsDemo)
            {
                <span class="d-inline-block" tabindex="0" title="@demoTip"><button type="button" class="dfh-bulk-action@(danger ? " is-danger" : "")" disabled><i class="bi @icon" aria-hidden="true"></i>@label</button></span>
            }
            else
            {
                <button type="button" class="dfh-bulk-action@(danger ? " is-danger" : "")" data-dfh-users-bulk="@op"><i class="bi @icon" aria-hidden="true"></i>@label</button>
            }
        }
        <span class="dfh-spacer"></span>
        <button type="button" class="dfh-bulk-action is-plain" data-dfh-bulk="clear">Clear</button>
    </div>

    @if (users.TotalItems == 0)
    {
        <div class="dfh-fill">
            <div class="dfh-empty dfh-empty--left">
                <i class="bi bi-search" aria-hidden="true"></i>
                <span class="dfh-empty-title">No users match</span>
                <p>Nobody matches @(Model.Search != null ? $"“{Model.Search}”" : "these filters")@(statusLabel != null ? $", status {statusLabel.ToLowerInvariant()}" : "")@(Model.Role != null ? $", role {Model.Role}" : "").</p>
                <ul class="dfh-link-list"><li><a href="/Admin/Users">Clear the search and filters</a></li></ul>
            </div>
        </div>
    }
    else
    {
        <div class="dfh-fill">
            <table class="dfh-table dfh-table--users" data-dfh-doc-table aria-label="Users" aria-multiselectable="true">
                <colgroup>
                    <col class="dfh-col-check" />
                    <col />
                    <col style="width: 112px" />
                    <col style="width: 104px" />
                    <col style="width: 132px" />
                    <col style="width: 80px" />
                    <col style="width: 64px" />
                    <col style="width: 96px" />
                    <col style="width: 44px" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col" class="dfh-check-cell"><input type="checkbox" class="form-check-input dfh-check" id="dfh-check-all" aria-label="Select all users on this page" /></th>
                        <th scope="col">User</th>
                        <th scope="col">Role</th>
                        <th scope="col">Status</th>
                        <th scope="col">Teams</th>
                        <th scope="col" class="is-num">Storage</th>
                        <th scope="col" class="is-num" title="AI requests in the last 30 days">AI req</th>
                        <th scope="col">Last login</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in users.Items)
                    {
                        var row = Model.Rows.GetValueOrDefault(u.Id);
                        var name = row?.Name ?? u.Email ?? u.Id;
                        var status = row?.Status ?? "active";
                        var isMe = u.Id == Model.CurrentUserId;
                        <tr data-id="@u.Id" data-dfh-href="/Admin/Users/Details/@u.Id">
                            <td class="dfh-check-cell"><input type="checkbox" class="form-check-input dfh-check dfh-row-check" value="@u.Id" aria-label="Select @name" /></td>
                            <td>
                                <span class="dfh-user-cell">
                                    <span class="dfh-avatar dfh-avatar--22@(isMe ? " dfh-avatar--me" : "")" aria-hidden="true">@Dfh.Initials(name)</span>
                                    <a class="dfh-cell-link" href="/Admin/Users/Details/@u.Id">@name</a>
                                    <span class="dfh-mono dfh-muted dfh-ellipsis">@u.Email</span>
                                </span>
                            </td>
                            <td><span class="dfh-role@(row?.IsAdministrator == true ? " is-owner" : "")">@(row == null || row.Roles.Count == 0 ? "User" : string.Join(", ", row.Roles))</span></td>
                            <td><span class="dfh-presence"><span class="dfh-dot dfh-dot--status-@status" aria-hidden="true"></span>@(status switch { "locked" => "Locked", "unconfirmed" => "Unconfirmed", _ => "Active" })</span></td>
                            <td class="is-muted" title="@(row == null ? null : string.Join(", ", row.Teams))">@(row == null || row.Teams.Count == 0 ? "—" : string.Join(", ", row.Teams))</td>
                            <td class="is-mono is-muted is-num">@Dfh.FileSize(row?.StorageBytes ?? 0)</td>
                            <td class="is-mono is-muted is-num">@(row?.AiRequests ?? 0)</td>
                            <td class="is-muted" title="@(u.LastLoginAt is DateTime at ? Dfh.Timestamp(at) : null)">@(u.LastLoginAt is DateTime last ? Dfh.Relative(last) : "never")</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="dfh-icon-action" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @name"><i class="bi bi-three-dots" aria-hidden="true"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/Admin/Users/Details/@u.Id"><i class="bi bi-person" aria-hidden="true"></i>View</a></li>
                                        @if (!Model.IsDemo)
                                        {
                                            <li><a class="dropdown-item" href="/Admin/Users/Edit/@u.Id"><i class="bi bi-pencil" aria-hidden="true"></i>Edit…</a></li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <partial name="_UserQuickActions" model="new DocFlowHub.Web.Pages.Admin.Users.UserQuickActionsView(u.Id, row, isMe, returnUrl)" />
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="dfh-pager" aria-label="Pages">
            <span class="dfh-mono">@from–@to of @Dfh.Number(users.TotalItems)</span>
            @if (pages > 1)
            {
                <span class="dfh-pager-nav dfh-mono">
                    @if (users.PageNumber > 1)
                    {
                        <a class="dfh-pager-btn" href="@Model.Link(page: users.PageNumber - 1)" rel="prev" aria-label="Previous page">‹</a>
                    }
                    @for (var i = 0; i < shown.Count; i++)
                    {
                        if (i > 0 && shown[i] - shown[i - 1] > 1)
                        {
                            <span class="dfh-muted">…</span>
                        }
                        if (shown[i] == users.PageNumber)
                        {
                            <span class="dfh-pager-page is-current" aria-current="page">@shown[i]</span>
                        }
                        else
                        {
                            <a class="dfh-pager-page" href="@Model.Link(page: shown[i])">@shown[i]</a>
                        }
                    }
                    @if (users.PageNumber < pages)
                    {
                        <a class="dfh-pager-btn" href="@Model.Link(page: users.PageNumber + 1)" rel="next" aria-label="Next page">›</a>
                    }
                </span>
            }
        </nav>
    }
</div>

@if (!Model.IsDemo)
{
    @* One form for every bulk operation; users-admin.js fills it and opens a dialog when needed. *@
    <form method="post" asp-page-handler="Bulk" id="dfh-users-bulk-form" hidden>
        <input type="hidden" name="operation" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
    </form>

    <div class="modal" id="dfh-users-dialog" tabindex="-1" aria-labelledby="dfh-users-dialog-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="dfh-users-dialog-title"></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body dfh-modal-stack">
                    <p class="m-0" data-dfh-users-text></p>
                    <label class="dfh-field" data-dfh-users-field="role" hidden>
                        <span class="dfh-field-label">Role</span>
                        <select class="form-select" data-dfh-users-input="role">
                            @foreach (var r in Model.AvailableRoles)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </label>
                    <label class="dfh-field" data-dfh-users-field="subject" hidden>
                        <span class="dfh-field-label">Subject</span>
                        <input class="form-control" maxlength="200" data-dfh-users-input="subject" />
                    </label>
                    <label class="dfh-field" data-dfh-users-field="message" hidden>
                        <span class="dfh-field-label">Message</span>
                        <textarea class="form-control" rows="4" maxlength="4000" data-dfh-users-input="message"></textarea>
                    </label>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" data-dfh-users-ok></button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/dfh/documents.js" asp-append-version="true"></script>
    <script src="~/js/dfh/users-admin.js" asp-append-version="true"></script>
}
