@page "{id?}"
@model DocFlowHub.Web.Pages.Admin.Users.DetailsModel
@{
    var d = Model.Details;
    ViewData["Title"] = d.Name;
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var returnUrl = $"/Admin/Users/Details/{d.Id}";
    var demoTip = "Read-only demo — changes are disabled";
    string Iso(DateTime utc) => utc.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var statusText = d.Status switch { "locked" => "Locked", "unconfirmed" => "E-mail not confirmed", _ => "Active" };
}

@section Inspector {
    <aside class="dfh-inspector dfh-inspector--300" aria-label="Recent actions">
        <div class="dfh-panel-header is-inspector"><span class="dfh-panel-title">Recent actions</span></div>
        @if (d.RecentActions.Count == 0)
        {
            <div class="dfh-empty dfh-empty--inline">
                <p>No recorded actions for this user. The app records admin actions (lock, unlock, roles, deletions) and a few user actions.</p>
            </div>
        }
        else
        {
            <ul class="dfh-activity">
                @foreach (var a in d.RecentActions)
                {
                    <li class="dfh-activity-item">
                        <span class="dfh-avatar dfh-avatar--22" aria-hidden="true">@Dfh.Initials(a.ActorName)</span>
                        <div>
                            <div class="dfh-activity-line"><b>@a.ActorName</b> @a.Description</div>
                            <div class="dfh-activity-meta"><span class="dfh-tag--user">@a.Type</span><span title="@Dfh.Timestamp(a.At)">@Dfh.Relative(a.At)</span></div>
                        </div>
                    </li>
                }
            </ul>
        }
    </aside>
}

<div class="dfh-column">
    <header class="dfh-entity-header">
        <span class="dfh-avatar dfh-avatar--32@(Model.IsMe ? " dfh-avatar--me" : "")" aria-hidden="true">@Dfh.Initials(d.Name)</span>
        <div class="dfh-entity-header-text">
            <h1>@d.Name@(Model.IsMe ? " (you)" : "")</h1>
            <span class="dfh-mono">@d.Email</span>
        </div>
        <span class="dfh-presence dfh-status-pill"><span class="dfh-dot dfh-dot--status-@d.Status" aria-hidden="true"></span>@statusText</span>
        <span class="dfh-spacer"></span>
        @if (Model.IsDemo)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="@demoTip"><button type="button" class="btn btn-secondary btn-sm" disabled><i class="bi bi-pencil" aria-hidden="true"></i>Edit</button></span>
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="@demoTip"><button type="button" class="btn btn-secondary btn-sm" disabled><i class="bi bi-envelope" aria-hidden="true"></i>Message</button></span>
        }
        else
        {
            <a class="btn btn-secondary btn-sm" href="/Admin/Users/Edit/@d.Id"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
            <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#dfh-message-modal"><i class="bi bi-envelope" aria-hidden="true"></i>Message</button>
            <div class="dropdown">
                <button type="button" class="btn btn-secondary btn-sm btn-icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions"><i class="bi bi-three-dots" aria-hidden="true"></i></button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <partial name="_UserQuickActions" model="new DocFlowHub.Web.Pages.Admin.Users.UserQuickActionsView(d.Id, d, Model.IsMe, returnUrl)" />
                </ul>
            </div>
        }
    </header>

    <div class="dfh-fill">
        <div class="dfh-detail-grid">
            <section class="dfh-detail-panel" aria-labelledby="account-title">
                <h2 class="dfh-form-heading" id="account-title">Account</h2>
                <dl class="dfh-kv dfh-kv--side dfh-kv--92">
                    <dt>Roles</dt>
                    <dd>@(d.Roles.Count == 0 ? "User" : string.Join(", ", d.Roles))</dd>
                    <dt>Status</dt>
                    <dd>@statusText</dd>
                    <dt>E-mail</dt>
                    <dd>@(d.EmailConfirmed ? "Confirmed" : "Not confirmed")</dd>
                    <dt>Registered</dt>
                    <dd class="dfh-mono">@Iso(d.CreatedAt)</dd>
                    <dt>Last login</dt>
                    <dd title="@(d.LastLoginAt is DateTime at ? Dfh.Timestamp(at) : null)">@(d.LastLoginAt is DateTime last ? Dfh.Relative(last) : "never")</dd>
                </dl>
            </section>
            <section class="dfh-detail-panel" aria-labelledby="usage-title">
                <h2 class="dfh-form-heading" id="usage-title">Usage</h2>
                <dl class="dfh-kv dfh-kv--side dfh-kv--92">
                    <dt>Documents</dt>
                    <dd class="dfh-mono">@Dfh.Number(d.DocumentCount)</dd>
                    <dt>Storage</dt>
                    <dd class="dfh-mono">@Dfh.FileSize(d.StorageBytes)</dd>
                    <dt>Versions</dt>
                    <dd class="dfh-mono">@Dfh.Number(d.VersionCount) uploaded</dd>
                    <dt>Summaries</dt>
                    <dd class="dfh-mono">@d.SummaryCount of @d.DocumentCount documents</dd>
                    <dt>AI requests</dt>
                    <dd class="dfh-mono">@Dfh.Number(d.AiRequests) in 30 days</dd>
                </dl>
            </section>
            <section class="dfh-detail-panel is-wide" aria-labelledby="teams-title">
                <h2 class="dfh-form-heading" id="teams-title">Teams <span class="dfh-mono dfh-muted">@d.Teams.Count</span></h2>
                @if (d.Teams.Count == 0)
                {
                    <p class="dfh-insp-note">Not a member of any team.</p>
                }
                else
                {
                    <div class="dfh-chips">@foreach (var t in d.Teams) {<span class="dfh-chip--outline">@t</span>}</div>
                }
            </section>
        </div>
    </div>
</div>

@if (!Model.IsDemo)
{
    <div class="modal" id="dfh-message-modal" tabindex="-1" aria-labelledby="dfh-message-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" asp-page-handler="Message" asp-route-id="@d.Id" data-dfh-busy="Sending…">
                <div class="modal-header">
                    <h2 class="modal-title" id="dfh-message-title">Message @d.Name</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body dfh-modal-stack">
                    <label class="dfh-field"><span class="dfh-field-label">Subject</span><input name="subject" class="form-control" maxlength="200" required /></label>
                    <label class="dfh-field"><span class="dfh-field-label">Message</span><textarea name="message" class="form-control" rows="4" maxlength="4000" required></textarea></label>
                    <p class="dfh-insp-note">The message is saved on the user's record. Users have no inbox and no e-mail is sent yet, so they won't see it.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Send</button>
                </div>
            </form>
        </div>
    </div>
}
