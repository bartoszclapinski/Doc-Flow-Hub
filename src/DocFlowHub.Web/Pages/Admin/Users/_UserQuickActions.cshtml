@model DocFlowHub.Web.Pages.Admin.Users.UserQuickActionsView
@* Quick actions on one user, as dropdown items (users table row menu, user page). Locking is the only
   way to stop someone signing in: the service's "deactivate" is the same lockout. *@
@{
    var row = Model.Row;
    var actions = new List<(string Action, string Icon, string Label, bool Danger)>();
    if (row?.IsLocked == true) actions.Add(("unlock", "bi-unlock", "Unlock", false)); else actions.Add(("lock", "bi-lock", "Lock (block sign-in)", true));
    if (row?.EmailConfirmed == false) actions.Add(("confirm-email", "bi-patch-check", "Mark e-mail as confirmed", false));
    actions.Add(("reset-password", "bi-key", "Send password reset", false));
}
@foreach (var (action, icon, label, danger) in actions)
{
    var blocked = Model.IsMe && action == "lock";
    <li>
        <form method="post" asp-page="/Admin/Users/Index" asp-page-handler="Quick">
            <input type="hidden" name="userId" value="@Model.UserId" />
            <input type="hidden" name="action" value="@action" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" class="dropdown-item@(danger ? " text-danger" : "")" disabled="@blocked"
                    title="@(blocked ? "You can't lock your own account" : null)">
                <i class="bi @icon" aria-hidden="true"></i>@label
            </button>
        </form>
    </li>
}
