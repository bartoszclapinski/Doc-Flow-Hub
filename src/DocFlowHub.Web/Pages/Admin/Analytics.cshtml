@page
@model DocFlowHub.Web.Pages.Admin.AnalyticsModel
@{
    ViewData["Title"] = "Analytics";
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var a = Model.Data;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Pct(double v) => (v * 100).ToString(v < 0.1 && v > 0 ? "0.0" : "0", inv) + "%";
    string Money(decimal v) => "$" + v.ToString("0.00", inv);
    string Short(int v) => v >= 10000 ? (v / 1000.0).ToString("0.#", inv) + "k" : Dfh.Number(v);
}

<div class="dfh-column">
    <header class="dfh-page-header">
        <h1>Analytics</h1>
        <nav class="dfh-segmented" aria-label="Period">
            @foreach (var days in new[] { 7, 30, 90 })
            {
                <a href="/Admin/Analytics?period=@days" class="@(Model.Period == days ? "is-active" : null)" aria-current="@(Model.Period == days ? "page" : null)">@(days)d</a>
            }
        </nav>
        @if (a != null)
        {
            <div class="dfh-statline" aria-label="Summary">
                <span><b>@Dfh.Number(a.ActiveUsers)</b> active users</span>
                <span><b>@Dfh.Number(a.Uploads)</b> uploads</span>
                <span><b>@Dfh.FileSize(a.StoredBytes)</b> stored</span>
                <span class="is-ai"><b>@Short(a.AiRequests)</b> AI req · @Money(a.AiCost)</span>
            </div>
        }
    </header>

    @if (a == null)
    {
        <div class="dfh-empty dfh-fill">
            <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
            <span class="dfh-empty-title">The analytics could not be loaded</span>
            <p>@Model.ErrorMessage</p>
        </div>
    }
    else
    {
        var max = Math.Max(1, a.UploadsPerDay.Max(d => d.Count));
        var avg = a.UploadsPerDay.Count == 0 ? 0 : a.UploadsPerDay.Average(d => d.Count);
        var mid = a.UploadsPerDay[a.UploadsPerDay.Count / 2].Day;
        <div class="dfh-quad">
            <section class="dfh-quad-cell" aria-labelledby="uploads-title">
                <div class="dfh-quad-head">
                    <span id="uploads-title">Uploads per day</span>
                    <span class="dfh-mono dfh-muted">avg @avg.ToString(avg < 10 ? "0.#" : "0", inv) · peak @max</span>
                </div>
                <div class="dfh-barchart@(a.UploadsPerDay.Count > 45 ? " is-dense" : "")" role="img" aria-label="Uploads per day, @Model.Period days, peak @max">
                    @for (var i = 0; i < a.UploadsPerDay.Count; i++)
                    {
                        var d = a.UploadsPerDay[i];
                        var h = d.Count == 0 ? 0 : Math.Max(2, Math.Round(d.Count * 100.0 / max));
                        <span class="dfh-bar@(i == a.UploadsPerDay.Count - 1 ? " is-today" : "")" style="--h: @h.ToString(inv)%" title="@d.Day.ToString("MMM d", inv) · @d.Count @Dfh.Noun(d.Count, "upload")"></span>
                    }
                </div>
                <div class="dfh-barchart-axis dfh-mono">
                    <span>@a.UploadsPerDay[0].Day.ToString("MMM d", inv)</span><span>@mid.ToString("MMM d", inv)</span><span>@a.UploadsPerDay[^1].Day.ToString("MMM d", inv)</span>
                </div>
            </section>

            <section class="dfh-quad-cell" aria-labelledby="ai-title">
                <div class="dfh-quad-head">
                    <span id="ai-title"><i class="bi bi-stars dfh-ai-text" aria-hidden="true"></i> AI usage by feature</span>
                    @if (a.TopModel != null)
                    {
                        <span class="dfh-mono dfh-muted" title="Most used model">@a.TopModel</span>
                    }
                </div>
                @if (a.AiByOperation.Count == 0)
                {
                    <p class="dfh-insp-note">No AI requests in this period.</p>
                }
                else
                {
                    <ul class="dfh-hbars">
                        @foreach (var op in a.AiByOperation)
                        {
                            <li>
                                <span class="dfh-hbars-label">@AnalyticsModel.OperationLabel(op.Operation)</span>
                                <span class="dfh-hbars-track"><span style="width: @((op.Share * 100).ToString("0.#", inv))%"></span></span>
                                <span class="dfh-mono dfh-muted">@Short(op.Requests) · @Money(op.Cost)</span>
                            </li>
                        }
                    </ul>
                }
                <div class="dfh-toolwindow-spacer"></div>
                <div class="dfh-quad-foot">
                    <span>Cache hit rate <b class="dfh-mono">@Pct(a.CacheHitRate)</b></span>
                    <span>Failures <b class="dfh-mono@(a.FailureRate > 0 ? " is-danger" : "")">@Pct(a.FailureRate)</b></span>
                    <span>p95 latency <b class="dfh-mono">@(a.P95LatencySeconds is double p ? p.ToString("0.0", inv) + "s" : "—")</b></span>
                </div>
            </section>

            <section class="dfh-quad-cell" aria-labelledby="storage-title">
                <div class="dfh-quad-head"><span id="storage-title">Top users by storage</span></div>
                <table class="dfh-table dfh-table--compact" aria-labelledby="storage-title">
                    <colgroup><col /><col style="width: 84px" /><col style="width: 64px" /></colgroup>
                    <thead><tr><th scope="col">User</th><th scope="col" class="is-num">Storage</th><th scope="col" class="is-num">Docs</th></tr></thead>
                    <tbody>
                        @foreach (var u in a.TopStorage)
                        {
                            <tr data-dfh-href="/Admin/Users/Details/@u.UserId">
                                <td><span class="dfh-person"><span class="dfh-avatar dfh-avatar--18" aria-hidden="true">@Dfh.Initials(u.Name)</span><span class="dfh-ellipsis">@u.Name</span></span></td>
                                <td class="is-mono is-num">@Dfh.FileSize(u.Bytes)</td>
                                <td class="is-mono is-muted is-num">@u.Documents</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section class="dfh-quad-cell" aria-labelledby="actions-title">
                <div class="dfh-quad-head">
                    <span id="actions-title">Recorded actions</span>
                    <span class="dfh-muted" title="Failed sign-ins, devices and downloads are not recorded">admin + account</span>
                </div>
                @if (a.AdminActions.Count == 0)
                {
                    <p class="dfh-insp-note">Nothing recorded in this period. The app records admin actions on users and roles; failed sign-ins, new devices and downloads are not recorded.</p>
                }
                else
                {
                    <ul class="dfh-event-list">
                        @foreach (var e in a.AdminActions)
                        {
                            var icon = e.Type switch
                            {
                                "UserDeactivated" or "UserDeleted" => ("bi-pause-circle", "is-danger"),
                                "UserLocked" => ("bi-lock", "is-warning"),
                                "RoleAssigned" or "RoleRemoved" => ("bi-person-badge", "is-info"),
                                "PasswordResetSent" => ("bi-key", "is-info"),
                                _ => ("bi-journal-text", ""),
                            };
                            <li>
                                <i class="bi @icon.Item1 @icon.Item2" aria-hidden="true"></i>
                                <span class="dfh-ellipsis"><span>@e.Description</span> <span class="dfh-mono dfh-muted">by @e.ActorName</span></span>
                                <span class="dfh-muted" title="@Dfh.Timestamp(e.At)">@Dfh.Relative(e.At)</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    }
</div>
