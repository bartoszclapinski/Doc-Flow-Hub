@{
    Layout = "_Layout";
    ViewData["IsAdminArea"] = true;

    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    bool Is(string p) => page.Equals(p, StringComparison.OrdinalIgnoreCase);
    bool Starts(string p) => page.StartsWith(p, StringComparison.OrdinalIgnoreCase);

    var nav = new[]
    {
        (Page: "/Admin/Index", Icon: "bi-speedometer2", Label: "Overview", Active: Is("/Admin/Index")),
        (Page: "/Admin/Users/Index", Icon: "bi-people", Label: "Users", Active: Starts("/Admin/Users")),
        (Page: "/Admin/Roles/Index", Icon: "bi-person-badge", Label: "Roles", Active: Starts("/Admin/Roles")),
        (Page: "/Admin/UserLimits", Icon: "bi-shield-check", Label: "User limits", Active: Is("/Admin/UserLimits")),
        (Page: "/Admin/Analytics", Icon: "bi-graph-up", Label: "Analytics", Active: Is("/Admin/Analytics")),
        (Page: "/Admin/Settings/Index", Icon: "bi-sliders", Label: "System settings", Active: Starts("/Admin/Settings")),
    };
}

@section ToolWindow {
    <aside class="dfh-toolwindow dfh-toolwindow--admin" aria-label="Administration">
        <div class="dfh-panel-header"><span class="dfh-panel-title">Admin</span></div>
        <nav class="dfh-nav-list">
            @foreach (var item in nav)
            {
                <a class="dfh-nav-item @(item.Active ? "is-active" : "")" asp-area="" asp-page="@item.Page"
                   aria-current="@(item.Active ? "page" : null)">
                    <i class="bi @item.Icon" aria-hidden="true"></i>@item.Label
                </a>
            }
        </nav>
    </aside>
}

@section Styles {
    @* Old admin page styles, kept until the admin pages are redesigned (Sprint 14). *@
    <link rel="stylesheet" href="~/css/legacy/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

@RenderBody()
