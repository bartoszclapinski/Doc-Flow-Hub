@inject DocFlowHub.Core.Services.Interfaces.IAdminBrowserService AdminBrowser
@{
    Layout = "_Layout";
    ViewData["IsAdminArea"] = true;

    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    bool Is(string p) => page.Equals(p, StringComparison.OrdinalIgnoreCase);
    bool Starts(string p) => page.StartsWith(p, StringComparison.OrdinalIgnoreCase);

    // Counts and mini stats of design 3e (S14-2); the nav still renders if they fail.
    var statsResult = await AdminBrowser.GetNavStatsAsync();
    var stats = statsResult.Succeeded ? statsResult.Data : null;

    var nav = new (string Page, string Icon, string Label, bool Active, int? Count)[]
    {
        ("/Admin/Index", "bi-speedometer2", "Overview", Is("/Admin/Index"), null),
        ("/Admin/Users/Index", "bi-people", "Users", Starts("/Admin/Users"), stats?.Users),
        ("/Admin/Roles/Index", "bi-person-badge", "Roles", Starts("/Admin/Roles"), stats?.Roles),
        ("/Admin/UserLimits", "bi-shield-check", "User limits", Is("/Admin/UserLimits"), null),
        ("/Admin/Analytics", "bi-graph-up", "Analytics", Is("/Admin/Analytics"), null),
        ("/Admin/Settings/Index", "bi-sliders", "System settings", Starts("/Admin/Settings"), null),
    };
}

@section ToolWindow {
    <aside class="dfh-toolwindow dfh-toolwindow--admin" aria-label="Administration">
        <div class="dfh-panel-header"><span class="dfh-panel-title">Admin</span></div>
        <nav class="dfh-nav-list">
            @foreach (var item in nav)
            {
                <a class="dfh-nav-item @(item.Active ? "is-active" : "")" asp-area="" asp-page="@item.Page"
                   aria-current="@(item.Active ? "page" : null)">
                    <i class="bi @item.Icon" aria-hidden="true"></i><span class="dfh-grow">@item.Label</span>
                    @if (item.Count is int count)
                    {
                        <span class="dfh-nav-count">@Dfh.Number(count)</span>
                    }
                </a>
            }
        </nav>
        @if (stats != null)
        {
            <div class="dfh-toolwindow-spacer"></div>
            <dl class="dfh-mini-stats">
                <dt>Active (30d)</dt><dd>@Dfh.Number(stats.ActiveIn30Days)</dd>
                <dt>Locked</dt><dd>@Dfh.Number(stats.Locked)</dd>
                <dt>Sign-ups (7d)</dt><dd class="@(stats.SignupsIn7Days > 0 ? "is-positive" : null)">+@stats.SignupsIn7Days</dd>
            </dl>
        }
    </aside>
}

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}

@section Inspector {
    @await RenderSectionAsync("Inspector", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

@RenderBody()
