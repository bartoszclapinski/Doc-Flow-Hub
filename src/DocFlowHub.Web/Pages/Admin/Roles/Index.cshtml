@page
@model DocFlowHub.Web.Pages.Admin.Roles.IndexModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "Roles";
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var roles = Model.Roles.OrderBy(r => r.Name).ToList();
}

<div class="dfh-column">
    <header class="dfh-page-header">
        <h1>Roles</h1>
        <span class="dfh-mono dfh-muted">@roles.Count</span>
        <span class="dfh-spacer"></span>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled><i class="bi bi-plus-lg" aria-hidden="true"></i>New role</button></span>
        }
        else
        {
            <a class="btn btn-primary" asp-page="/Admin/Roles/Create"><i class="bi bi-plus-lg" aria-hidden="true"></i>New role</a>
        }
    </header>
    <div class="dfh-fill">
        <table class="dfh-table" aria-label="Roles">
            <colgroup>
                <col />
                <col style="width: 84px" />
                <col style="width: 112px" />
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">Role</th>
                    <th scope="col" class="is-num">Users</th>
                    <th scope="col">Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in roles)
                {
                    <tr data-dfh-href="/Admin/Roles/Details/@r.Id">
                        <td>
                            <span class="dfh-name-cell">
                                <i class="bi bi-person-badge dfh-muted" aria-hidden="true"></i>
                                <a class="dfh-cell-link" href="/Admin/Roles/Details/@r.Id">@r.Name</a>
                                @if (r.Name == "Administrator")
                                {
                                    <span class="dfh-chip dfh-chip--warning">protected</span>
                                }
                            </span>
                        </td>
                        <td class="is-mono is-num">@r.UsersCount</td>
                        <td class="is-mono is-muted">@r.CreatedAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="dfh-table-note">Roles decide what a user can do in the whole app. Today only <b>Administrator</b> changes anything: it opens this admin area. Other roles are labels.</p>
    </div>
</div>
