@page
@model DocFlowHub.Web.Pages.Admin.Roles.CreateModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "New role";
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var nameError = ViewData.ModelState["Input.Name"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var summary = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new List<string>();
}

<form class="dfh-column" method="post" data-dfh-busy="Creating…">
    <partial name="_EditorTabs" model='new EditorTabsView("New role", Icon: "bi-person-badge")' />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (summary.Count > 0)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@string.Join(" ", summary)</span></div>
            }
            <partial name="_RoleFields" model="(Model.Input.Name, nameError, false)" />
            <p class="dfh-insp-note">A new role is a label for now: only the Administrator role changes what someone can do.</p>
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" asp-page="/Admin/Roles/Index">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Create role</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Create role</button>
        }
    </div>
</form>
