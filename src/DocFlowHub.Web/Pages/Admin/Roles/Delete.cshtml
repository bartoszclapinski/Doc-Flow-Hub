@page "{id?}"
@model DocFlowHub.Web.Pages.Admin.Roles.DeleteModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    var role = Model.Role!;
    ViewData["Title"] = $"Delete · {role.Name}";
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var summary = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new List<string>();
    var confirmError = ViewData.ModelState["Input.ConfirmationText"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var understandError = ViewData.ModelState["Input.ConfirmUnderstanding"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var blocked = role.Name == "Administrator" || Model.AssignedUsers.Count > 0;
}

<form class="dfh-column" method="post" asp-route-id="@role.Id" data-dfh-busy="Deleting…">
    <partial name="_EditorTabs" model='new EditorTabsView(role.Name, Icon: "bi-trash", Suffix: "delete")' />
    <input type="hidden" name="Input.Id" value="@role.Id" />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (summary.Count > 0)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@string.Join(" ", summary)</span></div>
            }
            <section class="dfh-form-section dfh-danger-zone" aria-labelledby="delete-title">
                <h2 class="dfh-form-heading" id="delete-title">Delete the role “@role.Name”</h2>
                @if (role.Name == "Administrator")
                {
                    <p class="dfh-insp-note m-0">The Administrator role opens the admin area and can't be deleted.</p>
                }
                else if (Model.AssignedUsers.Count > 0)
                {
                    <p class="dfh-insp-note m-0">@Model.AssignedUsers.Count @Dfh.Noun(Model.AssignedUsers.Count, "user") still @(Model.AssignedUsers.Count == 1 ? "has" : "have") this role. Remove it from them first (<a href="/Admin/Roles/Details/@role.Id">see who</a>).</p>
                }
                else
                {
                    <p class="dfh-insp-note m-0">Nobody has this role. Deleting it can't be undone.</p>
                    <label class="dfh-field">
                        <span class="dfh-field-label">Type the role name to confirm</span>
                        <input name="Input.ConfirmationText" class="form-control" autocomplete="off" required placeholder="@role.Name" />
                        @if (confirmError != null)
                        {
                            <span class="field-validation-error">@confirmError</span>
                        }
                    </label>
                    <label class="dfh-check-row">
                        <input type="checkbox" class="form-check-input" name="Input.ConfirmUnderstanding" value="true" required />
                        <input type="hidden" name="Input.ConfirmUnderstanding" value="false" />
                        <span>I understand the role is removed for good.</span>
                    </label>
                    @if (understandError != null)
                    {
                        <span class="field-validation-error">@understandError</span>
                    }
                }
            </section>
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" href="/Admin/Roles/Details/@role.Id">Cancel</a>
        @if (DemoMode.IsEnabled || blocked)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="@(DemoMode.IsEnabled ? "Read-only demo — changes are disabled" : "This role can't be deleted now")"><button type="button" class="btn btn-danger" disabled>Delete role</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash" aria-hidden="true"></i>Delete role</button>
        }
    </div>
</form>
