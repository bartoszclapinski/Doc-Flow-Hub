@page "{id?}"
@model DocFlowHub.Web.Pages.Admin.Roles.EditModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    var input = Model.Input!;
    ViewData["Title"] = $"Edit · {input.Name}";
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var nameError = ViewData.ModelState["Input.Name"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var summary = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new List<string>();
    var locked = input.Name == "Administrator";
}

<form class="dfh-column" method="post" asp-route-id="@input.Id" data-dfh-busy="Saving…">
    <partial name="_EditorTabs" model='new EditorTabsView(input.Name, Icon: "bi-pencil", Suffix: "edit")' />
    <input type="hidden" name="Input.Id" value="@input.Id" />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (summary.Count > 0)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@string.Join(" ", summary)</span></div>
            }
            <partial name="_RoleFields" model="(input.Name, nameError, locked)" />
            @if (Model.RoleStats != null)
            {
                <p class="dfh-insp-note">@Model.RoleStats.UsersCount @Dfh.Noun(Model.RoleStats.UsersCount, "user") @(Model.RoleStats.UsersCount == 1 ? "has" : "have") this role.</p>
            }
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" href="/Admin/Roles/Details/@input.Id">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Save</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Save</button>
        }
    </div>
</form>
