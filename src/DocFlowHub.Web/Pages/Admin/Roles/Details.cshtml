@page "{id?}"
@model DocFlowHub.Web.Pages.Admin.Roles.DetailsModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    var role = Model.Role!;
    ViewData["Title"] = role.Name;
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var demo = DemoMode.IsEnabled;
    var protectedRole = role.Name == "Administrator";
}

<div class="dfh-column">
    <header class="dfh-entity-header">
        <span class="dfh-team-badge dfh-team-badge--32" style="--team: var(--dfh-warning)" aria-hidden="true"><i class="bi bi-person-badge"></i></span>
        <div class="dfh-entity-header-text">
            <h1>@role.Name</h1>
            <span>created @role.CreatedAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)@(role.Name == "Administrator" ? " · opens the admin area" : "")</span>
        </div>
        <span class="dfh-spacer"></span>
        @if (demo)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-secondary btn-sm" disabled><i class="bi bi-pencil" aria-hidden="true"></i>Edit</button></span>
        }
        else
        {
            <a class="btn btn-secondary btn-sm" href="/Admin/Roles/Edit/@role.Id"><i class="bi bi-pencil" aria-hidden="true"></i>Edit</a>
            @if (!protectedRole)
            {
                <a class="btn btn-outline-danger btn-sm" href="/Admin/Roles/Delete/@role.Id"><i class="bi bi-trash" aria-hidden="true"></i>Delete</a>
            }
        }
    </header>
    <div class="dfh-section-header"><span class="dfh-section-title">Users with this role</span><span class="dfh-mono dfh-muted">@Model.AssignedUsers.Count</span></div>
    <div class="dfh-fill">
        @if (Model.AssignedUsers.Count == 0)
        {
            <div class="dfh-empty dfh-empty--inline"><p>Nobody has this role. Assign it from the users list (select users → Assign role) or a user's Edit page.</p></div>
        }
        else
        {
            <table class="dfh-table" aria-label="Users with the @role.Name role">
                <colgroup><col /><col style="width: 260px" /><col style="width: 120px" /><col style="width: 112px" /></colgroup>
                <thead><tr><th scope="col">User</th><th scope="col">E-mail</th><th scope="col">E-mail confirmed</th><th scope="col">Registered</th></tr></thead>
                <tbody>
                    @foreach (var u in Model.AssignedUsers.OrderBy(u => u.FullName))
                    {
                        var name = string.IsNullOrEmpty(u.FullName) ? u.Email : u.FullName;
                        <tr data-dfh-href="/Admin/Users/Details/@u.Id">
                            <td><span class="dfh-person"><span class="dfh-avatar dfh-avatar--18" aria-hidden="true">@Dfh.Initials(name)</span><a class="dfh-cell-link dfh-ellipsis" href="/Admin/Users/Details/@u.Id">@name</a></span></td>
                            <td class="is-mono is-muted">@u.Email</td>
                            <td class="is-muted">@(u.EmailConfirmed ? "yes" : "no")</td>
                            <td class="is-mono is-muted">@u.CreatedAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
