@page
@model DocFlowHub.Web.Pages.Admin.Settings.IndexModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "System settings";
    ViewData["FullBleed"] = true;
    Layout = "_AdminLayout";
    var demo = DemoMode.IsEnabled;
    string Label(string key) => key.Split('.').Last() switch
    {
        var k => System.Text.RegularExpressions.Regex.Replace(k, "(?<=[a-z])(?=[A-Z])", " "),
    };
}

<form class="dfh-column" method="post" asp-page-handler="UpdateSettings" data-dfh-busy="Saving…">
    <header class="dfh-page-header">
        <h1>System settings</h1>
        <span class="dfh-mono dfh-muted">@Model.SettingsGroups.Sum(g => g.Settings.Count)</span>
    </header>

    @* Decision 2026-11-14 ("look + honesty"): nothing reads these values yet. *@
    <div class="dfh-banner dfh-banner--warning" role="note">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <span><b>Saved, not applied yet.</b> The app stores these values but does not read any of them: limits, upload size, registration, maintenance mode and password rules still come from the code and its configuration files.</span>
    </div>

    <div class="dfh-form-scroll">
        <div class="dfh-form-body dfh-form-body--860">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }
            @foreach (var group in Model.SettingsGroups.OrderBy(g => g.Category))
            {
                <section class="dfh-settings-section" aria-labelledby="cat-@group.Category">
                    <div class="dfh-section-divider">
                        <span id="cat-@group.Category">@group.Category</span>
                        <span class="dfh-section-divider-line" aria-hidden="true"></span>
                        @if (!demo)
                        {
                            <button type="submit" class="dfh-link-btn" formaction="?handler=ResetCategory&category=@Uri.EscapeDataString(group.Category)" formnovalidate>Reset @group.Category.ToLowerInvariant() to defaults</button>
                        }
                    </div>
                    @foreach (var s in group.Settings.OrderBy(s => s.Key))
                    {
                        var name = $"SettingsRequest.Settings[{s.Key}]";
                        var id = "set-" + s.Key.Replace('.', '-');
                        <div class="dfh-form-row">
                            <label for="@id" class="dfh-form-row-label">
                                @Label(s.Key)
                                <span class="dfh-mono dfh-muted">@s.Key</span>
                            </label>
                            <div class="dfh-form-row-control">
                                @switch (s.DataType.ToUpperInvariant())
                                {
                                    case "BOOLEAN":
                                        <span class="form-check form-switch m-0">
                                            @* The checkbox comes first: when it is checked its "true" is the first value the binder takes. *@
                                            <input id="@id" type="checkbox" role="switch" class="form-check-input" name="@name" value="true" checked="@(s.Value.Equals("true", StringComparison.OrdinalIgnoreCase))" disabled="@demo" />
                                            <input type="hidden" name="@name" value="false" />
                                        </span>
                                        break;
                                    case "NUMBER":
                                        <input id="@id" type="number" step="any" class="form-control form-control-sm dfh-w-140" name="@name" value="@s.Value" readonly="@demo" />
                                        break;
                                    case "JSON":
                                        <textarea id="@id" class="form-control form-control-sm dfh-mono" rows="3" name="@name" readonly="@demo">@s.Value</textarea>
                                        break;
                                    default:
                                        <input id="@id" type="@(s.IsSensitive ? "password" : "text")" class="form-control form-control-sm dfh-w-260" name="@name" value="@s.Value" readonly="@demo" />
                                        break;
                                }
                                <span class="dfh-form-row-help">
                                    @s.Description
                                    @if (s.DefaultValue != null && s.DefaultValue != s.Value)
                                    {
                                        <text> · default <span class="dfh-mono">@(s.IsSensitive ? "••••" : s.DefaultValue)</span></text>
                                        @if (!demo)
                                        {
                                            <button type="submit" class="dfh-link-btn" formaction="?handler=ResetSetting&key=@Uri.EscapeDataString(s.Key)" formnovalidate>reset</button>
                                        }
                                    }
                                    @if (s.RequiresRestart)
                                    {
                                        <span class="dfh-chip">restart</span>
                                    }
                                </span>
                            </div>
                        </div>
                    }
                </section>
            }
        </div>
    </div>

    <div class="dfh-form-footer">
        <span class="dfh-mono">Changes are recorded with your name and time.</span>
        @if (demo)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Save</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Save</button>
        }
    </div>
</form>
