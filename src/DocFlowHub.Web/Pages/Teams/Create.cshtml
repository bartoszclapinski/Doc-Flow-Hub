@page
@model DocFlowHub.Web.Pages.Teams.CreateModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "New team";
    ViewData["FullBleed"] = true;
    var nameError = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<form class="dfh-column" method="post" data-dfh-busy="Creating…">
    <partial name="_EditorTabs" model='new EditorTabsView("New team", Icon: "bi-people")' />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (Model.ErrorMessage != null)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }
            <partial name="_TeamFields" model="(Model.Name, Model.Description, nameError)" />
            <p class="dfh-insp-note">You become the team's owner and first admin. Then add members by their e-mail address.</p>
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" asp-page="/Teams/Index">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Create team</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Create team</button>
        }
    </div>
</form>
