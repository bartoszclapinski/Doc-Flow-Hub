@page
@model DocFlowHub.Web.Pages.Teams.IndexModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "Teams";
    ViewData["FullBleed"] = true;
    var teams = Model.Teams;
}

<div class="dfh-column">
    <header class="dfh-page-header">
        <h1>Teams</h1>
        <span class="dfh-mono dfh-muted">@teams.Count</span>
        <span class="dfh-spacer"></span>
        @if (teams.Count > 0)
        {
            <label class="dfh-search dfh-search--240">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" class="dfh-search-input" placeholder="Filter teams" aria-label="Filter teams" autocomplete="off" data-dfh-row-filter="#teams-table" />
            </label>
        }
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled><i class="bi bi-plus-lg" aria-hidden="true"></i>New team</button></span>
        }
        else
        {
            <a class="btn btn-primary" asp-page="/Teams/Create"><i class="bi bi-plus-lg" aria-hidden="true"></i>New team</a>
        }
    </header>

    @if (Model.ErrorMessage != null)
    {
        <div class="dfh-empty dfh-fill">
            <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
            <span class="dfh-empty-title">The teams could not be loaded</span>
            <p>@Model.ErrorMessage</p>
        </div>
    }
    else if (teams.Count == 0)
    {
        <div class="dfh-fill dfh-fill--pad">
            <div class="dfh-empty dfh-empty--box">
                <i class="bi bi-people" aria-hidden="true"></i>
                <span class="dfh-empty-title">You are not in a team yet</span>
                <p>A team shares documents with its members. Create one and add colleagues by their e-mail address, or ask a team admin to add you.</p>
                @if (!DemoMode.IsEnabled)
                {
                    <a class="btn btn-primary" asp-page="/Teams/Create"><i class="bi bi-plus-lg" aria-hidden="true"></i>New team</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="dfh-fill">
            <table class="dfh-table dfh-table--tall" id="teams-table" aria-label="Teams">
                <colgroup>
                    <col />
                    <col style="width: 96px" />
                    <col style="width: 84px" />
                    <col style="width: 96px" />
                    <col style="width: 160px" />
                    <col style="width: 104px" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">Team</th>
                        <th scope="col">Your role</th>
                        <th scope="col" class="is-num">Members</th>
                        <th scope="col" class="is-num">Documents</th>
                        <th scope="col">Owner</th>
                        <th scope="col">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in teams)
                    {
                        <tr data-dfh-href="/Teams/Details/@t.Id" data-filter="@($"{t.Name} {t.Description}".ToLowerInvariant())">
                            <td>
                                <div class="dfh-two-line">
                                    <span class="dfh-team-badge" style="--team: @Dfh.TeamColor(t.Id)" aria-hidden="true">@TeamUi.Badge(t.Name)</span>
                                    <span class="dfh-two-line-text">
                                        <a class="dfh-cell-link dfh-ellipsis" href="/Teams/Details/@t.Id">@t.Name</a>
                                        <span class="dfh-ellipsis">@(string.IsNullOrWhiteSpace(t.Description) ? "No description" : t.Description)</span>
                                    </span>
                                </div>
                            </td>
                            <td><span class="dfh-chip@(t.Role == "member" ? "" : " dfh-chip--accent")">@TeamUi.RoleLabel(t.Role)</span></td>
                            <td class="is-mono is-num">@t.MemberCount</td>
                            <td class="is-mono is-muted is-num">@t.DocumentCount</td>
                            <td>
                                <span class="dfh-person">
                                    <span class="dfh-avatar dfh-avatar--18" aria-hidden="true">@Dfh.Initials(t.OwnerName)</span>
                                    <span class="dfh-ellipsis">@t.OwnerName</span>
                                </span>
                            </td>
                            <td class="is-mono is-muted">@t.CreatedAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                    <tr class="dfh-filter-empty" hidden><td colspan="6">No team matches the filter.</td></tr>
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/dfh/row-filter.js" asp-append-version="true"></script>
}
