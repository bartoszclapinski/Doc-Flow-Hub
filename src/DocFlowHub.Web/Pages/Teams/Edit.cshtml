@page "/Teams/Edit/{id:int}"
@model DocFlowHub.Web.Pages.Teams.EditModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    var t = Model.Team;
    ViewData["Title"] = $"Settings · {t.Name}";
    ViewData["FullBleed"] = true;
    var nameError = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage;
    var demo = DemoMode.IsEnabled;
}

<div class="dfh-column">
    <partial name="_EditorTabs" model='new EditorTabsView(t.Name, Icon: "bi-gear", Suffix: "settings")' />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (Model.ErrorMessage != null)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }
            <form class="dfh-modal-stack" method="post" asp-page-handler="Update" asp-route-id="@t.Id" data-dfh-busy="Saving…">
                <partial name="_TeamFields" model="(Model.Name, Model.Description, nameError)" />
                <div class="dfh-empty-actions">
                    @if (demo)
                    {
                        <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Save</button></span>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary">Save</button>
                    }
                    <a class="btn btn-secondary" href="/Teams/Details/@t.Id">Cancel</a>
                </div>
            </form>

            <section class="dfh-form-section dfh-danger-zone" aria-labelledby="danger-title">
                <h2 class="dfh-form-heading" id="danger-title">Danger zone</h2>
                <p class="dfh-insp-note m-0">
                    Deleting the team removes its @t.MemberCount @Dfh.Noun(t.MemberCount, "membership").
                    @if (t.DocumentCount > 0)
                    {
                        <text>The @t.DocumentCount @Dfh.Noun(t.DocumentCount, "document") shared with it stay with their owners and become private.</text>
                    }
                </p>
                <form method="post" asp-page-handler="Delete" asp-route-id="@t.Id"
                      data-dfh-confirm-title="Delete team “@t.Name”?" data-dfh-confirm="Members lose access to the documents shared with the team; the documents stay with their owners. It can't be undone." data-dfh-confirm-button="Delete team">
                    @if (demo)
                    {
                        <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-outline-danger btn-sm" disabled><i class="bi bi-trash" aria-hidden="true"></i>Delete team</button></span>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash" aria-hidden="true"></i>Delete team</button>
                    }
                </form>
            </section>
        </div>
    </div>
</div>
