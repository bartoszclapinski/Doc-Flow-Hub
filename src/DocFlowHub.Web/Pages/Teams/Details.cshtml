@page "/Teams/Details/{id:int}"
@model DocFlowHub.Web.Pages.Teams.DetailsModel
@{
    var t = Model.Team;
    ViewData["Title"] = t.Name;
    ViewData["FullBleed"] = true;
    var demoTip = "Read-only demo — changes are disabled";
    string Iso(DateTime utc) => utc.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    // The rules the app enforces today (TeamService / DocumentService), shown as they are (S13-7).
    var permissions = new (string Label, bool Owner, bool Admin, bool Member)[]
    {
        ("Open and download shared documents", true, true, true),
        ("Edit details, upload new versions", true, true, true),
        ("Share own documents with the team", true, true, true),
        ("Add and remove members", true, true, false),
        ("Change member roles", true, true, false),
        ("Rename or delete the team", true, false, false),
    };
}

@section Inspector {
    <aside class="dfh-inspector dfh-inspector--320" aria-label="Role permissions">
        <div class="dfh-panel-header is-inspector"><span class="dfh-panel-title">Role permissions</span></div>
        <table class="dfh-perm-matrix">
            <thead>
                <tr><th scope="col"><span class="visually-hidden">Permission</span></th><th scope="col">Owner</th><th scope="col">Admin</th><th scope="col">Member</th></tr>
            </thead>
            <tbody>
                @foreach (var (label, owner, admin, member) in permissions)
                {
                    <tr>
                        <th scope="row">@label</th>
                        @foreach (var allowed in new[] { owner, admin, member })
                        {
                            <td>@if (allowed) {<i class="bi bi-check-lg is-yes" aria-label="yes"></i>} else {<i class="bi bi-dash is-no" aria-label="no"></i>}</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <div class="dfh-insp-block">
            <p class="dfh-insp-note">Only a document's owner can move, delete or unshare it, whatever their role in the team.</p>
        </div>
        <div class="dfh-insp-block">
            <span class="dfh-insp-block-head"><span>Documents</span><span class="dfh-mono dfh-muted">@t.DocumentCount</span></span>
            <p class="dfh-insp-note">@(t.DocumentCount == 0 ? "Nothing is shared with this team yet. Share a document from its Sharing tab." : $"{t.DocumentCount} {Dfh.Noun(t.DocumentCount, "document")} shared with {t.Name}.")</p>
            @if (t.DocumentCount > 0)
            {
                <div><a class="btn btn-secondary btn-sm" href="/Documents?team=@t.Id"><i class="bi bi-files" aria-hidden="true"></i>Open in Documents</a></div>
            }
        </div>
    </aside>
}

<div class="dfh-column">
    <header class="dfh-entity-header">
        <span class="dfh-team-badge dfh-team-badge--32" style="--team: @Dfh.TeamColor(t.Id)" aria-hidden="true">@TeamUi.Badge(t.Name)</span>
        <div class="dfh-entity-header-text">
            <h1>@t.Name</h1>
            <span>@(string.IsNullOrWhiteSpace(t.Description) ? "" : t.Description + " · ")created @Iso(t.CreatedAt) · owner @t.OwnerName</span>
        </div>
        <span class="dfh-spacer"></span>
        @if (Model.CanEditTeam)
        {
            <a class="btn btn-secondary btn-sm" href="/Teams/Edit/@t.Id"><i class="bi bi-gear" aria-hidden="true"></i>Settings</a>
        }
        else if (t.IsOwner)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="@demoTip"><button type="button" class="btn btn-secondary btn-sm" disabled><i class="bi bi-gear" aria-hidden="true"></i>Settings</button></span>
        }
        @if (Model.CanManageMembers)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#dfh-add-member-modal"><i class="bi bi-person-plus" aria-hidden="true"></i>Add member</button>
        }
        else
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="@(Model.IsDemo ? demoTip : "Only team admins can add members")"><button type="button" class="btn btn-primary btn-sm" disabled><i class="bi bi-person-plus" aria-hidden="true"></i>Add member</button></span>
        }
    </header>

    <div class="dfh-viewtabs" role="tablist" aria-label="Team">
        <a class="dfh-viewtab is-active" role="tab" aria-selected="true" href="/Teams/Details/@t.Id">Members <span class="dfh-panel-tab-count">@t.MemberCount</span></a>
        <a class="dfh-viewtab" role="tab" aria-selected="false" href="/Documents?team=@t.Id">Documents <span class="dfh-panel-tab-count">@t.DocumentCount</span></a>
    </div>

    <div class="dfh-fill">
        <table class="dfh-table dfh-table--members" aria-label="Members">
            <colgroup>
                <col />
                <col style="width: 220px" />
                <col style="width: 116px" />
                <col style="width: 96px" />
                <col style="width: 112px" />
                <col style="width: 44px" />
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">Member</th>
                    <th scope="col">Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Joined</th>
                    <th scope="col">Last sign-in</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in t.Members)
                {
                    var role = m.IsOwner ? "owner" : m.IsAdmin ? "admin" : "member";
                    var recent = m.LastLoginAt is DateTime seen && DateTime.UtcNow - seen < TimeSpan.FromHours(1);
                    var editable = Model.CanManageMembers && !m.IsOwner;
                    <tr>
                        <td>
                            <span class="dfh-person">
                                <span class="dfh-avatar dfh-avatar--24@(m.IsMe ? " dfh-avatar--me" : "")" aria-hidden="true">@Dfh.Initials(m.Name)</span>
                                <span class="dfh-ellipsis">@m.Name</span>
                                @if (m.IsMe)
                                {
                                    <span class="dfh-muted dfh-small-11">you</span>
                                }
                            </span>
                        </td>
                        <td class="is-mono is-muted" title="@m.Email">@m.Email</td>
                        <td>
                            @if (editable)
                            {
                                <form method="post" asp-page-handler="UpdateMemberRole" asp-route-id="@t.Id">
                                    <input type="hidden" name="memberUserId" value="@m.UserId" />
                                    <select name="newRole" class="dfh-select-sm" aria-label="Role of @m.Name" data-dfh-autosubmit>
                                        <option value="admin" selected="@(role == "admin")">Admin</option>
                                        <option value="member" selected="@(role == "member")">Member</option>
                                    </select>
                                </form>
                            }
                            else
                            {
                                <span class="dfh-role@(role == "member" ? "" : " is-" + role)">@TeamUi.RoleLabel(role)</span>
                            }
                        </td>
                        <td class="is-mono is-muted">@Iso(m.JoinedAt)</td>
                        <td class="is-muted">
                            <span class="dfh-presence" title="@(m.LastLoginAt is DateTime at ? Dfh.Timestamp(at) : "Never signed in")">
                                <span class="dfh-dot @(recent ? "dfh-dot--success" : "")" aria-hidden="true"></span>@(m.LastLoginAt is DateTime last ? Dfh.Relative(last) : "never")
                            </span>
                        </td>
                        <td>
                            @if (editable && !m.IsMe)
                            {
                                <form method="post" asp-page-handler="RemoveMember" asp-route-id="@t.Id"
                                      data-dfh-confirm-title="Remove @m.Name?" data-dfh-confirm="They lose access to the documents shared with @t.Name. You can add them again later." data-dfh-confirm-button="Remove">
                                    <input type="hidden" name="memberUserId" value="@m.UserId" />
                                    <button type="submit" class="dfh-icon-action is-danger" title="Remove from the team" aria-label="Remove @m.Name"><i class="bi bi-person-dash" aria-hidden="true"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.CanManageMembers)
{
    <div class="modal" id="dfh-add-member-modal" tabindex="-1" aria-labelledby="dfh-add-member-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" asp-page-handler="AddMember" asp-route-id="@t.Id" data-dfh-busy="Adding…">
                <div class="modal-header">
                    <h2 class="modal-title" id="dfh-add-member-title">Add a member to @t.Name</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body dfh-modal-stack">
                    <label class="dfh-field">
                        <span class="dfh-field-label">E-mail address</span>
                        <input type="email" name="email" class="form-control" required autocomplete="off" placeholder="name@company.com" />
                    </label>
                    <label class="dfh-field">
                        <span class="dfh-field-label">Role</span>
                        <select name="role" class="form-select">
                            <option value="member">Member — works with shared documents</option>
                            <option value="admin">Admin — also manages members</option>
                        </select>
                    </label>
                    <p class="dfh-insp-note m-0">The person needs a DocFlowHub account. They are added straight away; there is no invitation e-mail.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i>Add member</button>
                </div>
            </form>
        </div>
    </div>
}
