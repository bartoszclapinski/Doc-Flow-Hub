@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}
<div class="dfh-error">
    <span class="dfh-error-code">500 · error</span>
    <h1 class="dfh-heading">Something went wrong</h1>
    <p>An error occurred while processing your request.</p>
    @if (Model.IsDemo)
    {
        <p>
            This demo runs on a free server that goes to sleep when nobody uses it and may have
            just restarted. Please wait a moment and refresh the page.
        </p>
    }
    <div class="dfh-error-actions">
        <a class="btn btn-secondary" href="/"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to the home page</a>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="dfh-mono">Request ID: @Model.RequestId</p>
    }
</div>
