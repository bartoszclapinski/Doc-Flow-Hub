@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5" style="max-width: 640px;">
    <h1 class="h3 text-danger">Something went wrong</h1>
    <p class="mt-3">An error occurred while processing your request.</p>

    @if (Model.IsDemo)
    {
        <p>
            This demo runs on free cloud resources. Its database goes to sleep when nobody uses it
            and takes up to a minute to wake up. Please wait a moment and refresh the page.
        </p>
        <p class="text-muted">
            If the error keeps coming back, the demo's free monthly database allowance may be used up.
            It resets on the 1st of the month.
        </p>
    }

    <p class="mt-4">
        <a href="/" class="btn btn-primary">Back to the home page</a>
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mt-4">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
