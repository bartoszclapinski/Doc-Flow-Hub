@page "{id:int?}"
@model DocFlowHub.Web.Pages.Projects.DetailsModel
@{
    var v = Model.View;
    ViewData["Title"] = v.Project.Name;
    ViewData["FullBleed"] = true;
    var returnUrl = WorkspaceLinks.Project(v.Project.Id);
}

@section ToolWindow {
    <partial name="_ProjectTree" model="new ProjectTreeView(Model.Tree, v.Project.Id, null, new HashSet<int>(), !Model.IsDemo)" />
}

@section Inspector {
    <aside class="dfh-inspector dfh-inspector--288" aria-label="Project">
        <div class="dfh-panel-header is-inspector"><span class="dfh-panel-title">Project</span></div>
        <div class="dfh-inspector-body dfh-inspector-body--fill">
            <partial name="_ProjectInspector" model="new ProjectInspectorView(v.Project, Model.IsDemo, true, returnUrl)" />
        </div>
    </aside>
}

<div class="dfh-column">
    <partial name="_FolderBrowser" model="new FolderBrowserView(v, Model.IsDemo)" />
</div>

@section Scripts {
    <script src="~/js/dfh/tree.js" asp-append-version="true"></script>
}
