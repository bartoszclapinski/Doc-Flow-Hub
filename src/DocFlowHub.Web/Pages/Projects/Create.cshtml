@page
@model DocFlowHub.Web.Pages.Projects.CreateModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "New project";
    ViewData["FullBleed"] = true;
    var nameError = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<form class="dfh-column" method="post" data-dfh-busy="Creating…">
    <partial name="_EditorTabs" model='new EditorTabsView("New project", Icon: "bi-kanban")' />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (Model.ErrorMessage != null)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }
            <partial name="_ProjectFields" model="new ProjectFieldsView(Model.Name, Model.Description, Model.Color, nameError)" />
            <p class="dfh-insp-note">After creating the project you can add folders and upload documents into it.</p>
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" asp-page="/Projects/Index">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Create project</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Create project</button>
        }
    </div>
</form>
