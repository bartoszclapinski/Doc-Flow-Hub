@page
@model DocFlowHub.Web.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Projects";
    ViewData["FullBleed"] = true;
    var rows = Model.Projects;
}

@section Inspector {
    <aside class="dfh-inspector dfh-inspector--300" aria-label="Project">
        <div class="dfh-panel-header is-inspector"><span class="dfh-panel-title">Project</span></div>
        <div class="dfh-inspector-body dfh-inspector-body--fill" id="dfh-inspector-body" aria-live="polite"
             data-id="@Model.Selected?.Id" data-return-url="@Model.ReturnUrl">
            @if (Model.Selected != null)
            {
                <partial name="_ProjectInspector" model="new ProjectInspectorView(Model.Selected, Model.IsDemo, false, Model.ReturnUrl)" />
            }
            else
            {
                <div class="dfh-empty dfh-empty--inline">
                    <span class="dfh-empty-title">Nothing selected</span>
                    <p>Select a project to see its folders and storage.</p>
                </div>
            }
        </div>
    </aside>
}

<div class="dfh-column">
    <header class="dfh-page-header">
        <h1>Projects</h1>
        <span class="dfh-mono dfh-muted">@rows.Count</span>
        <nav class="dfh-segmented" aria-label="Project state">
            <a href="/Projects" class="@(!Model.Archived ? "is-active" : null)" aria-current="@(!Model.Archived ? "page" : null)">Active</a>
            <a href="/Projects?status=archived" class="@(Model.Archived ? "is-active" : null)" aria-current="@(Model.Archived ? "page" : null)">Archived</a>
        </nav>
        <span class="dfh-spacer"></span>
        @if (rows.Count > 0)
        {
            <label class="dfh-search dfh-search--240">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" class="dfh-search-input" placeholder="Filter projects" aria-label="Filter projects" autocomplete="off" data-dfh-row-filter="#projects-table" />
            </label>
        }
        @if (Model.IsDemo)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled><i class="bi bi-plus-lg" aria-hidden="true"></i>New project</button></span>
        }
        else
        {
            <a class="btn btn-primary" asp-page="/Projects/Create"><i class="bi bi-plus-lg" aria-hidden="true"></i>New project</a>
        }
    </header>

    @if (Model.ErrorMessage != null)
    {
        <div class="dfh-empty dfh-fill">
            <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
            <span class="dfh-empty-title">The projects could not be loaded</span>
            <p>@Model.ErrorMessage</p>
        </div>
    }
    else if (rows.Count == 0)
    {
        <div class="dfh-fill dfh-fill--pad">
            <div class="dfh-empty dfh-empty--box">
                <i class="bi @(Model.Archived ? "bi-archive" : "bi-kanban")" aria-hidden="true"></i>
                <span class="dfh-empty-title">@(Model.Archived ? "No archived projects" : "No projects yet")</span>
                <p>@(Model.Archived ? "Projects you archive are kept here, out of the lists and the tree." : "A project groups documents into folders. Create one, then upload documents into it.")</p>
                @if (!Model.Archived && !Model.IsDemo)
                {
                    <a class="btn btn-primary" asp-page="/Projects/Create"><i class="bi bi-plus-lg" aria-hidden="true"></i>New project</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="dfh-fill">
            <table class="dfh-table dfh-table--select dfh-table--tall" id="projects-table" data-dfh-select-table
                   data-inspector-url="/Projects?handler=Inspector&id={id}" data-open-url="/Projects/Details/{id}" aria-label="Projects">
                <colgroup>
                    <col />
                    <col style="width: 76px" />
                    <col style="width: 72px" />
                    <col style="width: 84px" />
                    <col style="width: 100px" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">Project</th>
                        <th scope="col" class="is-num">Folders</th>
                        <th scope="col" class="is-num">Docs</th>
                        <th scope="col" class="is-num">Size</th>
                        <th scope="col">Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        var p = rows[i];
                        var first = i == 0;
                        <tr class="@(first ? "is-selected" : null)" data-id="@p.Id" data-filter="@($"{p.Name} {p.Description}".ToLowerInvariant())"
                            tabindex="@(first ? "0" : "-1")" aria-selected="@(first ? "true" : "false")">
                            <td>
                                <div class="dfh-two-line">
                                    <span class="dfh-swatch dfh-swatch--10" style="background: @Dfh.ProjectColor(p.Color, p.Id)" aria-hidden="true"></span>
                                    <span class="dfh-two-line-text">
                                        <a class="dfh-cell-link dfh-ellipsis" href="/Projects/Details/@p.Id">@p.Name</a>
                                        <span class="dfh-ellipsis">@(string.IsNullOrWhiteSpace(p.Description) ? "No description" : p.Description)</span>
                                    </span>
                                </div>
                            </td>
                            <td class="is-mono is-muted is-num">@p.FolderCount</td>
                            <td class="is-mono is-num">@p.DocumentCount</td>
                            <td class="is-mono is-muted is-num">@Dfh.FileSize(p.Bytes)</td>
                            <td class="is-muted" title="@Dfh.Timestamp(p.UpdatedAt)">@Dfh.Relative(p.UpdatedAt)</td>
                        </tr>
                    }
                    <tr class="dfh-filter-empty" hidden><td colspan="5">No project matches the filter.</td></tr>
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/dfh/selectable-table.js" asp-append-version="true"></script>
    <script src="~/js/dfh/row-filter.js" asp-append-version="true"></script>
}
