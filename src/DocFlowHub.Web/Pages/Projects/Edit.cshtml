@page
@model DocFlowHub.Web.Pages.Projects.EditModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = $"Edit · {Model.Project.Name}";
    ViewData["FullBleed"] = true;
    var nameError = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<form class="dfh-column" method="post" asp-route-id="@Model.Id" data-dfh-busy="Saving…">
    <partial name="_EditorTabs" model='new EditorTabsView(Model.Project.Name, Icon: "bi-pencil", Suffix: "edit")' />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (Model.ErrorMessage != null)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }
            <partial name="_ProjectFields" model="new ProjectFieldsView(Model.Name, Model.Description, Model.Color, nameError)" />
            @if (!Model.Project.IsActive)
            {
                <p class="dfh-insp-note"><i class="bi bi-archive" aria-hidden="true"></i> This project is archived. Restore it from its page to show it in the lists and the tree again.</p>
            }
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" href="@WorkspaceLinks.Project(Model.Id)">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Save</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Save</button>
        }
    </div>
</form>
