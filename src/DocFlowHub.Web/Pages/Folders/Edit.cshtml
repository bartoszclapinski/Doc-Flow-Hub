@page
@model DocFlowHub.Web.Pages.Folders.EditModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = $"Edit · {Model.Folder.Name}";
    ViewData["FullBleed"] = true;
    var nameError = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<form class="dfh-column" method="post" asp-route-Id="@Model.Id" data-dfh-busy="Saving…">
    <partial name="_EditorTabs" model='new EditorTabsView(Model.Folder.Name, Icon: "bi-pencil", Suffix: "edit")' />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (Model.ErrorMessage != null)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }
            <partial name="_FolderFields" model="new FolderFieldsView(Model.Project.Name, Model.Name, Model.Description, Model.ParentFolderId, Model.Parents, nameError)" />
            <p class="dfh-insp-note">Moving a folder moves its subfolders and documents with it. You can also drag it in the project tree.</p>
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" href="@WorkspaceLinks.Folder(Model.Folder.ProjectId, Model.Id)">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Save</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Save</button>
        }
    </div>
</form>
