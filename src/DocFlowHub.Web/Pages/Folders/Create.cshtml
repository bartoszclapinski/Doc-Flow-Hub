@page
@model DocFlowHub.Web.Pages.Folders.CreateModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "New folder";
    ViewData["FullBleed"] = true;
    var nameError = ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<form class="dfh-column" method="post" asp-route-ProjectId="@Model.ProjectId" data-dfh-busy="Creating…">
    <partial name="_EditorTabs" model='new EditorTabsView("New folder", Icon: "bi-folder-plus")' />
    <div class="dfh-form-scroll">
        <div class="dfh-form-body">
            @if (Model.ErrorMessage != null)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }
            <partial name="_FolderFields" model="new FolderFieldsView(Model.Project.Name, Model.Name, Model.Description, Model.ParentFolderId, Model.Parents, nameError)" />
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" href="@WorkspaceLinks.Place(Model.ProjectId, Model.ParentFolderId)">Cancel</a>
        @if (DemoMode.IsEnabled)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Create folder</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Create folder</button>
        }
    </div>
</form>
