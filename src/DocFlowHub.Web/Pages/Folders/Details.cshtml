@page
@model DocFlowHub.Web.Pages.Folders.DetailsModel
@{
    var v = Model.View;
    var f = v.Folder!;
    ViewData["Title"] = f.Name;
    ViewData["FullBleed"] = true;
    var path = string.Join(" / ", new[] { v.Project.Name }.Concat(v.Path.Select(p => p.Name)));
    var open = new HashSet<int>(v.Path.Select(p => p.Id));
    var demoTip = "Read-only demo — changes are disabled";
}

@section ToolWindow {
    <partial name="_ProjectTree" model="new ProjectTreeView(Model.Tree, v.Project.Id, f.Id, open, !Model.IsDemo)" />
}

@section Inspector {
    <aside class="dfh-inspector dfh-inspector--288" aria-label="Folder">
        <div class="dfh-panel-header is-inspector"><span class="dfh-panel-title">Folder</span></div>
        <div class="dfh-insp-block">
            <div class="dfh-entity-title">
                <i class="bi @(f.IsArchived ? "bi-archive" : "bi-folder2-open") dfh-muted" aria-hidden="true"></i>
                <h2 class="dfh-insp-title">@f.Name</h2>
            </div>
            <span class="dfh-insp-path">@path</span>
            @if (!string.IsNullOrWhiteSpace(f.Description))
            {
                <p class="dfh-insp-desc">@f.Description</p>
            }
        </div>
        <div class="dfh-insp-block">
            <dl class="dfh-kv dfh-kv--side">
                <dt>Contents</dt>
                <dd class="dfh-mono">@v.Subfolders.Count @Dfh.Noun(v.Subfolders.Count, "folder") · @v.Documents.Count @Dfh.Noun(v.Documents.Count, "doc")</dd>
                <dt>Size</dt>
                <dd class="dfh-mono">@Dfh.FileSize(v.Bytes)</dd>
                <dt>Created</dt>
                <dd class="dfh-mono" title="@f.CreatorName">@f.CreatedAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) · @Dfh.Initials(f.CreatorName)</dd>
                @if (f.IsArchived)
                {
                    <dt>State</dt>
                    <dd><span class="dfh-chip dfh-chip--warning">archived</span></dd>
                }
            </dl>
        </div>

        <form class="dfh-insp-block" method="post" asp-page-handler="Save" asp-route-Id="@f.Id" asp-route-ProjectId="@v.Project.Id" data-dfh-busy="Saving…">
            <span class="dfh-insp-block-head"><span>Settings</span></span>
            <label class="dfh-field">
                <span class="dfh-field-label">Name</span>
                <input asp-for="Name" class="form-control form-control-sm" maxlength="100" />
                @if (Model.SettingsFailed)
                {
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                }
            </label>
            <label class="dfh-field">
                <span class="dfh-field-label">Description</span>
                <input asp-for="Description" class="form-control form-control-sm" maxlength="500" placeholder="Optional" />
            </label>
            <label class="dfh-switch-row">
                <span class="form-check form-switch m-0">
                    <input asp-for="IsArchived" class="form-check-input" type="checkbox" role="switch" />
                </span>
                <span>Archived<small>Hidden from the project tree and from upload destinations.</small></span>
            </label>
            @if (Model.IsDemo)
            {
                <span class="dfh-btn-disabled-wrap" tabindex="0" title="@demoTip"><button type="button" class="btn btn-secondary btn-sm" disabled>Save</button></span>
            }
            else
            {
                <div><button type="submit" class="btn btn-secondary btn-sm">Save</button></div>
            }
        </form>

        <div class="dfh-insp-block">
            <span class="dfh-insp-block-head"><span>Danger zone</span></span>
            <form method="post" asp-page-handler="Delete" asp-route-Id="@f.Id" asp-route-ProjectId="@v.Project.Id"
                  data-dfh-confirm-title="Delete folder “@f.Name”?" data-dfh-confirm="The empty folder will be removed. It can't be undone." data-dfh-confirm-button="Delete folder">
                <span class="dfh-btn-disabled-wrap dfh-grow" tabindex="@(v.IsEmpty && !Model.IsDemo ? null : "0")" title="@(Model.IsDemo ? demoTip : v.IsEmpty ? null : "Move or delete what's inside first")">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100" disabled="@(!v.IsEmpty || Model.IsDemo)"><i class="bi bi-trash" aria-hidden="true"></i>Delete folder</button>
                </span>
            </form>
            <p class="dfh-insp-note">Only empty folders can be deleted.</p>
        </div>
    </aside>
}

<div class="dfh-column">
    <partial name="_FolderBrowser" model="new FolderBrowserView(v, Model.IsDemo)" />
</div>

@section Scripts {
    <script src="~/js/dfh/tree.js" asp-append-version="true"></script>
}
