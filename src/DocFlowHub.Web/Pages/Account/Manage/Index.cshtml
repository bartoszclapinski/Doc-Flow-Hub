@page
@model DocFlowHub.Web.Pages.Account.Manage.IndexModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "Profile";
    ViewData["FullBleed"] = true;
    var p = Model.Profile;
    var name = $"{p.FirstName} {p.LastName}".Trim();
    var demo = DemoMode.IsEnabled;
    var demoTip = "Read-only demo — changes are disabled";
    string? Error(string key) => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage;
}

@section ToolWindow {
    <partial name="_SettingsTree" model='"profile"' />
}

<div class="dfh-column">
    <nav class="dfh-crumbbar" aria-label="Location"><span>Account</span><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Profile</span></nav>
    <div class="dfh-form-scroll">
        <div class="dfh-form-body dfh-form-body--860">
            <div class="dfh-avatar-row">
                @if (!string.IsNullOrEmpty(p.ProfilePictureUrl))
                {
                    <img class="dfh-avatar dfh-avatar--64" src="@p.ProfilePictureUrl" alt="Your profile picture" />
                }
                else
                {
                    <span class="dfh-avatar dfh-avatar--64 dfh-avatar--me" aria-hidden="true">@Dfh.Initials(name.Length > 0 ? name : p.Email)</span>
                }
                @if (demo)
                {
                    <span class="dfh-btn-disabled-wrap" tabindex="0" title="@demoTip"><button type="button" class="btn btn-secondary btn-sm" disabled><i class="bi bi-image" aria-hidden="true"></i>Upload picture</button></span>
                }
                else
                {
                    <form method="post" asp-page-handler="Picture" enctype="multipart/form-data" data-dfh-busy="Uploading…">
                        <label class="btn btn-secondary btn-sm mb-0">
                            <i class="bi bi-image" aria-hidden="true"></i>Upload picture
                            <input type="file" name="picture" accept=".jpg,.jpeg,.png,.gif,image/jpeg,image/png,image/gif" class="dfh-file-input" data-dfh-autosubmit-file />
                        </label>
                    </form>
                    @if (!string.IsNullOrEmpty(p.ProfilePictureUrl))
                    {
                        <form method="post" asp-page-handler="RemovePicture">
                            <button type="submit" class="btn btn-ghost btn-sm">Remove</button>
                        </form>
                    }
                }
                <span class="dfh-form-row-help">JPG, PNG or GIF, square looks best, up to 5 MB.</span>
            </div>

            <form id="profile-form" method="post" asp-page-handler="Save" data-dfh-dirty-form data-dfh-busy="Saving…">
                <div class="dfh-form-row">
                    <span class="dfh-form-row-label" id="name-label">Name</span>
                    <div class="dfh-form-row-control">
                        <span class="dfh-inline-fields" role="group" aria-labelledby="name-label">
                            <input name="FirstName" value="@Model.FirstName" class="form-control form-control-sm dfh-w-200" maxlength="50" required aria-label="First name" readonly="@demo" />
                            <input name="LastName" value="@Model.LastName" class="form-control form-control-sm dfh-w-200" maxlength="50" required aria-label="Last name" readonly="@demo" />
                        </span>
                        @if ((Error("FirstName") ?? Error("LastName")) is string nameError)
                        {
                            <span class="field-validation-error">@nameError</span>
                        }
                    </div>
                </div>
                <div class="dfh-form-row">
                    <span class="dfh-form-row-label">E-mail</span>
                    <div class="dfh-form-row-control">
                        <span class="dfh-inline-fields">
                            <input value="@p.Email" class="form-control form-control-sm dfh-mono dfh-w-300" readonly aria-label="E-mail" />
                            @if (Model.EmailConfirmed)
                            {
                                <span class="dfh-verified"><i class="bi bi-patch-check" aria-hidden="true"></i>verified</span>
                            }
                        </span>
                        <span class="dfh-form-row-help">Your sign-in name. An administrator can change it.</span>
                    </div>
                </div>
                <div class="dfh-form-row is-top">
                    <label class="dfh-form-row-label" for="bio">Bio</label>
                    <div class="dfh-form-row-control">
                        <textarea id="bio" name="Bio" class="form-control form-control-sm" rows="3" maxlength="500" placeholder="Optional. A line about you for your teammates." readonly="@demo">@Model.Bio</textarea>
                        @if (Error("Bio") is string bioError)
                        {
                            <span class="field-validation-error">@bioError</span>
                        }
                    </div>
                </div>
                <div class="dfh-form-row">
                    <span class="dfh-form-row-label">Member since</span>
                    <div class="dfh-form-row-control"><span class="dfh-mono dfh-muted">@p.CreatedAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</span></div>
                </div>
            </form>
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"><span data-dfh-dirty-label hidden>Unsaved changes</span></span>
        <button type="reset" form="profile-form" class="btn btn-secondary" data-dfh-dirty-enable disabled>Discard</button>
        @if (demo)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="@demoTip"><button type="button" class="btn btn-primary" disabled>Save</button></span>
        }
        else
        {
            <button type="submit" form="profile-form" class="btn btn-primary" data-dfh-dirty-enable disabled>Save</button>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/dfh/tree.js" asp-append-version="true"></script>
    <script src="~/js/dfh/settings.js" asp-append-version="true"></script>
}
