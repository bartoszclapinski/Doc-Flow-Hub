@page
@model DocFlowHub.Web.Pages.Account.Manage.ChangePasswordModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@{
    ViewData["Title"] = "Password";
    ViewData["FullBleed"] = true;
    var demo = DemoMode.IsEnabled;
    var summary = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new List<string>();
    string? Error(string key) => ViewData.ModelState[$"Input.{key}"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

@section ToolWindow {
    <partial name="_SettingsTree" model='"password"' />
}

<form class="dfh-column" method="post" data-dfh-busy="Changing…">
    <nav class="dfh-crumbbar" aria-label="Location"><span>Account</span><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Password</span></nav>
    <div class="dfh-form-scroll">
        <div class="dfh-form-body dfh-form-body--860">
            @if (summary.Count > 0)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@string.Join(" ", summary)</span></div>
            }
            <div class="dfh-form-row">
                <label class="dfh-form-row-label" for="Input_CurrentPassword">Current password</label>
                <div class="dfh-form-row-control">
                    <input id="Input_CurrentPassword" name="Input.CurrentPassword" type="password" class="form-control form-control-sm dfh-w-300" autocomplete="current-password" required />
                    @if (Error("CurrentPassword") is string currentError)
                    {
                        <span class="field-validation-error">@currentError</span>
                    }
                </div>
            </div>
            <div class="dfh-form-row is-top">
                <label class="dfh-form-row-label" for="Input_NewPassword">New password</label>
                <div class="dfh-form-row-control dfh-w-300">
                    <input id="Input_NewPassword" name="Input.NewPassword" type="password" class="form-control form-control-sm" autocomplete="new-password" required aria-describedby="password-rules" data-dfh-password />
                    <div class="dfh-strength" data-score="0" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                    <ul class="dfh-rules" id="password-rules" aria-live="polite">
                        <li data-rule="length"><i class="bi bi-dash" aria-hidden="true"></i>8+ characters</li>
                        <li data-rule="digit"><i class="bi bi-dash" aria-hidden="true"></i>A number</li>
                        <li data-rule="upper"><i class="bi bi-dash" aria-hidden="true"></i>Uppercase letter</li>
                        <li data-rule="symbol"><i class="bi bi-dash" aria-hidden="true"></i>A symbol</li>
                    </ul>
                    @if (Error("NewPassword") is string newError)
                    {
                        <span class="field-validation-error">@newError</span>
                    }
                </div>
            </div>
            <div class="dfh-form-row">
                <label class="dfh-form-row-label" for="Input_ConfirmPassword">Confirm new password</label>
                <div class="dfh-form-row-control">
                    <input id="Input_ConfirmPassword" name="Input.ConfirmPassword" type="password" class="form-control form-control-sm dfh-w-300" autocomplete="new-password" required data-dfh-password-confirm />
                    @if (Error("ConfirmPassword") is string confirmError)
                    {
                        <span class="field-validation-error">@confirmError</span>
                    }
                </div>
            </div>
            <p class="dfh-insp-note">You stay signed in on this device after the change.</p>
        </div>
    </div>
    <div class="dfh-form-footer">
        <span class="dfh-mono"></span>
        <a class="btn btn-secondary" href="/Account/Manage">Cancel</a>
        @if (demo)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Change password</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary">Change password</button>
        }
    </div>
</form>

@section Scripts {
    <script src="~/js/dfh/tree.js" asp-append-version="true"></script>
    <script src="~/js/dfh/settings.js" asp-append-version="true"></script>
    <script src="~/js/dfh/auth.js" asp-append-version="true"></script>
}
