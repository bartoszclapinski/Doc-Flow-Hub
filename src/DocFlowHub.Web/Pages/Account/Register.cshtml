@page
@model DocFlowHub.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
    Layout = "_AuthLayout";
}

@if (Model.DemoBlocked)
{
    <main class="dfh-auth-card dfh-auth-card--demo">
        <div class="dfh-auth-head">
            <h1>No sign-up in the demo</h1>
            <p>This is the public, read-only demo of DocFlowHub. You can look around with a ready-made account instead.</p>
        </div>
        <partial name="_DemoExplainer" model="true" />
        <div class="dfh-demo-actions">
            <a class="btn btn-primary" asp-page="./Login">Explore the demo<i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            <a class="btn btn-secondary" href="https://github.com/bartoszclapinski/Doc-Flow-Hub" rel="noopener"><i class="bi bi-github" aria-hidden="true"></i>Run your own copy</a>
        </div>
    </main>
}
else
{
<main class="dfh-auth-card dfh-auth-card--wide">
    <div class="dfh-auth-head">
        <h1>Create account</h1>
    </div>

    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" data-dfh-busy="Creating account…">
        <div asp-validation-summary="ModelOnly" class="dfh-form-error" role="alert"></div>

        <div class="dfh-field-row">
            <div class="dfh-field">
                <label asp-for="Input.FirstName">First name</label>
                <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" autofocus />
                <span asp-validation-for="Input.FirstName" class="field-validation-error"></span>
            </div>
            <div class="dfh-field">
                <label asp-for="Input.LastName">Last name</label>
                <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" />
                <span asp-validation-for="Input.LastName" class="field-validation-error"></span>
            </div>
        </div>

        <div class="dfh-field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
            <span asp-validation-for="Input.Email" class="field-validation-error"></span>
        </div>

        @* Rules mirror the Identity options in Program.cs (length 8, digit, uppercase, symbol). *@
        <div class="dfh-field">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true"
                   aria-describedby="password-rules" placeholder=" " data-dfh-password />
            <div class="dfh-strength" data-score="0" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            <ul class="dfh-rules" id="password-rules" aria-live="polite">
                <li data-rule="length"><i class="bi bi-dash" aria-hidden="true"></i>8+ characters</li>
                <li data-rule="digit"><i class="bi bi-dash" aria-hidden="true"></i>A number</li>
                <li data-rule="upper"><i class="bi bi-dash" aria-hidden="true"></i>Uppercase letter</li>
                <li data-rule="symbol"><i class="bi bi-dash" aria-hidden="true"></i>A symbol</li>
            </ul>
            <span asp-validation-for="Input.Password" class="field-validation-error"></span>
        </div>

        <div class="dfh-field">
            <label asp-for="Input.ConfirmPassword">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true"
                   placeholder=" " data-dfh-password-confirm />
            <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
        </div>

        <button id="registerSubmit" type="submit" class="btn btn-primary dfh-btn-34">Create account</button>
    </form>

    <p class="dfh-auth-alt">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></p>
</main>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
