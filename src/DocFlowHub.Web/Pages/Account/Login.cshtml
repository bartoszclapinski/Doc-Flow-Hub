@page
@model DocFlowHub.Web.Pages.Account.LoginModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@using DocFlowHub.Core.Constants
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<main class="dfh-auth-card">
    <div class="dfh-auth-head">
        <h1>Sign in</h1>
        <p>Documents, versions and AI summaries for your team.</p>
    </div>

    <form id="account" method="post" data-dfh-busy="Signing in…">
        <div asp-validation-summary="ModelOnly" class="dfh-form-error" role="alert"></div>

        <div class="dfh-field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" autofocus />
            <span asp-validation-for="Input.Email" class="field-validation-error"></span>
        </div>

        <div class="dfh-field">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder=" " />
            <span asp-validation-for="Input.Password" class="field-validation-error"></span>
        </div>

        <div class="form-check">
            <input asp-for="Input.RememberMe" class="form-check-input" />
            <label asp-for="Input.RememberMe" class="form-check-label">Keep me signed in</label>
        </div>

        <button id="login-submit" type="submit" class="btn btn-primary dfh-btn-34">Sign in</button>
    </form>

    @if (!DemoMode.IsEnabled)
    {
        <p class="dfh-auth-alt">No account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a></p>
    }
</main>

@if (DemoMode.IsEnabled)
{
    <aside class="dfh-demo-box" aria-label="Demo accounts">
        <div class="dfh-demo-box-title"><i class="bi bi-lock" aria-hidden="true"></i>Read-only demo</div>
        <div class="dfh-mono">
            <button type="button" class="dfh-demo-fill" data-email="@DemoAccounts.UserEmail" data-password="@DemoAccounts.Password"
                    title="Fill in the user account">@DemoAccounts.UserEmail</button>
            ·
            <button type="button" class="dfh-demo-fill" data-email="@DemoAccounts.AdminEmail" data-password="@DemoAccounts.Password"
                    title="Fill in the administrator account">@DemoAccounts.AdminEmail</button>
        </div>
        <div class="dfh-mono">password: @DemoAccounts.Password</div>
    </aside>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
