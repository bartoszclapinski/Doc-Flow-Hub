@page
@model DocFlowHub.Web.Pages.Settings.AIModel
@inject DocFlowHub.Core.Services.Interfaces.IDemoModeService DemoMode
@using DocFlowHub.Core.Models.AI
@{
    ViewData["Title"] = "AI settings";
    ViewData["FullBleed"] = true;
    var i = Model.Input;
    var demo = DemoMode.IsEnabled;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var u = Model.Usage;
    var max = Math.Max(1, u.Last14Days.Count == 0 ? 0 : u.Last14Days.Max(d => d.Count));
    string? Error(string key) => ViewData.ModelState[$"Input.{key}"]?.Errors.FirstOrDefault()?.ErrorMessage;
    // Decision 2026-11-14 ("look + honesty"): settings the app does not read yet say so.
    var notApplied = "Saved, but the app does not use this setting yet";
}

@section ToolWindow {
    <partial name="_SettingsTree" model='"ai"' />
}

<form class="dfh-column" method="post" asp-page-handler="SaveSettings" id="ai-form" data-dfh-dirty-form data-dfh-busy="Saving…">
    <nav class="dfh-crumbbar" aria-label="Location"><span>AI</span><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Models &amp; features</span></nav>
    <div class="dfh-form-scroll">
        <div class="dfh-form-body dfh-form-body--860 dfh-settings-body">
            @if (Model.ErrorMessage != null)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>@Model.ErrorMessage</span></div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="dfh-form-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span>Nothing was saved: @string.Join(" ", ViewData.ModelState.Where(e => e.Value!.Errors.Count > 0).Select(e => $"{e.Key.Replace("Input.", "")}: {e.Value!.Errors[0].ErrorMessage}"))</span></div>
            }

            <section class="dfh-settings-section" aria-labelledby="sec-model">
                <div class="dfh-section-divider"><span id="sec-model">Model</span><span class="dfh-section-divider-line" aria-hidden="true"></span></div>
                <div class="dfh-form-row">
                    <label class="dfh-form-row-label" for="model">Default model</label>
                    <div class="dfh-form-row-control">
                        <select id="model" name="Input.PreferredModel" class="form-select form-select-sm dfh-mono dfh-w-260" disabled="@demo">
                            @foreach (var m in AIModelHelper.GetAllModels())
                            {
                                <option value="@m" selected="@(m == i.PreferredModel)">@m.ToApiString()</option>
                            }
                        </select>
                        <span class="dfh-form-row-help">Used when you generate a summary or compare versions from a document. Summaries made right after an upload still use the system default.</span>
                    </div>
                </div>
            </section>

            <section class="dfh-settings-section" aria-labelledby="sec-features">
                <div class="dfh-section-divider"><span id="sec-features">Features</span><span class="dfh-section-divider-line" aria-hidden="true"></span></div>
                @foreach (var (name, value, title, help, applied) in new[]
                {
                    ("SummarizationEnabled", i.SummarizationEnabled, "Summaries", "Turning both summaries and comparisons off hides the AI option when you upload.", true),
                    ("VersionComparisonEnabled", i.VersionComparisonEnabled, "Version comparisons", "Turning both summaries and comparisons off hides the AI option when you upload.", true),
                    ("AutoSummarizeOnUpload", i.AutoSummarizeOnUpload, "Summarize documents on upload", "The upload form has its own switch for each upload.", false),
                    ("EnableCaching", i.EnableCaching, "Cache results", "Reuse results for identical requests.", false),
                })
                {
                    <label class="dfh-check-row dfh-form-check-row">
                        <input type="checkbox" class="form-check-input" name="Input.@name" value="true" checked="@value" disabled="@demo" />
                        <input type="hidden" name="Input.@name" value="false" />
                        <span>
                            @title
                            @if (!applied)
                            {
                                <span class="dfh-not-applied" title="@notApplied">not applied yet</span>
                            }
                            <small>@help</small>
                        </span>
                    </label>
                }
            </section>

            <section class="dfh-settings-section" aria-labelledby="sec-tuning">
                <div class="dfh-section-divider">
                    <span id="sec-tuning">Generation</span><span class="dfh-section-divider-line" aria-hidden="true"></span>
                    <span class="dfh-not-applied" title="@notApplied">not applied yet</span>
                </div>
                @foreach (var (name, label, value, min, maxValue, step, fmt) in new[]
                {
                    ("QualityPreference", "Quality", i.QualityPreference, 0.1, 1.0, 0.1, "0.0"),
                    ("ComparisonSensitivity", "Comparison sensitivity", i.ComparisonSensitivity, 0.1, 1.0, 0.1, "0.0"),
                })
                {
                    <div class="dfh-form-row">
                        <label class="dfh-form-row-label" for="@name">@label</label>
                        <div class="dfh-form-row-control dfh-slider-row">
                            <input id="@name" type="range" class="form-range dfh-w-260" name="Input.@name" min="@min.ToString(inv)" max="@maxValue.ToString(inv)" step="@step.ToString(inv)" value="@value.ToString(inv)" disabled="@demo" data-dfh-range-output />
                            <output class="dfh-mono" for="@name">@value.ToString(fmt, inv)</output>
                        </div>
                    </div>
                }
                <div class="dfh-form-row">
                    <label class="dfh-form-row-label" for="tokens">Max tokens per request</label>
                    <div class="dfh-form-row-control">
                        <input id="tokens" type="number" class="form-control form-control-sm dfh-w-140" name="Input.MaxTokensPerOperation" min="100" max="10000" step="100" value="@i.MaxTokensPerOperation" disabled="@demo" />
                        @if (Error("MaxTokensPerOperation") is string tokensError)
                        {
                            <span class="field-validation-error">@tokensError</span>
                        }
                    </div>
                </div>
                <div class="dfh-form-row">
                    <label class="dfh-form-row-label" for="cache">Cache duration</label>
                    <div class="dfh-form-row-control">
                        <span class="dfh-inline-fields"><input id="cache" type="number" class="form-control form-control-sm dfh-w-140" name="Input.CacheDurationHours" min="1" max="48" value="@i.CacheDurationHours" disabled="@demo" /><span class="dfh-muted">hours</span></span>
                    </div>
                </div>
            </section>

            <section class="dfh-settings-section" aria-labelledby="sec-key">
                <div class="dfh-section-divider">
                    <span id="sec-key">Own API key</span><span class="dfh-section-divider-line" aria-hidden="true"></span>
                    <span class="dfh-not-applied" title="@notApplied">not applied yet</span>
                </div>
                <label class="dfh-check-row dfh-form-check-row">
                    <input type="checkbox" class="form-check-input" name="Input.UseCustomApiKey" value="true" checked="@i.UseCustomApiKey" disabled="@demo" />
                    <input type="hidden" name="Input.UseCustomApiKey" value="false" />
                    <span>Use my own OpenAI key<small>Requests would be billed to your key instead of the shared one. The app always uses the shared key today.</small></span>
                </label>
                <div class="dfh-form-row">
                    <label class="dfh-form-row-label" for="apikey">API key</label>
                    <div class="dfh-form-row-control">
                        <input id="apikey" type="password" class="form-control form-control-sm dfh-mono dfh-w-300" name="Input.CustomApiKey" value="@i.CustomApiKey" autocomplete="off" placeholder="sk-…" disabled="@demo" />
                    </div>
                </div>
            </section>

            <section class="dfh-settings-section" aria-labelledby="sec-usage">
                <div class="dfh-section-divider">
                    <span id="sec-usage">Usage · @DateTime.UtcNow.ToString("MMMM", inv)</span><span class="dfh-section-divider-line" aria-hidden="true"></span>
                    <span class="dfh-muted"><i class="bi bi-lock" aria-hidden="true"></i> limit set by the app</span>
                </div>
                <div class="dfh-usage-row">
                    <div>
                        <span class="dfh-usage-big">@Dfh.Number(u.RequestsThisMonth)</span>
                        <span class="dfh-muted"> requests this month</span>
                        <div class="dfh-form-row-help">today @u.RequestsToday / @Dfh.Number(Model.DailyLimit) · resets at midnight UTC</div>
                    </div>
                    <div class="dfh-barchart dfh-barchart--ai dfh-barchart--72" role="img" aria-label="AI requests in the last 14 days">
                        @for (var d = 0; d < u.Last14Days.Count; d++)
                        {
                            var day = u.Last14Days[d];
                            var h = day.Count == 0 ? 0 : Math.Max(4, Math.Round(day.Count * 100.0 / max));
                            <span class="dfh-bar@(d == u.Last14Days.Count - 1 ? " is-today" : "")" style="--h: @h.ToString(inv)%" title="@day.Day.ToString("MMM d", inv) · @day.Count @Dfh.Noun(day.Count, "request")"></span>
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>
    <div class="dfh-form-footer">
        @if (!demo)
        {
            <button type="submit" class="dfh-link-btn" formaction="?handler=ResetToDefaults" formnovalidate>Reset to defaults</button>
        }
        <span class="dfh-mono dfh-grow"><span data-dfh-dirty-label hidden>Unsaved changes</span></span>
        <button type="reset" class="btn btn-secondary" data-dfh-dirty-enable disabled>Discard</button>
        @if (demo)
        {
            <span class="dfh-btn-disabled-wrap" tabindex="0" title="Read-only demo — changes are disabled"><button type="button" class="btn btn-primary" disabled>Save</button></span>
        }
        else
        {
            <button type="submit" class="btn btn-primary" data-dfh-dirty-enable disabled>Save</button>
        }
    </div>
</form>

@section Scripts {
    <script src="~/js/dfh/tree.js" asp-append-version="true"></script>
    <script src="~/js/dfh/settings.js" asp-append-version="true"></script>
}
